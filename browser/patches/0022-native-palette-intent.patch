+class BrowserViewPaletteIntentTest : public BrowserViewTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    BrowserViewTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitch("myarc-visual-parity");
+    command_line->AppendSwitch("myarc-workspace-sidebar");
+  }
+
+  views::BubbleDialogDelegate* palette() {
+    return views::BubbleDialogDelegate::GetAnchoredDialog(
+        views::BubbleAnchor(browser_view()));
+  }
+
+  views::Textfield* input() {
+    return views::AsViewClass<views::Textfield>(
+        palette()->GetInitiallyFocusedView());
+  }
+
+  void Type(const std::u16string& text) {
+    input()->SelectAll(false);
+    input()->InsertText(
+        text,
+        ui::TextInputClient::InsertTextCursorBehavior::kMoveCursorAfterText);
+  }
+
+  void Press(ui::KeyboardCode key) {
+    ui::KeyEvent event(ui::EventType::kKeyPressed, key, ui::EF_NONE);
