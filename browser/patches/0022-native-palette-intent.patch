+IN_PROC_BROWSER_TEST_F(BrowserViewPaletteIntentTest,
+                       OwnerCloseWithHistoryWorkQueued) {
+  auto* owner = CreateBrowser(browser()->GetProfile());
+  auto* view = BrowserView::GetBrowserViewForBrowser(owner);
+  ASSERT_TRUE(view->ShowMyarcCommandPalette(true));
+  auto* bubble =
+      views::BubbleDialogDelegate::GetAnchoredDialog(views::BubbleAnchor(view));
+  ASSERT_TRUE(bubble);
+  auto widget = bubble->GetWidget()->GetWeakPtr();
+  auto* field =
+      views::AsViewClass<views::Textfield>(bubble->GetInitiallyFocusedView());
+  ASSERT_TRUE(field);
+  field->InsertText(
+      u"queued synthetic history",
+      ui::TextInputClient::InsertTextCursorBehavior::kMoveCursorAfterText);
+  CloseBrowserSynchronously(owner);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(widget);
+  EXPECT_TRUE(browser_view()->GetWidget());
+}
