+IN_PROC_BROWSER_TEST_F(BrowserViewPaletteIntentTest,
+                       EmptySpaceGuardsExistingCurrentIntent) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL hidden = embedded_test_server()->GetURL("/title1.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), hidden));
+  auto* contents = active_web_contents();
+  auto* adapter = browser_view()->GetMyarcWorkspaceAdapter();
+  ASSERT_TRUE(adapter);
+  ASSERT_TRUE(base::test::RunUntil([&] { return adapter->ready(); }));
+  const uint64_t original_space = adapter->Sidebar().current_space.id;
+  const auto empty = adapter->CreateSpace("Palette empty fixture");
+  ASSERT_TRUE(empty.ok);
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(false));
+  auto* widget = palette()->GetWidget();
+  palette()->set_close_on_deactivate(false);
+  ASSERT_TRUE(adapter->SelectSpace(empty.id).ok);
+  ASSERT_TRUE(browser_view()->IsMyarcWorkspaceBlank());
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(false));
+  EXPECT_EQ(widget, palette()->GetWidget());
+  EXPECT_TRUE(input()->GetText().empty());
+  Type(u"synthetic empty draft");
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(false));
+  EXPECT_EQ(u"synthetic empty draft", input()->GetText());
+  EXPECT_EQ(input()->GetText(), input()->GetSelectedText());
+  const int count = browser()->GetTabStripModel()->count();
+  const GURL added = embedded_test_server()->GetURL("/title2.html");
+  Type(base::UTF8ToUTF16(added.spec()));
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+  Press(ui::VKEY_RETURN);
+  ASSERT_TRUE(content::WaitForLoadStop(active_web_contents()));
+  EXPECT_EQ(count + 1, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(hidden, contents->GetLastCommittedURL());
+  EXPECT_EQ(added, active_web_contents()->GetLastCommittedURL());
+  EXPECT_FALSE(browser_view()->IsMyarcWorkspaceBlank());
+  ASSERT_TRUE(adapter->SelectSpace(original_space).ok);
+  EXPECT_EQ(contents, adapter->DisplayedContents());
+}
