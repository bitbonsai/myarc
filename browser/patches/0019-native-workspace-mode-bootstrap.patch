+IN_PROC_BROWSER_TEST_P(SessionCrashedBubbleMyarcViewTest,
+                       RuntimeModesKeepWorkspaceAndRecoveryAnchor) {
+  auto* const profile = browser()->GetProfile();
+  profile->GetPrefs()->SetBoolean(prefs::kVerticalTabsEnabled, false);
+  BrowserWindowCreateParams params(profile, /*from_user_gesture=*/true);
+  params.initial_bounds = gfx::Rect(50, 50, 1000, 800);
+  params.vertical_tab_strip_collapsed = GetParam();
+  auto* const window = CreateBrowserWindow(std::move(params));
+  auto* const view = BrowserView::GetBrowserViewForBrowser(window);
+  ASSERT_TRUE(view);
+  chrome::AddTabAt(window, GURL("about:blank"), -1, true);
+  auto* const tabs = window->GetTabStripModel();
+  auto* const page = tabs->GetActiveWebContents();
+  auto* const toolbar = view->toolbar();
+  auto* const header =
+      view->vertical_tab_strip_region_view_for_testing()->GetTopContainer();
+  auto* const anchor = view->myarc_popup_anchor();
+  ASSERT_TRUE(anchor);
+  EXPECT_FALSE(view->GetMyarcWorkspaceAdapter());
+  EXPECT_EQ(view->top_container(), toolbar->parent());
+
+  ExitTypeService::GetInstanceForProfile(profile)
+      ->SetLastSessionExitTypeForTest(ExitType::kCrashed);
+  SessionCrashedBubble::ShowIfNotOffTheRecordProfile(window, false);
+  ASSERT_TRUE(base::test::RunUntil(
+      [] { return SessionCrashedBubbleView::GetInstanceForTest(); }));
+  auto* const bubble = SessionCrashedBubbleView::GetInstanceForTest();
+  ASSERT_TRUE(bubble);
+  chrome::ToggleVerticalTabs(window);
+  auto* const adapter = view->GetMyarcWorkspaceAdapter();
+  ASSERT_TRUE(adapter);
+  EXPECT_FALSE(adapter->ready());
+  EXPECT_TRUE(myarc::WorkspaceLifecycle::HasPendingSessionRestore(profile));
+  EXPECT_EQ(header, toolbar->parent());
+  EXPECT_EQ(anchor, bubble->GetAnchorView());
+  EXPECT_EQ(page, tabs->GetActiveWebContents());
+  bubble->GetWidget()->CloseNow();
+  ASSERT_TRUE(base::test::RunUntil([&] { return adapter->ready(); }));
+  const auto initial = adapter->Sidebar();
+  ASSERT_TRUE(initial.ok);
+  const auto created = adapter->CreateSpace("Mode fixture");
+  ASSERT_TRUE(created.ok);
+  ASSERT_TRUE(adapter->SelectSpace(created.id).ok);
+  EXPECT_TRUE(view->IsMyarcWorkspaceBlank());
+  ASSERT_TRUE(adapter->SelectSpace(initial.current_space.id).ok);
+  EXPECT_EQ(page, adapter->DisplayedContents());
+  const auto baseline = adapter->service().ExportSnapshot();
+  ASSERT_TRUE(baseline);
+  const auto binding = myarc::BrowserWorkspaceAdapter::TabExtraData(*page);
+  const size_t sidebar_children =
+      view->vertical_tab_strip_region_view_for_testing()->children().size();
+
+  view->GetWidget()->Show();
+  for (int cycle = 0; cycle < 3; ++cycle) {
+    chrome::ToggleVerticalTabs(window);
+    view->GetWidget()->LayoutRootViewIfNecessary();
+    EXPECT_FALSE(profile->GetPrefs()->GetBoolean(prefs::kVerticalTabsEnabled));
+    EXPECT_EQ(view->top_container(), toolbar->parent());
+    EXPECT_EQ(header, header->GetCollapseButton()->parent());
+    EXPECT_TRUE(toolbar->IsDrawn());
+    EXPECT_TRUE(toolbar->location_bar_view()->IsDrawn());
+    EXPECT_TRUE(
+        view->toolbar_button_provider()->GetAppMenuControl()->IsDrawn());
+    toolbar->location_bar()->FocusLocation(
+        /*is_user_initiated=*/false, /*clear_focus_if_failed=*/false);
+    EXPECT_TRUE(toolbar->Contains(view->GetFocusManager()->GetFocusedView()));
+    chrome::ToggleVerticalTabs(window);
+    view->GetWidget()->LayoutRootViewIfNecessary();
+    EXPECT_TRUE(profile->GetPrefs()->GetBoolean(prefs::kVerticalTabsEnabled));
+    EXPECT_EQ(header, toolbar->parent());
+    EXPECT_EQ(toolbar, header->GetCollapseButton()->parent());
+    EXPECT_EQ(adapter, view->GetMyarcWorkspaceAdapter());
+    EXPECT_EQ(anchor, view->myarc_popup_anchor());
+    EXPECT_EQ(1, tabs->count());
+    EXPECT_EQ(page, tabs->GetActiveWebContents());
+    EXPECT_EQ(page, adapter->DisplayedContents());
+    EXPECT_EQ(binding, myarc::BrowserWorkspaceAdapter::TabExtraData(*page));
+    const auto current = adapter->Sidebar();
+    EXPECT_EQ(initial.window_id, current.window_id);
+    EXPECT_EQ(initial.current_space.id, current.current_space.id);
+    EXPECT_EQ(initial.selected_item_id, current.selected_item_id);
+    const auto snapshot = adapter->service().ExportSnapshot();
+    ASSERT_TRUE(snapshot);
+    EXPECT_EQ(baseline->next_space_id, snapshot->next_space_id);
+    EXPECT_EQ(baseline->next_item_id, snapshot->next_item_id);
+    EXPECT_EQ(baseline->next_window_id, snapshot->next_window_id);
+    EXPECT_EQ(baseline->items.size(), snapshot->items.size());
+    EXPECT_EQ(baseline->windows.size(), snapshot->windows.size());
+    EXPECT_EQ(
+        sidebar_children,
+        view->vertical_tab_strip_region_view_for_testing()->children().size());
+  }
+  CloseBrowserSynchronously(window);
+}
