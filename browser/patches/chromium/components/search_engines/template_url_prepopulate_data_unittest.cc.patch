+TEST_F(TemplateURLPrepopulateDataTest, MyarcFindStartpageAsFallback) {
+  base::test::ScopedFeatureList feature_list{switches::kMyarcStartpageDefault};
+
+  // Startpage is the fallback whether a country lists Google first (US),
+  // further down (CN), or already lists Startpage (DE). Google stays
+  // available, and Startpage is listed once.
+  for (const char* country : {"US", "CN", "DE"}) {
+    SCOPED_TRACE(country);
+    OverrideCountryId(CountryId(country));
+
+    std::unique_ptr<TemplateURLData> fallback_url =
+        prepopulate_data_resolver().GetFallbackSearch();
+    ASSERT_TRUE(fallback_url);
+    EXPECT_EQ(fallback_url->prepopulate_id,
+              TemplateURLPrepopulateData::startpage.id);
+    EXPECT_EQ(fallback_url->url(),
+              TemplateURLPrepopulateData::startpage.search_url);
+
+    std::vector<std::unique_ptr<TemplateURLData>> t_urls =
+        prepopulate_data_resolver().GetPrepopulatedEngines();
+    EXPECT_EQ(1, std::ranges::count(t_urls,
+                                    TemplateURLPrepopulateData::startpage.id,
+                                    &TemplateURLData::prepopulate_id));
+    EXPECT_TRUE(prepopulate_data_resolver().GetPrepopulatedEngine(
+        TemplateURLPrepopulateData::google.id));
+  }
+}
