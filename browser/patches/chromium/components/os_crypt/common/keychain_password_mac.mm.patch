@@ -16,6 +16,7 @@
 #include "base/strings/string_view_util.h"
 #include "build/branding_buildflags.h"
 #include "crypto/apple/keychain_v2.h"
+#include "myarc/release_buildflags.h"
 #include "third_party/abseil-cpp/absl/cleanup/cleanup.h"
 
 using crypto::apple::KeychainV2;
@@ -34,6 +35,13 @@ namespace {
 #if BUILDFLAG(GOOGLE_CHROME_BRANDING)
 const char kDefaultServiceName[] = "Chrome Safe Storage";
 const char kDefaultAccountName[] = "Chrome";
+#elif BUILDFLAG(MYARC_RELEASE)
+// Keep myArc's key apart from Chromium's, whose item belongs to other
+// signing identities and would block startup on a Keychain prompt.
+const char kDefaultServiceName[] = "myArc Safe Storage";
+const char kDefaultAccountName[] = "myArc";
+const char kLegacyServiceName[] = "myArc Nightly Safe Storage";
+const char kLegacyAccountName[] = "myArc Nightly";
 #else
 const char kDefaultServiceName[] = "Chromium Safe Storage";
 const char kDefaultAccountName[] = "Chromium";
@@ -104,6 +112,25 @@ std::string KeychainPassword::GetPassword() const {
   }
 
   if (password.error() == errSecItemNotFound) {
+#if BUILDFLAG(MYARC_RELEASE)
+    // Preserve saved cookies and passwords for users migrating from myArc
+    // Nightly: if the legacy Keychain item exists, copy it under the new name.
+    if (GetServiceName() == kDefaultServiceName &&
+        GetAccountName() == kDefaultAccountName) {
+      auto legacy = keychain_->FindGenericPassword(kLegacyServiceName,
+                                                   kLegacyAccountName);
+      if (legacy.has_value()) {
+        std::string migrated(base::as_string_view(*legacy));
+        OSStatus add_err = keychain_->AddGenericPassword(
+            GetServiceName(), GetAccountName(), base::as_byte_span(migrated));
+        if (add_err != noErr) {
+          OSSTATUS_DLOG(ERROR, add_err) << "Keychain migrate add failed";
+        }
+        uma_result = FindGenericPasswordResult::kPasswordFound;
+        return migrated;
+      }
+    }
+#endif
     uma_result = FindGenericPasswordResult::kPasswordNotFound;
     return AddRandomPasswordToKeychain(*keychain_, GetServiceName(),
                                        GetAccountName());
