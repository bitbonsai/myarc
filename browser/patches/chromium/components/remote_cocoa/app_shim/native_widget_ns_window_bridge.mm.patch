 bool NativeWidgetNSWindowBridge::IsWindowModalSheet() const {
+  // Under --myarc-visual-parity, present window-modal dialogs as centered
+  // translucent floating windows so behind-window HUD glass and the 12pt
+  // specular rim are not overridden by macOS's opaque sheet chrome.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "myarc-visual-parity")) {
+    return false;
+  }
   return parent_ && modal_type_ == ui::mojom::ModalType::kWindow;
 }
 
