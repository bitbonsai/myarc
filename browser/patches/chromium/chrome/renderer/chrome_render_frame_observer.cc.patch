+void ChromeRenderFrameObserver::SetBoostStyleSheet(const std::string& key,
+                                                   const std::string& css) {
+  if (key.empty() || !render_frame()) {
+    return;
+  }
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame) {
+    return;
+  }
+  blink::WebDocument doc = frame->GetDocument();
+  if (doc.IsNull()) {
+    return;
+  }
+  const blink::WebStyleSheetKey web_key = blink::WebString::FromUtf8(key);
+  if (active_boost_keys_.erase(key) > 0) {
+    doc.RemoveInsertedStyleSheet(web_key, blink::WebCssOrigin::kAuthor);
+  }
+  if (!css.empty()) {
+    doc.InsertStyleSheet(blink::WebString::FromUtf8(css), &web_key,
+                         blink::WebCssOrigin::kAuthor,
+                         blink::BackForwardCacheAware::kAllow);
+    active_boost_keys_.insert(key);
+  }
+}
