+// The Arc key map for Spaces, sidebar items and pinning replaces stock tab
+// shortcuts only when the workspace sidebar is on too.
+bool UseMyarcWorkspaceShortcuts() {
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  return command_line->HasSwitch("myarc-visual-parity") &&
+         command_line->HasSwitch("myarc-workspace-sidebar");
