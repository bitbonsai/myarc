+TEST(GlobalKeyboardShortcuts, CopyURLShortcutFollowsMyarcMode) {
+  const int expected =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("myarc-visual-parity")
+          ? IDC_COPY_URL
+          : IDC_DEV_TOOLS_INSPECT;
+  EXPECT_EQ(expected, CommandForKeys(kVK_ANSI_C, CommandKeyState::kDown,
+                                     ShiftKeyState::kDown));
+}
