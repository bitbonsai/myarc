+      base::CommandLine::ForCurrentProcess()->HasSwitch("myarc-visual-parity")
+          ? IDC_NEW_WINDOW
+          : NO_COMMAND;
+  EXPECT_EQ(expected,
+            CommandForKeys(kVK_ANSI_N, CommandKeyState::kDown,
+                           ShiftKeyState::kUp, OptionKeyState::kUp,
+                           ControlKeyState::kDown, true));
