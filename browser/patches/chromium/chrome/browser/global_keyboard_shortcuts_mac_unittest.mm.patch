+TEST(GlobalKeyboardShortcuts, CopyURLShortcutFollowsMyarcMode) {
+  const int expected =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("myarc-visual-parity")
+          ? IDC_COPY_URL
+          : IDC_DEV_TOOLS_INSPECT;
+  EXPECT_EQ(expected, CommandForKeys(kVK_ANSI_C, CommandKeyState::kDown,
+                                     ShiftKeyState::kDown));
+}
+
+TEST(GlobalKeyboardShortcuts, BlankWindowShortcutFollowsMyarcMode) {
+  const int expected =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("myarc-visual-parity")
+          ? IDC_NEW_WINDOW
+          : NO_COMMAND;
+  EXPECT_EQ(expected,
+            CommandForKeys(kVK_ANSI_N, CommandKeyState::kDown,
+                           ShiftKeyState::kUp, OptionKeyState::kUp,
+                           ControlKeyState::kDown, true));
+}
+
+TEST(GlobalKeyboardShortcuts, WorkspaceShortcutsFollowMyarcMode) {
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  const bool myarc = command_line->HasSwitch("myarc-visual-parity") &&
+                     command_line->HasSwitch("myarc-workspace-sidebar");
+  const auto option_command = [](int key) {
+    return CommandForKeys(key, CommandKeyState::kDown, ShiftKeyState::kUp,
+                          OptionKeyState::kDown);
+  };
+  const auto control = [](int key) {
+    return CommandForKeys(key, CommandKeyState::kUp, ShiftKeyState::kUp,
+                          OptionKeyState::kUp, ControlKeyState::kDown);
+  };
+  EXPECT_EQ(myarc ? IDC_MYARC_SELECT_PREVIOUS_SPACE : IDC_SELECT_PREVIOUS_TAB,
+            option_command(kVK_LeftArrow));
+  EXPECT_EQ(myarc ? IDC_MYARC_SELECT_NEXT_SPACE : IDC_SELECT_NEXT_TAB,
+            option_command(kVK_RightArrow));
+  EXPECT_EQ(myarc ? IDC_SELECT_PREVIOUS_TAB : IDC_FOCUS_PREVIOUS_PANE,
+            option_command(kVK_UpArrow));
+  EXPECT_EQ(myarc ? IDC_SELECT_NEXT_TAB : IDC_FOCUS_NEXT_PANE,
+            option_command(kVK_DownArrow));
+  EXPECT_EQ(myarc ? IDC_MYARC_SELECT_SPACE_0 : NO_COMMAND,
+            control(kVK_ANSI_1));
+  EXPECT_EQ(myarc ? IDC_MYARC_SELECT_SPACE_7 : NO_COMMAND,
+            control(kVK_ANSI_8));
+  EXPECT_EQ(myarc ? IDC_MYARC_SELECT_LAST_SPACE : NO_COMMAND,
+            control(kVK_ANSI_9));
+  EXPECT_EQ(myarc ? IDC_MYARC_TOGGLE_PIN : NO_COMMAND,
+            CommandForKeys(kVK_ANSI_D, CommandKeyState::kDown));
+  EXPECT_EQ(myarc, !AcceleratorsCocoa::GetInstance()->GetAcceleratorForCommand(
+                       IDC_BOOKMARK_THIS_TAB));
+  // Numbered tab commands stay; the controller maps them to sidebar order.
+  EXPECT_EQ(IDC_SELECT_TAB_0,
+            CommandForKeys(kVK_ANSI_1, CommandKeyState::kDown));
+  EXPECT_EQ(IDC_SELECT_LAST_TAB,
+            CommandForKeys(kVK_ANSI_9, CommandKeyState::kDown));
+}
