+// myArc mode answers Cmd+, with its native Settings window, owned by the last
+// active browser window. Leaves window activation to the Settings window.
+bool ShowMyarcSettings(Profile* profile) {
+  ProfileBrowserCollection* collection =
+      ProfileBrowserCollection::GetForProfile(
+          profile->IsGuestSession()
+              ? profile->GetPrimaryOTRProfile(/*create_if_needed=*/true)
+              : profile);
+  BrowserWindowInterface* browser =
+      collection ? collection->GetLastActiveBrowser() : nullptr;
+  BrowserWindow* window = browser ? BrowserWindow::FromBrowser(browser) : nullptr;
+  return window && window->ShowMyarcSettings();
+}
