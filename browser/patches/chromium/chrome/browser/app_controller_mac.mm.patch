+// myArc keeps all but one window of a Profile window group ordered out. With
+// no browser window on screen or in the Dock, returns the most recently active
+// ordered-out one, which is the last one its group showed.
+BrowserWindowInterface* LastOrderedOutBrowser() {
+  BrowserWindowInterface* last = nullptr;
+  bool any_shown = false;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* browser) {
+        if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+          return true;
+        }
+        ui::BaseWindow* window = browser->GetWindow();
+        if (window->IsVisible() || window->IsMinimized()) {
+          any_shown = true;
+          return false;
+        }
+        // A closing window is hidden while its tabs close.
+        if (!last &&
+            !UnloadController::From(browser)->is_attempting_to_close_browser()) {
+          last = browser;
+        }
+        return true;
+      });
+  return any_shown ? nullptr : last;
+}
