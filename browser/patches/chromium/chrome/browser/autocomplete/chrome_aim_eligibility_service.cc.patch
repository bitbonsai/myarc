+bool ChromeAimEligibilityService::IsAimAllowedByFeatureAndPolicy() const {
+  // The opted-in myarc prototype has no built-in AI enablement or provider.
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch("myarc-visual-parity") &&
+      command_line->HasSwitch("myarc-workspace-sidebar")) {
+    return false;
+  }
+  return AimEligibilityService::IsAimAllowedByFeatureAndPolicy();
+}
