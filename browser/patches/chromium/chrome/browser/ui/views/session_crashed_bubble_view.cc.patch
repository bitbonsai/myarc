+// The recovery choice starts before async consent lookup and outlives the
+// dialog when Restore closes it before constructing the native restorer.
+class SessionCrashedBubbleView::BrowserRemovalObserver
+    : public BrowserCollectionObserver,
+      public ProfileObserver {
+ public:
+  explicit BrowserRemovalObserver(BrowserWindowInterface* browser)
+      : browser_(browser) {
+    CHECK(browser_, base::NotFatalUntil::M162);
+    browser_collection_observation_.Observe(
+        GlobalBrowserCollection::GetInstance());
+    profile_observation_.Observe(browser_->GetProfile());
+    myarc::WorkspaceLifecycle::Notify(
+        profile_observation_.GetSource(),
+        myarc::WorkspaceLifecycle::Event::kRecoveryChoiceStarted);
+  }
+
+  BrowserRemovalObserver(const BrowserRemovalObserver&) = delete;
+  BrowserRemovalObserver& operator=(const BrowserRemovalObserver&) = delete;
+
+  ~BrowserRemovalObserver() override { FinishRecoveryChoice(); }
+
+  void OnBrowserClosed(BrowserWindowInterface* browser) override {
+    if (browser == browser_) {
+      browser_ = nullptr;
+      FinishRecoveryChoice();
+    }
+  }
+
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    browser_ = nullptr;
+    // Profile teardown can wait for renderers before destroying UserData.
+    myarc::WorkspaceLifecycle::Notify(
+        profile, myarc::WorkspaceLifecycle::Event::kShutdownStarted);
+    FinishRecoveryChoice();
+  }
+
+  BrowserWindowInterface* browser() const { return browser_; }
+
+ private:
+  void FinishRecoveryChoice() {
+    if (!profile_observation_.IsObserving()) {
+      return;
+    }
+    Profile* profile = profile_observation_.GetSource();
+    profile_observation_.Reset();
+    myarc::WorkspaceLifecycle::Notify(
+        profile, myarc::WorkspaceLifecycle::Event::kRecoveryChoiceFinished);
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+};
