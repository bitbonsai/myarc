+IN_PROC_BROWSER_TEST_F(BrowserViewPaletteIntentTest,
+                       ReuseIntentDraftsAndCancelThenReopen) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  auto* contents = active_web_contents();
+  const int count = browser()->GetTabStripModel()->count();
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(true));
+  ASSERT_TRUE(palette());
+  auto* widget = palette()->GetWidget();
+  EXPECT_TRUE(input()->GetText().empty());
+  Type(u"synthetic pending draft");
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(true));
+  EXPECT_EQ(widget, palette()->GetWidget());
+  EXPECT_EQ(u"synthetic pending draft", input()->GetText());
+  EXPECT_EQ(input()->GetText(), input()->GetSelectedText());
+  EXPECT_EQ(input(), widget->GetFocusManager()->GetFocusedView());
+
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(false));
+  EXPECT_EQ(widget, palette()->GetWidget());
+  EXPECT_EQ(LocationBarModel::From(browser())->GetFormattedFullURL(),
+            input()->GetText());
+  EXPECT_EQ(input()->GetText(), input()->GetSelectedText());
+  Type(u"synthetic current draft");
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(false));
+  EXPECT_EQ(u"synthetic current draft", input()->GetText());
+  EXPECT_EQ(input()->GetText(), input()->GetSelectedText());
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(true));
+  EXPECT_EQ(widget, palette()->GetWidget());
+  EXPECT_TRUE(input()->GetText().empty());
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(contents, active_web_contents());
+  EXPECT_EQ(url, contents->GetLastCommittedURL());
+
+  Type(u"pending history before cancel");
+  auto old_widget = widget->GetWeakPtr();
+  Press(ui::VKEY_ESCAPE);
+  EXPECT_FALSE(palette());
+  // Reopen before deferred old-widget/delegate deletion drains.
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(false));
+  ASSERT_TRUE(palette());
+  auto replacement = palette()->GetWidget()->GetWeakPtr();
+  EXPECT_NE(old_widget.get(), replacement.get());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(old_widget);
+  ASSERT_TRUE(replacement);
+  ASSERT_TRUE(palette());
+  EXPECT_EQ(replacement.get(), palette()->GetWidget());
+  EXPECT_EQ(LocationBarModel::From(browser())->GetFormattedFullURL(),
+            input()->GetText());
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+  Press(ui::VKEY_ESCAPE);
+}
