+  views::Button* FindResult(views::View* root, const GURL& url) {
+    if (auto* button = views::AsViewClass<views::Button>(root);
+        button && button->GetTooltipText() == base::UTF8ToUTF16(url.spec())) {
+      return button;
+    }
+    for (const auto& child : root->children()) {
+      if (auto* button = FindResult(child, url)) {
+        return button;
+      }
+    }
+    return nullptr;
+  }
+
+  views::Button* Result(const GURL& url) {
+    return FindResult(palette()->GetContentsView(), url);
