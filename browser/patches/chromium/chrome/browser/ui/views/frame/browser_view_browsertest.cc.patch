+class BrowserViewUrlPillTest : public BrowserViewStorageRetryTest {
+ protected:
+  void SetUpOnMainThread() override {
+    BrowserViewStorageRetryTest::SetUpOnMainThread();
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return browser_view()->GetMyarcWorkspaceAdapter()->ready(); }));
+    https_server_.ServeFilesFromSourceDirectory("chrome/test/data");
+    ASSERT_TRUE(https_server_.Start());
+  }
+
+  LocationBarView* bar() { return browser_view()->GetLocationBarView(); }
+
+  views::Button* CopyButton() {
+    for (views::View* child : bar()->children()) {
+      if (auto* button = views::AsViewClass<views::Button>(child);
+          button && button->GetTooltipText() ==
+                        l10n_util::GetStringUTF16(IDS_COPY_URL)) {
+        return button;
+      }
+    }
+    return nullptr;
+  }
+
+  void Hover(bool hovered) {
+    ui::MouseEvent event(
+        hovered ? ui::EventType::kMouseEntered : ui::EventType::kMouseExited,
+        gfx::PointF(), gfx::PointF(), ui::EventTimeForNow(), 0, 0);
+    auto* view = static_cast<views::View*>(bar());
+    if (hovered) {
+      view->OnMouseEntered(event);
+    } else {
+      view->OnMouseExited(event);
+    }
+    RunScheduledLayouts();
+  }
+
+  void Idle() {
+    bar()->GetFocusManager()->ClearFocus();
+    bar()->Revert();
+    Hover(false);
+  }
+
+  void PressCopy() {
+    views::test::ButtonTestApi(CopyButton())
+        .NotifyClick(ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_SPACE,
+                                  ui::EF_NONE));
+  }
+
+  std::u16string ClipboardText() {
+    base::test::TestFuture<std::u16string> text;
+    ui::Clipboard::GetForCurrentThread()->ReadText(
+        ui::ClipboardBuffer::kCopyPaste, std::nullopt, text.GetCallback());
+    return text.Get();
+  }
+
+  net::EmbeddedTestServer https_server_{net::EmbeddedTestServer::TYPE_HTTPS};
+};
