+void MultiContentsView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  if (!IsMyarcVisualParity() || !IsInSplitView()) {
+    return;
+  }
+  // Arc rings the active pane's card in a thin light line just outside it.
+  const bool dark = color_utils::IsDark(
+      GetColorProvider()->GetColor(ui::kColorSysSurface));
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(kMyarcActiveRing);
+  flags.setColor(dark ? SkColorSetARGB(0x66, 0xff, 0xff, 0xff)
+                      : SkColorSetARGB(0x40, 0x00, 0x00, 0x00));
+  gfx::RectF ring(GetActiveContentsContainerView()->bounds());
+  ring.Outset(kMyarcActiveRing / 2.f);
+  const float radius =
+      GetBackgroundRadii().upper_left() + kMyarcActiveRing / 2.f;
+  canvas->DrawRoundRect(ring, radius, flags);
+}
