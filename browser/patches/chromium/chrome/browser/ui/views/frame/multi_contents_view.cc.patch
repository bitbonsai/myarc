+void MultiContentsView::StartSplitOpenAnimation() {
+  split_close_animation_.Reset(0.0);
+  split_open_delay_timer_.Stop();
+  if (IsMyarcVisualParity() && gfx::Animation::ShouldRenderRichAnimation()) {
+    split_open_animation_.Reset(0.0);
+    split_open_delay_timer_.Start(
+        FROM_HERE, base::Milliseconds(45),
+        base::BindOnce(&gfx::SlideAnimation::Show,
+                       base::Unretained(&split_open_animation_)));
+  } else {
+    split_open_animation_.Reset(1.0);
+  }
+}
