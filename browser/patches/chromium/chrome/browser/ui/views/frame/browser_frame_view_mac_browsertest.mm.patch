+class MyarcCaptionHoverMacTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest>,
+      public testing::WithParamInterface<bool> {
+ public:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    VerticalTabsBrowserTestMixin::SetUpCommandLine(command_line);
+    if (GetParam()) {
+      command_line->AppendSwitch("myarc-visual-parity");
+    }
+    command_line->AppendSwitchASCII("disable-features", "InitialWebUI");
+  }
+};
+
+IN_PROC_BROWSER_TEST_P(MyarcCaptionHoverMacTest,
+                       NativeButtonsAndReservationFollowHoverLayout) {
+  auto* const view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* const region = view->vertical_tab_strip_region_view_for_testing();
+  auto* const state = vertical_tab_strip_state_controller();
+  auto* const animation = BrowserAnimationController::From(browser());
+  auto* const frame = static_cast<BrowserFrameViewMac*>(
+      view->GetWidget()->non_client_view()->frame_view());
+  NSWindow* const window =
+      view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  ASSERT_TRUE(window);
+  const auto expect_caption = [&](bool hidden) {
+    for (NSWindowButton kind :
+         {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+      NSButton* const button = [window standardWindowButton:kind];
+      ASSERT_TRUE(button);
+      EXPECT_EQ(hidden, static_cast<bool>(button.hidden));
+      EXPECT_NE(nullptr, button.action);
+    }
+    const auto params = frame->GetBrowserLayoutParams();
+    const float reserved = params.leading_exclusion.content.width() +
+                           params.trailing_exclusion.content.width();
+    EXPECT_EQ(hidden, reserved == 0.0f);
+  };
+  const auto settle = [&](BrowserAnimationMotion motion) {
+    // Native controller endpoint, including its real layout invalidation path.
+    // This does not measure intermediate AppKit motion or reduced motion.
+    animation->Reset(TabStripAnimations::kVerticalTabStrip, motion);
+    EXPECT_TRUE(views::ViewTestApi(frame).needs_layout());
+    RunScheduledLayouts();
+  };
+
+  auto no_peek =
+      region->GetExpandOnHoverLock(ExpandOnHoverLockType::kForceCollapse);
+  state->SetExpandOnHoverEnabled(true);
+  state->RequestCollapse(false);
+  settle(TabStripAnimations::kExpand);
+  expect_caption(false);
+
+  state->RequestCollapse(true);
+  settle(TabStripAnimations::kCollapse);
+  ASSERT_TRUE(state->IsCollapsed());
+  expect_caption(GetParam());
+  const gfx::Rect hidden_contents = view->multi_contents_view()->bounds();
+
+  no_peek.reset();
+  auto peek =
+      region->GetExpandOnHoverLock(ExpandOnHoverLockType::kKeepExpanded);
+  settle(TabStripAnimations::kExpandOnHover);
+  ASSERT_TRUE(region->is_expanded_on_hover());
+  EXPECT_TRUE(state->IsCollapsed());
+  expect_caption(false);
+  EXPECT_EQ(hidden_contents, view->multi_contents_view()->bounds());
+
+  no_peek = region->GetExpandOnHoverLock(ExpandOnHoverLockType::kForceCollapse);
+  settle(TabStripAnimations::kCollapseOnHover);
+  EXPECT_FALSE(region->is_expanded_on_hover());
+  expect_caption(GetParam());
+  EXPECT_EQ(hidden_contents, view->multi_contents_view()->bounds());
+
+  no_peek.reset();
+  settle(TabStripAnimations::kExpandOnHover);
+  expect_caption(false);
+  state->RequestCollapse(false);
+  settle(TabStripAnimations::kExpand);
+  EXPECT_FALSE(state->IsCollapsed());
+  expect_caption(false);
+  EXPECT_LT(view->multi_contents_view()->width(), hidden_contents.width());
+}
+
+INSTANTIATE_TEST_SUITE_P(VisualParityFlag,
+                         MyarcCaptionHoverMacTest,
+                         testing::Bool());
