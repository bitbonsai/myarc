 void BrowserFrameViewMac::Layout(PassKey) {
+  // Region animation updates invalidate this frame, including hover dismissal.
+  // Share caption bounds with the layout reservation.
+  if (ShouldManageMyarcCaptionButtons(GetBrowserView())) {
+    NSWindow* const window = GetWidget()->GetNativeWindow().GetNativeNSWindow();
+    const bool hidden = GetCaptionButtonBounds().bounds.IsEmpty();
+    // Arc's lights leave and return with the sidebar, so fade them with it.
+    const CGFloat alpha = GetMyarcSidebarVisibleFraction(GetBrowserView());
+    for (NSWindowButton button :
+         {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+      NSButton* const view = [window standardWindowButton:button];
+      view.hidden = hidden;
+      view.alphaValue = alpha;
+    }
+  }
   if (GetBrowserView()->IsWindowControlsOverlayEnabled()) {
     LayoutWindowControlsOverlay();
   }
