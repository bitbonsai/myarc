 namespace {
 
+bool ShouldManageMyarcCaptionButtons(BrowserView* browser_view) {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "myarc-visual-parity") ||
+      browser_view->browser()->GetType() !=
+          BrowserWindowInterface::Type::TYPE_NORMAL ||
+      browser_view->IsFullscreen() || !browser_view->GetWidget()) {
+    return false;
+  }
+  auto* const host = views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+      browser_view->GetWidget()->GetNativeWindow());
+  // Remote Cocoa mirrors stay upstream-owned.
+  return host && !host->application_host();
+}
