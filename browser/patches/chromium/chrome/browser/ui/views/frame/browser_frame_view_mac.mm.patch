 namespace {
 
+bool ShouldManageMyarcCaptionButtons(BrowserView* browser_view) {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "myarc-visual-parity") ||
+      browser_view->browser()->GetType() !=
+          BrowserWindowInterface::Type::TYPE_NORMAL ||
+      browser_view->IsFullscreen() || !browser_view->GetWidget()) {
+    return false;
+  }
+  auto* const host = views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+      browser_view->GetWidget()->GetNativeWindow());
+  // Remote Cocoa mirrors stay upstream-owned.
+  return host && !host->application_host();
+}
+
+// How much of the myArc sidebar is on screen: the slide while it hides or
+// shows, the peek while it is hidden, 1 while it is pinned.
+double GetMyarcSidebarVisibleFraction(BrowserView* browser_view) {
+  auto* const controller =
+      tabs::VerticalTabStripStateController::From(browser_view->browser());
+  if (!controller || !controller->ShouldDisplayVerticalTabs()) {
+    return 1.0;
+  }
+  const auto* const animation =
+      BrowserAnimationController::From(browser_view->browser());
+  const bool expanded = controller->GetCollapseState() ==
+                        tabs::VerticalTabStripCollapseState::kExpanded;
+  if (!animation) {
+    return expanded ? 1.0 : 0.0;
+  }
+  const auto value = [animation](BrowserAnimationSequence sequence) {
+    return animation
+        ->GetCurrentValue(TabStripAnimations::kVerticalTabStrip, sequence)
+        .value_or(0.0);
+  };
+  if (expanded &&
+      animation->GetCurrentMotion(TabStripAnimations::kVerticalTabStrip) !=
+          TabStripAnimations::kExpand) {
+    return 1.0;
+  }
+  return std::clamp(std::max(value(TabStripAnimations::kTabStripWidth),
+                             value(TabStripAnimations::kTabStripHoverWidth)),
+                    0.0, 1.0);
+}
