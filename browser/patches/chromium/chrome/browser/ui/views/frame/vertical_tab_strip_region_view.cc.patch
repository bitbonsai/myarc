+bool VerticalTabStripRegionView::IsMyarcHoverEdge(
+    const gfx::Point& screen_point) const {
+  if (!myarc_edge_monitor_ || !GetWidget()->IsActive() ||
+      browser_view()->IsFullscreen() ||
+      browser_view()->browser()->GetType() !=
+          BrowserWindowInterface::Type::TYPE_NORMAL ||
+      !state_controller_->ShouldDisplayVerticalTabs() ||
+      !target_collapse_state_.collapsed ||
+      !state_controller_->IsExpandOnHoverEnabled()) {
+    return false;
+  }
+  // shortcut: reuse the native collapsed resize width until edge measurements
+  // from the reference are available. This rectangle never reserves width.
+  gfx::Rect edge = browser_view()->GetBoundsInScreen();
+  edge.set_y(GetBoundsInScreen().y());
+  edge.set_height(height());
+  if (base::i18n::IsRTL()) {
+    edge.set_x(edge.right() - kCollapsedResizeAreaWidth);
+  }
+  edge.set_width(kCollapsedResizeAreaWidth);
+  return edge.Contains(screen_point);
+}
+
+void VerticalTabStripRegionView::OnEvent(const ui::Event& event) {
+  if (!myarc_edge_monitor_ || !event.IsMouseEvent()) {
+    return;
+  }
+  if (event.type() == ui::EventType::kMousePressed) {
+    // A page click at the edge must complete on its original target.
+    myarc_edge_hovered_ = false;
+    ResetExpandOnHoverTimers();
+    return;
+  }
+  // Cocoa root_location is window-relative; edge bounds are screen-relative.
+  const gfx::Point point = myarc_edge_monitor_->GetLastMouseLocation();
+  myarc_edge_hovered_ = IsMyarcHoverEdge(point);
+  UpdateExpandOnHoverState(
+      myarc_edge_hovered_ ||
+      (GetVisible() && GetBoundsInScreen().Contains(point)));
+}
