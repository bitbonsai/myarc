+  InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::SetMyarcWorkspaceReady(bool ready) {
+  if (myarc_workspace_ready_ == ready) {
+    return;
+  }
+  if (ready && GetFocusManager() &&
+      content_area_view_->Contains(GetFocusManager()->GetFocusedView())) {
+    GetFocusManager()->ClearFocus();
+    myarc_workspace_sidebar_->RequestFocus();
+  }
+  myarc_workspace_ready_ = ready;
+  content_area_view_->SetVisible(!ready);
+  InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::RemoveMyarcWorkspaceSidebar() {
+  views::View* sidebar = std::exchange(myarc_workspace_sidebar_, nullptr);
+  if (sidebar) {
+    RemoveChildViewT(sidebar);
+  }
+  myarc_workspace_ready_ = false;
+  content_area_view_->SetVisible(true);
+}
