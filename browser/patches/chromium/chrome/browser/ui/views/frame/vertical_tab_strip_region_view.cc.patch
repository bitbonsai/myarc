+
+void VerticalTabStripRegionView::SetMyarcWorkspaceReady(bool ready) {
+  if (myarc_workspace_ready_ == ready) {
+    return;
+  }
+  if (ready && GetFocusManager() &&
+      content_area_view_->Contains(GetFocusManager()->GetFocusedView())) {
+    GetFocusManager()->ClearFocus();
+    myarc_workspace_sidebar_->RequestFocus();
+  }
+  myarc_workspace_ready_ = ready;
+  content_area_view_->SetVisible(!ready);
+  InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::SetMyarcLibraryOpen(bool open) {
+  if (myarc_library_open_ == open) {
+    // The sidebar repeats the close once its rows replace the Library; the
+    // header returns then and fades in with them.
+    if (!open && std::exchange(myarc_library_leaving_, false)) {
+      if (IsAnimatingMyarcLibrary()) {
+        if (!top_button_container_->layer()) {
+          top_button_container_->SetPaintToLayer();
+          top_button_container_->layer()->SetFillsBoundsOpaquely(false);
+        }
+        myarc_header_fade_start_ = myarc_library_motion_->elapsed();
+        UpdateMyarcHeaderFade();
+      }
+      InvalidateLayout();
+    }
+    return;
+  }
+  myarc_library_open_ = open;
+  myarc_library_leaving_ = false;
+  EndMyarcHeaderFade();
+  myarc_library_motion_.reset();
+  if (myarc_workspace_sidebar_ && IsDrawn() && width() > 0 &&
+      !gfx::Animation::PrefersReducedMotion()) {
+    myarc_library_motion_ =
+        std::make_unique<MyarcLibraryMotion>(this, width(), open);
+    // The Library stays laid out until the sidebar swaps in its rows.
+    myarc_library_leaving_ = !open;
+  }
+  PreferredSizeChanged();
+}
+
+void VerticalTabStripRegionView::UpdateMyarcHeaderFade() {
+  if (myarc_header_fade_start_ && top_button_container_->layer()) {
+    top_button_container_->layer()->SetOpacity(std::clamp(
+        (myarc_library_motion_->elapsed() - *myarc_header_fade_start_) /
+            kMyarcHeaderFadeIn,
+        0.0, 1.0));
+  }
+}
+
+void VerticalTabStripRegionView::EndMyarcHeaderFade() {
+  if (std::exchange(myarc_header_fade_start_, std::nullopt) &&
+      top_button_container_->layer()) {
+    top_button_container_->DestroyLayer();
+  }
+}
+
+bool VerticalTabStripRegionView::IsAnimatingMyarcLibrary() const {
+  return myarc_library_motion_ && myarc_library_motion_->is_animating();
+}
+
+void VerticalTabStripRegionView::RemoveMyarcWorkspaceSidebar() {
+  views::View* sidebar = std::exchange(myarc_workspace_sidebar_, nullptr);
+  if (sidebar) {
+    RemoveChildViewT(sidebar);
+  }
+  myarc_workspace_ready_ = false;
+  myarc_library_open_ = false;
+  myarc_library_leaving_ = false;
+  EndMyarcHeaderFade();
+  myarc_library_motion_.reset();
+  content_area_view_->SetVisible(true);
+}
