 }  // namespace
 
+// Arc's Library width follows 1 - exp(-t / tau): opening lands about half way
+// in the first frame, closing starts a little slower.
+class VerticalTabStripRegionView::MyarcLibraryMotion
+    : public views::AnimationDelegateViews {
+ public:
+  MyarcLibraryMotion(VerticalTabStripRegionView* region, int from, bool open)
+      : views::AnimationDelegateViews(region),
+        region_(region),
+        from_(from),
+        duration_(base::Milliseconds(open ? 230 : 270)),
+        tau_(base::Milliseconds(open ? 40 : 70)),
+        animation_(duration_, gfx::LinearAnimation::kDefaultFrameRate, this) {
+    animation_.Start();
+  }
+
+  bool is_animating() const { return animation_.is_animating(); }
+  base::TimeDelta elapsed() const {
+    return duration_ * animation_.GetCurrentValue();
+  }
+
+  int Width(int to) const {
+    const auto eased = [this](double state) {
+      return 1 - std::exp(-(duration_ * state) / tau_);
+    };
+    return gfx::Tween::IntValueBetween(
+        eased(animation_.GetCurrentValue()) / eased(1), from_, to);
+  }
+
+  // views::AnimationDelegateViews:
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    region_->UpdateMyarcHeaderFade();
+    region_->InvalidateLayout();
+  }
+  void AnimationEnded(const gfx::Animation* animation) override {
+    // The sidebar has swapped in its rows by now.
+    region_->myarc_library_leaving_ = false;
+    region_->EndMyarcHeaderFade();
+    region_->InvalidateLayout();
+  }
+
+ private:
+  const raw_ptr<VerticalTabStripRegionView> region_;
+  const int from_;
+  const base::TimeDelta duration_;
+  const base::TimeDelta tau_;
+  gfx::LinearAnimation animation_;
+};
