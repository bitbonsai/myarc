+// Rows come from the omnibox engine: typed text, search suggestions, history
+// and bookmarks. Open tabs keep the palette's own matching.
+constexpr int kMyarcPaletteProviders =
+    static_cast<int>(AutocompleteProvider::Type::kBookmark |
+                     AutocompleteProvider::Type::kHistoryQuick |
+                     AutocompleteProvider::Type::kHistoryUrl |
+                     AutocompleteProvider::Type::kSearch |
+                     AutocompleteProvider::Type::kShortcuts);
+// Arc shows at most five or six rows.
+constexpr size_t kMyarcPaletteMaxRows = 6;
