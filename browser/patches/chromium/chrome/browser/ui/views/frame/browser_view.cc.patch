+// Download updates arrive per chunk; the Library only needs new, finished and
+// removed entries, so a short timer coalesces them.
+class BrowserView::MyarcDownloadWatcher final
+    : public download::AllDownloadItemNotifier::Observer {
+ public:
+  MyarcDownloadWatcher(content::DownloadManager* manager,
+                       base::RepeatingClosure refresh)
+      : refresh_(std::move(refresh)), notifier_(manager, this) {}
+
+  void OnManagerInitialized(content::DownloadManager* manager) override {
+    Schedule();
+  }
+  void OnDownloadCreated(content::DownloadManager* manager,
+                         download::DownloadItem* item) override {
+    Schedule();
+  }
+  void OnDownloadUpdated(content::DownloadManager* manager,
+                         download::DownloadItem* item) override {
+    Schedule();
+  }
+  void OnDownloadRemoved(content::DownloadManager* manager,
+                         download::DownloadItem* item) override {
+    Schedule();
+  }
+
+ private:
+  void Schedule() {
+    if (!timer_.IsRunning()) {
+      timer_.Start(FROM_HERE, base::Milliseconds(500), refresh_);
+    }
+  }
+
+  const base::RepeatingClosure refresh_;
+  base::OneShotTimer timer_;
+  download::AllDownloadItemNotifier notifier_;
+};
