+void BrowserView::MyarcProfileSwapCaptureAction(base::WeakPtr<BrowserView> view,
+                                                int step) {
+  if (!view) {
+    return;
+  }
+  BrowserView* shown = view.get();
+  // The footer button calls SwitchToSpaceInProfile with its entry.
+  const auto press_footer = [](BrowserView& view, auto matches) {
+    for (const auto& entry : MyarcOtherSpaces(*view.GetProfile())) {
+      if (matches(entry)) {
+        view.SwitchToSpaceInProfile(entry.profile_dir, entry.space_id);
+        return;
+      }
+    }
+    LOG(WARNING) << "myarc-swap no footer entry";
+  };
+  switch (step) {
+    case 0:
+      // Creating Space "Client" in new Profile "work" swaps to it.
+      shown->CreateProfile(
+          u"work",
+          base::BindOnce(
+              [](base::WeakPtr<BrowserView> view, const std::u16string& error) {
+                if (!view || !error.empty()) {
+                  LOG(WARNING) << "myarc-swap create failed " << error;
+                  return;
+                }
+                for (const auto& choice : MyarcProfileChoices()) {
+                  if (choice.name == u"work") {
+                    LOG(WARNING) << "myarc-swap created " << choice.id << " "
+                                 << view->CreateNamedSpace(
+                                        u"Client", {}, std::nullopt, choice.id);
+                  }
+                }
+              },
+              shown->myarc_workspace_weak_factory_.GetWeakPtr()));
+      break;
+    case 1:
+      // A page only work's window has, to tell the windows' tabs apart.
+      chrome::AddTabAt(shown->browser(),
+                       GURL("data:text/html,<title>work tab</title>work"), -1,
+                       true);
+      break;
+    case 2:
+      press_footer(*shown, [](const auto& entry) {
+        return entry.profile_dir == "Default";
+      });
+      break;
+    case 3:
+      press_footer(*shown,
+                   [](const auto& entry) { return entry.name == u"Client"; });
+      break;
+    case 4: {
+      const std::string mode =
+          base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+              kMyarcCaptureProfileSwap);
+      if (mode == "quit" || mode == "restore") {
+        chrome::AttemptExit();
+      } else if (mode == "reopen") {
+        shown->myarc_swapped_out_ = true;
+        myarc::SetShownInWindowsMenu(shown->GetNativeWindow(), false);
+        shown->Hide();
+      } else {
+        // The close button and Close Window close the window this way.
+        shown->Close();
+      }
+      break;
+    }
+    case 5:
+      press_footer(*shown, [shown](const auto& entry) {
+        return entry.profile_dir !=
+               shown->GetProfile()->GetBaseName().AsUTF8Unsafe();
+      });
+      break;
+    default:
+      break;
+  }
