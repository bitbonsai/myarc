+std::u16string BrowserView::CreateMyarcSpaceInProfile(
+    const std::string& profile_id,
+    std::string name,
+    const myarc::SpaceIconChoice& choice,
+    const std::optional<myarc::SpaceTheme>& theme) {
+  using Kind = myarc::SpaceIconChoice::Kind;
+  const myarc::foundation::SpaceThemeRecord theme_record =
+      MyarcThemeRecord(theme);
+  const auto kind = choice.kind == Kind::kEmoji
+                        ? myarc::foundation::SpaceIconKind::Emoji
+                    : choice.kind == Kind::kNamed
+                        ? myarc::foundation::SpaceIconKind::Named
+                        : myarc::foundation::SpaceIconKind::Unset;
+  std::string icon = choice.value;
+  if (GetProfile()->IsOffTheRecord() || GetProfile()->IsGuestSession()) {
+    return u"Spaces in another Profile can't be created from this window.";
+  }
+  // The menu listed it, but it may have been deleted since.
+  const base::FilePath path = MyarcProfilePath(profile_id);
+  if (path.empty()) {
+    return u"That Profile no longer exists.";
+  }
+  // The panel closes now, so later failures show in the sidebar.
+  using Result = myarc::foundation::MutationResult;
+  const auto fail = [](base::WeakPtr<BrowserView> view, std::string error) {
+    if (view) {
+      view->MyarcWorkspaceResult(Result{false, 0, rust::String(error)});
+    }
+  };
+  profiles::LoadProfileAsync(
+      path,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserView> view, decltype(fail) fail,
+             std::string name, myarc::foundation::SpaceIconKind kind,
+             std::string icon, myarc::foundation::SpaceThemeRecord theme,
+             Profile* profile) {
+            if (!profile ||
+                MyarcProfilePath(profile->GetBaseName().AsUTF8Unsafe())
+                    .empty()) {
+              fail(view, "Couldn't open the Profile for the new Space.");
+              return;
+            }
+            // Keeps the Profile loaded until the Space exists and the swap
+            // takes its own hold.
+            auto keep_alive = ScopedProfileKeepAlive::TryAcquire(
+                profile, ProfileKeepAliveOrigin::kSessionRestore);
+            if (!keep_alive) {
+              fail(view, "The Profile for the new Space is being deleted.");
+              return;
+            }
+            // Waits once if the Profile's workspace is still loading.
+            myarc::WorkspaceService::ForProfile(*profile).WhenLoaded(
+                base::BindOnce(
+                    [](base::WeakPtr<BrowserView> view, decltype(fail) fail,
+                       base::WeakPtr<Profile> profile, std::string name,
+                       myarc::foundation::SpaceIconKind kind, std::string icon,
+                       myarc::foundation::SpaceThemeRecord theme,
+                       std::unique_ptr<ScopedProfileKeepAlive>) {
+                      if (!profile) {
+                        fail(view,
+                             "The Profile closed before its new Space "
+                             "was created.");
+                        return;
+                      }
+                      // A new Profile starts with one empty default Space,
+                      // and its first Space takes that one's place, so the
+                      // Profile holds only the Space the user made.
+                      auto result =
+                          myarc::WorkspaceService::ForProfile(*profile)
+                              .CreateFirstSpace(name, kind, icon, theme);
+                      if (!result.ok) {
+                        fail(view,
+                             "Couldn't create the Space in that "
+                             "Profile. " +
+                                 std::string(result.error));
+                      } else if (view) {
+                        // The Spaces index tells every window's footer.
+                        const uint64_t created = result.id;
+                        view->MyarcWorkspaceResult(std::move(result));
+                        // Arc shows a new Space right away, in its Profile.
+                        view->SwapToMyarcProfile(*profile, created);
+                      }
+                    },
+                    view, fail, profile->GetWeakPtr(), std::move(name), kind,
+                    std::move(icon), theme, std::move(keep_alive)));
+          },
+          myarc_workspace_weak_factory_.GetWeakPtr(), fail, std::move(name),
+          kind, std::move(icon), theme_record));
+  return {};
+}
