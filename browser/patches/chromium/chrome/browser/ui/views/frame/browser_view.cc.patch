+// Whether the Spaces index may keep a Profile's entry: the Profile is listed
+// and not marked for deletion.
+bool MyarcKeepIndexedProfile(std::string_view dir) {
+  ProfileManager* manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  if (!manager) {
+    return true;
+  }
+  if (!myarc::IsIndexableProfileDir(dir)) {
+    return false;
+  }
+  const base::FilePath path =
+      manager->user_data_dir().Append(base::FilePath::FromUTF8Unsafe(dir));
+  return manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(
+             path) &&
+         !IsProfileDirectoryMarkedForDeletion(path);
+}
+
+// One per process, for every myArc window: drops removed Profiles from the
+// Spaces index, and runs `restored` after each Profile's session restore
+// ends, once its restorer is gone.
+class MyarcWindowGroupKeeper : public SessionRestoreObserver,
+                               public ProfileAttributesStorage::Observer {
+ public:
+  explicit MyarcWindowGroupKeeper(base::RepeatingClosure restored)
+      : restored_(std::move(restored)) {
+    SessionRestore::AddObserver(this);
+    myarc::SetIndexedProfileFilter(&MyarcKeepIndexedProfile);
+    if (ProfileManager* manager = g_browser_process->profile_manager()) {
+      // The storage outlives every window and its observer list is
+      // unchecked, so this process-long observer never removes itself.
+      manager->GetProfileAttributesStorage().AddObserver(this);
+    }
+    if (PrefService* local_state = g_browser_process->local_state()) {
+      myarc::PruneSpacesIndex(*local_state);
+    }
+  }
+
+  // SessionRestoreObserver:
+  void OnProfileSessionRestored(Profile*, int, int) override {
+    // Runs in the restorer's destructor.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                                restored_);
+  }
+
+  // ProfileAttributesStorage::Observer:
+  void OnProfileWasRemoved(const base::FilePath&,
+                           const std::u16string&) override {
+    if (PrefService* local_state = g_browser_process->local_state()) {
+      myarc::PruneSpacesIndex(*local_state);
+    }
+  }
+
+ private:
+  base::RepeatingClosure restored_;
+};
