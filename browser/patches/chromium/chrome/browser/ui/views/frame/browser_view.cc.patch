+class MyarcPaletteView : public views::BoxLayoutView,
+                         public views::TextfieldController,
+                         public AutocompleteController::Observer {
+  METADATA_HEADER(MyarcPaletteView, views::BoxLayoutView)
+
+ public:
+  MyarcPaletteView(base::WeakPtr<BrowserWindowInterface> browser,
+                   int width,
+                   bool new_tab,
+                   std::u16string initial_text)
+      : browser_(browser),
+        width_(width),
+        new_tab_(new_tab),
+        initial_text_(std::move(initial_text)) {
+    SetOrientation(views::BoxLayout::Orientation::kVertical);
+    // Geometry follows the Arc reference: 1 DIP border, 63 DIP input row,
+    // hairline separator, 46 DIP rows on a 50 DIP pitch.
+    auto* header = AddChildView(std::make_unique<views::BoxLayoutView>());
+    header->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+    header->SetCrossAxisAlignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    header->SetInsideBorderInsets(gfx::Insets::TLBR(0, 23, 0, 12));
+    search_icon_ = header->AddChildView(std::make_unique<views::ImageView>());
+    input_ = header->AddChildView(std::make_unique<views::Textfield>());
+    input_->SetController(this);
+    input_->SetPlaceholderText(u"Search or Enter URL...");
+    input_->GetViewAccessibility().SetName(u"Search or Enter URL");
+    input_->SetTextInputType(ui::TEXT_INPUT_TYPE_URL);
+    input_->SetFontList(gfx::FontList().DeriveWithSizeDelta(5).DeriveWithWeight(
+        gfx::Font::Weight::MEDIUM));
+    input_->SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(8, 10, 8, 0)));
+    header->SetFlexForView(input_, 1);
+    header->SetPreferredSize(gfx::Size(width_ - 2, 63));
+    separator_ = AddChildView(std::make_unique<MyarcPaletteHairline>());
+    separator_->SetBorder(
+        views::CreateEmptyBorder(gfx::Insets::TLBR(0, 11, 0, 11)));
+    separator_->SetPreferredSize(gfx::Size(width_ - 2, 1));
+    rows_ = AddChildView(std::make_unique<views::BoxLayoutView>());
+    rows_->SetOrientation(views::BoxLayout::Orientation::kVertical);
+    rows_->SetInsideBorderInsets(gfx::Insets::TLBR(6, 9, 11, 9));
+    rows_->SetBetweenChildSpacing(4);
+    error_ = AddChildView(std::make_unique<views::Label>());
+    error_->SetEnabledColor(ui::kColorSysError);
+    error_->SetVisible(false);
+    if (browser_) {
+      autocomplete_ = std::make_unique<AutocompleteController>(
+          std::make_unique<ChromeAutocompleteProviderClient>(
+              browser_->GetProfile()),
+          AutocompleteControllerConfig{.provider_types =
+                                           kMyarcPaletteProviders});
+      autocomplete_observation_.Observe(autocomplete_.get());
+    }
+    input_->SetText(initial_text_);
+    input_->SelectAll(false);
+    Rebuild();
+  }
+
+  views::Textfield* input() { return input_; }
+
+  void AddedToWidget() override {
+    root_view_ = GetWidget()->GetRootView();
+    root_view_->AddPreTargetHandler(&outside_click_closer_);
+  }
+
+  void RemovedFromWidget() override {
+    if (root_view_) {
+      root_view_->RemovePreTargetHandler(&outside_click_closer_);
+      root_view_ = nullptr;
+    }
+  }
+
+  void OnThemeChanged() override {
+    views::BoxLayoutView::OnThemeChanged();
+    dark_ = color_utils::IsDark(
+        GetColorProvider()->GetColor(ui::kColorBubbleBackground));
+    const ui::ColorVariant background =
+        dark_ ? ui::ColorVariant(kDarkBackground)
+              : ui::ColorVariant(ui::kColorBubbleBackground);
+    if (GetWidget() &&
+        GetWidget()->widget_delegate()->AsBubbleDialogDelegate()) {
+      GetWidget()
+          ->widget_delegate()
+          ->AsBubbleDialogDelegate()
+          ->SetBackgroundColor(background);
+    }
+    SetBorder(views::CreateRoundedRectBorder(
+        1, 12,
+        dark_ ? ui::ColorVariant(kDarkBorder)
+              : ui::ColorVariant(ui::kColorBubbleBorder)));
+    search_icon_->SetImage(ui::ImageModel::FromVectorIcon(
+        kMyarcSearchIcon,
+        dark_ ? ui::ColorVariant(SK_ColorWHITE)
+              : ui::ColorVariant(ui::kColorSysOnSurface),
+        17));
+    input_->SetBackgroundColor(background);
+    input_->SetTextColorId(ui::kColorSysOnSurface);
+    // Textfield placeholders only take color ids; this is the nearest dark
+    // neutral to Arc's #979797.
+    input_->SetPlaceholderTextColorId(dark_ ? ui::kColorSysOutline
+                                            : ui::kColorSysOnSurfaceVariant);
+    separator_->SetColor(
+        dark_ ? kDarkSeparator
+              : GetColorProvider()->GetColor(ui::kColorSeparator));
+    UpdateSelection();
+  }
+
+  void SetIntent(bool new_tab, std::u16string initial_text) {
+    if (new_tab_ != new_tab) {
+      new_tab_ = new_tab;
+      initial_text_ = std::move(initial_text);
+      input_->SetText(initial_text_);
+      Rebuild();
+    }
+  }
+
+  void FocusInput() {
+    if (!GetWidget() || GetWidget()->IsClosed()) {
+      return;
+    }
+    auto weak_this = weak_factory_.GetWeakPtr();
+    GetWidget()->Activate();
+    if (weak_this && GetWidget() && !GetWidget()->IsClosed()) {
+      input_->SelectAll(false);
+      input_->RequestFocus();
+    }
+  }
+
+  void PrepareToClose() {
+    autocomplete_observation_.Reset();
+    if (autocomplete_) {
+      autocomplete_->Stop(AutocompleteStopReason::kClobbered);
+    }
+    favicon_tasks_.TryCancelAll();
+    weak_factory_.InvalidateWeakPtrs();
+  }
+
+  base::WeakPtr<MyarcPaletteView> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& text) override {
+    Rebuild();
+  }
+
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override {
+    if (event.type() != ui::EventType::kKeyPressed ||
+        sender->IsIMEComposing()) {
+      return false;
+    }
+    if (event.key_code() == ui::VKEY_ESCAPE) {
+      GetWidget()->Close();
+      return true;
+    }
+    if (event.key_code() == ui::VKEY_RETURN) {
+      if (selected_ >= 0 && (new_tab_ || input_->GetText() != initial_text_)) {
+        ActivateResult(selected_);
+      } else {
+        Submit();
+      }
+      return true;
+    }
+    if (!buttons_.empty() && (event.key_code() == ui::VKEY_DOWN ||
+                              event.key_code() == ui::VKEY_UP)) {
+      const int count = static_cast<int>(buttons_.size());
+      selected_ =
+          event.key_code() == ui::VKEY_DOWN
+              ? (selected_ + 1) % count
+              : (selected_ < 0 ? count - 1 : (selected_ + count - 1) % count);
+      selection_moved_ = true;
+      UpdateSelection();
+      return true;
+    }
+    return false;
+  }
+
+  void OnResultChanged(AutocompleteController* controller,
+                       bool default_match_changed) override {
+    RenderResults();
+  }
+
+ private:
+  // A palette row: an open tab, or an omnibox match's destination.
+  struct Result {
+    base::WeakPtr<content::WebContents> tab;
+    GURL url;
+    bool is_search = false;
+  };
+
+  struct TabMatch {
+    base::WeakPtr<content::WebContents> tab;
+    GURL url;
+    std::u16string title;
+    std::u16string address;
+    ui::ImageModel favicon;
+  };
+
+  // Dark palette colors measured from Arc captures.
+  static constexpr SkColor kDarkBackground = SkColorSetRGB(0x18, 0x19, 0x19);
+  static constexpr SkColor kDarkBorder = SkColorSetRGB(0x45, 0x46, 0x46);
+  static constexpr SkColor kDarkSeparator = SkColorSetRGB(0x2F, 0x30, 0x30);
+  static constexpr SkColor kDarkTitle = SkColorSetRGB(0xD1, 0xD1, 0xD1);
+  static constexpr SkColor kDarkHint = SkColorSetRGB(0x64, 0x65, 0x65);
+  static constexpr SkColor kDarkChip = SkColorSetRGB(0x24, 0x25, 0x25);
+  static constexpr SkColor kDarkChipArrow = SkColorSetRGB(0xB5, 0xB5, 0xB5);
+  static constexpr SkColor kSelected = SkColorSetRGB(0x41, 0x48, 0xD7);
+
+  void Resize() {
+    const int row_count = std::max(1, static_cast<int>(buttons_.size()));
+    // Border, input row, separator and row insets plus a 50 DIP row pitch.
+    SetPreferredSize(gfx::Size(
+        width_, 79 + row_count * 50 + (error_->GetVisible() ? 32 : 0)));
+    if (GetWidget()) {
+      GetWidget()
+          ->widget_delegate()
+          ->AsBubbleDialogDelegate()
+          ->SizeToContents();
+    }
+  }
+
+  void UpdateSelection() {
+    for (size_t i = 0; i < buttons_.size(); ++i) {
+      const bool selected = static_cast<int>(i) == selected_;
+      buttons_[i]->SetBackground(views::CreateRoundedRectBackground(
+          selected ? kSelected : SK_ColorTRANSPARENT, 6));
+      const ui::ColorVariant foreground =
+          selected ? ui::ColorVariant(SK_ColorWHITE)
+          : dark_  ? ui::ColorVariant(kDarkTitle)
+                   : ui::ColorVariant(ui::kColorSysOnSurface);
+      buttons_[i]->title()->SetEnabledColor(foreground);
+      actions_[i]->SetEnabledColor(
+          selected ? ui::ColorVariant(SK_ColorWHITE)
+          : dark_  ? ui::ColorVariant(kDarkHint)
+                   : ui::ColorVariant(ui::kColorSysOnSurfaceVariant));
+      // Selected page rows put the icon on a white tile, as Arc does for
+      // favicons; search rows keep a bare icon in the title color.
+      const bool search = results_[i].is_search;
+      icons_[i]->SetBackground(
+          selected && !search
+              ? views::CreateRoundedRectBackground(SK_ColorWHITE, 6)
+              : nullptr);
+      // Page rows show the site favicon at 16 DIP, like the tab strip; the
+      // globe stands in only when the page has none.
+      if (!favicons_[i].IsEmpty()) {
+        icons_[i]->SetImage(favicons_[i]);
+        icons_[i]->SetImageSize(gfx::Size(16, 16));
+      } else {
+        icons_[i]->ResetImageSize();
+        icons_[i]->SetImage(ui::ImageModel::FromVectorIcon(
+            search ? kMyarcSearchIcon : vector_icons::kGlobeIcon,
+            selected && !search ? ui::ColorVariant(kSelected) : foreground,
+            17));
+      }
+      chips_[i]->SetBackground(views::CreateRoundedRectBackground(
+          selected ? ui::ColorVariant(SK_ColorWHITE)
+          : dark_  ? ui::ColorVariant(kDarkChip)
+                   : ui::ColorVariant(ui::kColorSysSurfaceVariant),
+          4));
+      chips_[i]->SetImage(ui::ImageModel::FromVectorIcon(
+          vector_icons::kArrowForwardIcon,
+          selected ? ui::ColorVariant(kSelected)
+          : dark_  ? ui::ColorVariant(kDarkChipArrow)
+                   : ui::ColorVariant(ui::kColorSysOnSurfaceVariant),
+          20));
+    }
+  }
+
+  void AddResultRow(const std::u16string& title,
+                    const std::u16string& address,
+                    const std::u16string& action_text,
+                    Result result,
+                    ui::ImageModel favicon = ui::ImageModel()) {
+    const bool is_tab = result.url.is_empty();
+    results_.push_back(std::move(result));
+    const gfx::FontList row_font =
+        gfx::FontList().DeriveWithSizeDelta(1).DeriveWithWeight(
+            gfx::Font::Weight::MEDIUM);
+    HoverButton::Params params;
+    auto icon = std::make_unique<views::ImageView>();
+    icon->SetPreferredSize(gfx::Size(24, 24));
+    icons_.push_back(icon.get());
+    favicons_.push_back(std::move(favicon));
+    params.icon_view = std::move(icon);
+    params.title = title;
+    params.add_vertical_label_spacing = false;
+    params.icon_label_spacing = 8;
+    auto secondary = std::make_unique<views::BoxLayoutView>();
+    secondary->SetBetweenChildSpacing(8);
+    secondary->SetCrossAxisAlignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto* action =
+        secondary->AddChildView(std::make_unique<views::Label>(action_text));
+    action->SetVisible(!action_text.empty());
+    action->SetFontList(row_font);
+    action->SetSubpixelRenderingEnabled(false);
+    action->SetAutoColorReadabilityEnabled(false);
+    actions_.push_back(action);
+    auto* chip = secondary->AddChildView(std::make_unique<views::ImageView>());
+    chip->SetPreferredSize(gfx::Size(24, 24));
+    chip->GetViewAccessibility().SetIsIgnored(true);
+    chip->SetVisible(is_tab);
+    chips_.push_back(chip);
+    params.secondary_view = std::move(secondary);
+    auto* button =
+        rows_->AddChildView(std::make_unique<MyarcPaletteResultButton>(
+            base::BindRepeating(&MyarcPaletteView::ActivateResult,
+                                base::Unretained(this),
+                                static_cast<int>(buttons_.size())),
+            std::move(params)));
+    button->title()->SetFontList(row_font);
+    button->title()->SetSubpixelRenderingEnabled(false);
+    button->title()->SetAutoColorReadabilityEnabled(false);
+    button->title()->SetEnabledColor(ui::kColorSysOnSurface);
+    button->SetBorder(
+        views::CreateEmptyBorder(gfx::Insets::TLBR(0, 10, 0, 13)));
+    button->SetPreferredSize(gfx::Size(width_ - 20, 46));
+    button->SetTooltipText(address);
+    if (!action_text.empty()) {
+      button->AddExtraAccessibleText(action_text);
+    }
+    button->SetFocusBehavior(views::View::FocusBehavior::ALWAYS);
+    buttons_.push_back(button);
+  }
+
+  void Rebuild() {
+    tabs_.clear();
+    selection_moved_ = false;
+    error_->SetVisible(false);
+    if (input_->GetText().size() > 4096) {
+      if (autocomplete_) {
+        autocomplete_->Stop(AutocompleteStopReason::kClobbered);
+      }
+      ClearRows();
+      error_->SetText(u"Use at most 4096 characters.");
+      error_->SetVisible(true);
+      Resize();
+      return;
+    }
+    const std::u16string query = base::i18n::ToLower(input_->GetText());
+    // Typed text leaves room for search suggestions below the tab rows.
+    const size_t max_tabs = query.empty() ? kMyarcPaletteMaxRows : 3;
+    if (browser_) {
+      auto* model = browser_->GetTabStripModel();
+      // shortcut: scan 512 tabs; expand for large-workspace search.
+      for (int i = 0;
+           i < std::min(model->count(), 512) && tabs_.size() < max_tabs; ++i) {
+        auto* contents = model->GetWebContentsAt(i);
+        const GURL& url = contents->GetLastCommittedURL();
+        if (url.is_empty() || url.IsAboutBlank()) {
+          continue;
+        }
+        std::u16string title = contents->GetTitle().substr(0, 160);
+        const std::u16string address =
+            base::UTF8ToUTF16(url.spec().substr(0, 512));
+        if (!query.empty() &&
+            base::i18n::ToLower(title + u" " + address).find(query) ==
+                std::u16string::npos) {
+          continue;
+        }
+        if (title.empty()) {
+          title = address;
+        }
+        auto* favicon_driver =
+            favicon::ContentFaviconDriver::FromWebContents(contents);
+        tabs_.push_back(
+            {contents->GetWeakPtr(), url, std::move(title), address,
+             favicon_driver && favicon_driver->FaviconIsValid()
+                 ? ui::ImageModel::FromImage(favicon_driver->GetFavicon())
+                 : ui::ImageModel()});
+      }
+    }
+    if (!autocomplete_ || query.empty()) {
+      if (autocomplete_) {
+        autocomplete_->Stop(AutocompleteStopReason::kClobbered);
+      }
+      RenderResults();
+      return;
+    }
+    // Start() reports results synchronously, then again as providers finish.
+    AutocompleteInput input(
+        std::u16string(input_->GetText()), metrics::OmniboxEventProto::OTHER,
+        ChromeAutocompleteSchemeClassifier(browser_->GetProfile()));
+    input.set_prevent_inline_autocomplete(true);
+    autocomplete_->Start(input);
+  }
+
+  void ClearRows() {
+    favicon_tasks_.TryCancelAll();
+    buttons_.clear();
+    actions_.clear();
+    icons_.clear();
+    favicons_.clear();
+    chips_.clear();
+    results_.clear();
+    rows_->RemoveAllChildViews();
+  }
+
+  // Shows the omnibox's top match, then open tabs, then the other matches.
+  void RenderResults() {
+    if (!browser_ || (GetWidget() && GetWidget()->IsClosed())) {
+      return;
+    }
+    const int previous = selected_;
+    ClearRows();
+    selected_ = -1;
+    std::vector<const AutocompleteMatch*> matches;
+    if (autocomplete_ && !input_->GetText().empty()) {
+      for (const AutocompleteMatch& match : autocomplete_->result()) {
+        const GURL& url = match.destination_url;
+        if (!url.is_valid() || url.spec().size() > 4096 ||
+            !(url.SchemeIsHTTPOrHTTPS() || url.SchemeIs("chrome")) ||
+            std::ranges::any_of(
+                tabs_, [&url](const auto& tab) { return tab.url == url; }) ||
+            std::ranges::any_of(matches, [&url](const auto* other) {
+              return other->destination_url == url;
+            })) {
+          continue;
+        }
+        matches.push_back(&match);
+      }
+    }
+    auto add_match = [this](const AutocompleteMatch& match) {
+      const bool search = AutocompleteMatch::IsSearchType(match.type);
+      const std::u16string address =
+          base::UTF8ToUTF16(match.destination_url.spec().substr(0, 512));
+      std::u16string title =
+          (search || match.description.empty() ? match.contents
+                                               : match.description)
+              .substr(0, 160);
+      if (title.empty()) {
+        title = address;
+      }
+      // Page rows name their address on the right, like Arc's hint text.
+      AddResultRow(title, address,
+                   search || match.description.empty()
+                       ? std::u16string()
+                       : match.contents.substr(0, 160),
+                   {nullptr, match.destination_url, search});
+      if (!search) {
+        RequestFavicon(buttons_.size() - 1, match.destination_url);
+      }
+    };
+    size_t next_match = 0;
+    if (!matches.empty()) {
+      add_match(*matches[next_match++]);
+    }
+    for (const auto& tab : tabs_) {
+      if (buttons_.size() >= kMyarcPaletteMaxRows) {
+        break;
+      }
+      AddResultRow(tab.title, tab.address, u"Switch to Tab", {tab.tab, GURL()},
+                   tab.favicon);
+    }
+    while (next_match < matches.size() &&
+           buttons_.size() < kMyarcPaletteMaxRows) {
+      add_match(*matches[next_match++]);
+    }
+    const int count = static_cast<int>(buttons_.size());
+    if (count == 0) {
+      auto* hint = rows_->AddChildView(std::make_unique<views::Label>(
+          new_tab_ ? u"Enter opens a new tab. Esc cancels."
+                   : u"Enter updates the current tab. Esc cancels."));
+      hint->SetEnabledColor(ui::kColorSysOnSurfaceVariant);
+      hint->SetPreferredSize(gfx::Size(width_ - 20, 46));
+    } else if (selection_moved_ && previous >= 0) {
+      // Late suggestions must not undo the user's arrow-key choice.
+      selected_ = std::min(previous, count - 1);
+    } else if (new_tab_ || (!input_->GetText().empty() &&
+                            input_->GetText() != initial_text_)) {
+      selected_ = 0;
+    }
+    // Icons, chips and colors are set here for both intents.
+    UpdateSelection();
+    Resize();
+  }
+
+  void RequestFavicon(size_t index, const GURL& url) {
+    auto* favicon_service = FaviconServiceFactory::GetForProfile(
+        browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+    if (!favicon_service) {
+      return;
+    }
+    favicon_service->GetFaviconImageForPageURL(
+        url,
+        base::BindOnce(&MyarcPaletteView::OnFavicon, weak_factory_.GetWeakPtr(),
+                       index),
+        &favicon_tasks_);
+  }
+
+  void OnFavicon(size_t index, const favicon_base::FaviconImageResult& result) {
+    if (index >= favicons_.size() || result.image.IsEmpty()) {
+      return;
+    }
+    favicons_[index] = ui::ImageModel::FromImage(result.image);
+    UpdateSelection();
+  }
+
+  void ShowNavigationError() {
+    error_->SetText(
+        u"Address unsupported. For search confirmation, open a page and "
+        u"use the address bar.");
+    error_->SetVisible(true);
+    Resize();
+  }
+
+  void ActivateResult(int index) {
+    if (!browser_ || index < 0 || index >= static_cast<int>(results_.size())) {
+      return;
+    }
+    if (!results_[index].url.is_empty()) {
+      const GURL url = results_[index].url;
+      if (!chrome::NavigateFromMyarcPalette(
+              browser_.get(), base::UTF8ToUTF16(url.spec()), new_tab_)) {
+        ShowNavigationError();
+        return;
+      }
+      if (GetWidget() && !GetWidget()->IsClosed()) {
+        GetWidget()->Close();
+      }
+      return;
+    }
+    if (!results_[index].tab) {
+      Rebuild();
+      return;
+    }
+    const int current = browser_->GetTabStripModel()->GetIndexOfWebContents(
+        results_[index].tab.get());
+    if (current < 0) {
+      Rebuild();
+      return;
+    }
+    GetWidget()->Close();
+    if (browser_) {
+      browser_->GetTabStripModel()->ActivateTabAt(current);
+    }
+  }
+
+  void Submit() {
+    if (!browser_) {
+      return;
+    }
+    if (!new_tab_ && !chrome::IsMyarcWorkspaceBlank(browser_.get()) &&
+        input_->GetText() == initial_text_) {
+      chrome::Reload(browser_.get(), WindowOpenDisposition::kCurrentTab);
+    } else if (!chrome::NavigateFromMyarcPalette(browser_.get(),
+                                                 input_->GetText(), new_tab_)) {
+      ShowNavigationError();
+      return;
+    }
+    if (GetWidget() && !GetWidget()->IsClosed()) {
+      GetWidget()->Close();
+    }
+  }
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  const int width_;
+  bool new_tab_;
+  std::u16string initial_text_;
+  raw_ptr<views::ImageView> search_icon_ = nullptr;
+  raw_ptr<views::Textfield> input_ = nullptr;
+  raw_ptr<MyarcPaletteHairline> separator_ = nullptr;
+  raw_ptr<views::BoxLayoutView> rows_ = nullptr;
+  raw_ptr<views::Label> error_ = nullptr;
+  std::vector<TabMatch> tabs_;
+  std::vector<Result> results_;
+  std::vector<raw_ptr<HoverButton>> buttons_;
+  std::vector<raw_ptr<views::Label>> actions_;
+  std::vector<raw_ptr<views::ImageView>> icons_;
+  std::vector<ui::ImageModel> favicons_;
+  std::vector<raw_ptr<views::ImageView>> chips_;
+  bool dark_ = true;
+  base::CancelableTaskTracker favicon_tasks_;
+  int selected_ = -1;
+  bool selection_moved_ = false;
+  std::unique_ptr<AutocompleteController> autocomplete_;
+  base::ScopedObservation<AutocompleteController,
+                          AutocompleteController::Observer>
+      autocomplete_observation_{this};
+  MyarcPaletteOutsideClickCloser outside_click_closer_{this};
+  raw_ptr<views::View> root_view_ = nullptr;
+  base::WeakPtrFactory<MyarcPaletteView> weak_factory_{this};
+};
