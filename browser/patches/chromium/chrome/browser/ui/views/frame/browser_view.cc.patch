+// Arc's large shadow makes the Mac bubble window much bigger than the visible
+// palette, and BubbleCloser ignores clicks inside the bubble window. Presses
+// outside the palette's bounds close it like any other outside click.
+class MyarcPaletteOutsideClickCloser : public ui::EventHandler {
+ public:
+  explicit MyarcPaletteOutsideClickCloser(views::View* palette)
+      : palette_(palette) {}
+
+  void OnMouseEvent(ui::MouseEvent* event) override {
+    if (event->type() != ui::EventType::kMousePressed || !event->target()) {
+      return;
+    }
+    gfx::Point point = event->location();
+    views::View::ConvertPointToTarget(
+        static_cast<views::View*>(event->target()), palette_, &point);
+    if (!palette_->GetLocalBounds().Contains(point) && palette_->GetWidget()) {
+      event->SetHandled();
+      palette_->GetWidget()->Close();
+    }
+  }
+
+ private:
+  raw_ptr<views::View> palette_;
+};
