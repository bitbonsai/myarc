+void BrowserView::LoadMyarcDownloadHistory() {
+  Profile* profile = browser_->GetProfile();
+  content::DownloadManager* manager = profile->GetDownloadManager();
+  DownloadCoreService* service =
+      DownloadCoreServiceFactory::GetForBrowserContext(profile);
+  if (!manager || !service) {
+    return;
+  }
+  // Chrome defers loading past downloads until its bubble or downloads page
+  // asks; myArc has neither, so the sidebar asks, as the bubble would.
+  service->InitializeHistory(
+      DownloadCoreService::DownloadHistoryLoadTrigger::kDownloadBubble);
+  if (manager->IsManagerInitialized()) {
+    return;
+  }
+  myarc_history_download_watcher_ = std::make_unique<MyarcDownloadWatcher>(
+      manager,
+      base::BindRepeating(
+          [](BrowserView* view) {
+            if (view->myarc_workspace_sidebar_) {
+              view->myarc_workspace_sidebar_->RefreshDownloadsStack();
+              view->myarc_workspace_sidebar_->RefreshLibraryDownloads();
+            }
+            content::DownloadManager* manager =
+                view->browser_->GetProfile()->GetDownloadManager();
+            if (!manager || manager->IsManagerInitialized()) {
+              // The timer allows deleting its owner from the task.
+              view->myarc_history_download_watcher_.reset();
+            }
+          },
+          base::Unretained(this)));
+}
