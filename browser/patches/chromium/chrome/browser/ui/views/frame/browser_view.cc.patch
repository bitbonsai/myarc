+// Centers the visible palette, not its shadow, 5 DIP above the browser
+// window's center like Arc.
+class MyarcPaletteBubbleDelegate : public views::BubbleDialogDelegate {
+ public:
+  explicit MyarcPaletteBubbleDelegate(views::View* anchor)
+      : views::BubbleDialogDelegate(anchor, views::BubbleBorder::FLOAT) {}
+
+  gfx::Rect GetAnchorRect() const override {
+    gfx::Rect rect = views::BubbleDialogDelegate::GetAnchorRect();
+    int offset = -5;
+    auto* frame = GetWidget() && GetWidget()->non_client_view()
+                      ? static_cast<views::BubbleFrameView*>(
+                            GetWidget()->non_client_view()->frame_view())
+                      : nullptr;
+    if (frame && frame->bubble_border()) {
+      // FLOAT centers the whole frame; the shadow is taller below the bubble.
+      const gfx::Insets shadow = frame->bubble_border()->GetInsets();
+      offset += (shadow.bottom() - shadow.top()) / 2;
+    }
+    rect.Offset(0, offset);
+    return rect;
+  }
+};
