+constexpr char kMyarcSwapFullscreenError[] =
+    "Exit full screen to switch Profiles.";
+
+myarc::foundation::MutationResult MyarcSwapError(std::string error) {
+  return {false, 0, rust::String(error)};
+}
+
+// Each Profile window group's latest swap request. A swap finishes only if
+// no newer one started from the same group meanwhile.
+std::map<int, uint64_t>& MyarcSwapGenerations() {
+  static base::NoDestructor<std::map<int, uint64_t>> generations;
+  return *generations;
+}
+
+}  // namespace
+
+void BrowserView::SwitchToSpaceInProfile(const std::string& profile_dir,
+                                         uint64_t space_id) {
+  if (IsFullscreen()) {
+    MyarcWorkspaceResult(MyarcSwapError(kMyarcSwapFullscreenError));
+    return;
+  }
+  if (GetProfile()->IsOffTheRecord() || GetProfile()->IsGuestSession()) {
+    MyarcWorkspaceResult(
+        MyarcSwapError("This window can't switch to another Profile."));
+    return;
+  }
+  if (profile_dir == GetProfile()->GetBaseName().AsUTF8Unsafe()) {
+    SelectSpace(space_id);
+    return;
+  }
+  // The footer listed it, but it may have been deleted since.
+  const base::FilePath path = MyarcProfilePath(profile_dir);
+  if (path.empty()) {
+    MyarcWorkspaceResult(MyarcSwapError("That Profile no longer exists."));
+    return;
+  }
+  profiles::LoadProfileAsync(
+      path, base::BindOnce(
+                [](base::WeakPtr<BrowserView> view, uint64_t space,
+                   Profile* profile) {
+                  if (!view) {
+                    return;
+                  }
+                  if (!profile ||
+                      MyarcProfilePath(profile->GetBaseName().AsUTF8Unsafe())
+                          .empty()) {
+                    view->MyarcWorkspaceResult(
+                        MyarcSwapError("Couldn't open that Profile."));
+                    return;
+                  }
+                  view->SwapToMyarcProfile(*profile, space);
+                },
+                myarc_workspace_weak_factory_.GetWeakPtr(), space_id));
+}
+
+void BrowserView::SwapToMyarcProfile(Profile& profile, uint64_t space) {
+  // kSessionRestore is the closest origin: a browser window opens soon.
+  auto keep_alive = ScopedProfileKeepAlive::TryAcquire(
+      &profile, ProfileKeepAliveOrigin::kSessionRestore);
+  if (!keep_alive) {
+    MyarcWorkspaceResult(MyarcSwapError("That Profile is being deleted."));
+    return;
+  }
+  // A slow Profile load must not undo a later swap from this group.
+  const uint64_t generation = ++MyarcSwapGenerations()[myarc_window_group_];
+  // Waits once if the Profile's workspace is still loading. Posted, so the
+  // swap never runs inside the pressed footer button's callback.
+  myarc::WorkspaceService::ForProfile(profile).WhenLoaded(base::BindOnce(
+      [](base::WeakPtr<BrowserView> view, base::WeakPtr<Profile> profile,
+         uint64_t space, uint64_t generation,
+         std::unique_ptr<ScopedProfileKeepAlive> keep_alive) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE,
+            base::BindOnce(&BrowserView::FinishMyarcProfileSwap, view, profile,
+                           space, generation, std::move(keep_alive)));
+      },
+      myarc_workspace_weak_factory_.GetWeakPtr(), profile.GetWeakPtr(), space,
+      generation, std::move(keep_alive)));
+}
+
+bool BrowserView::IsLatestMyarcSwap(uint64_t generation) const {
+  return MyarcSwapGenerations()[myarc_window_group_] == generation;
+}
+
+void BrowserView::FinishMyarcProfileSwap(
+    base::WeakPtr<Profile> profile,
+    uint64_t space,
+    uint64_t generation,
+    std::unique_ptr<ScopedProfileKeepAlive> keep_alive) {
+  if (!IsLatestMyarcSwap(generation)) {
+    LOG(WARNING) << "myarc-swap dropped stale swap " << generation;
+    return;
+  }
+  if (!profile) {
+    MyarcWorkspaceResult(
+        MyarcSwapError("The Profile closed before the switch."));
+    return;
+  }
+  // Full screen may have started while the Profile loaded.
+  if (IsFullscreen()) {
+    MyarcWorkspaceResult(MyarcSwapError(kMyarcSwapFullscreenError));
+    return;
+  }
+  if (!IsVisible() || GetWidget()->IsClosed()) {
+    return;
+  }
+  BrowserView* target = nullptr;
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    BrowserView* view = GetBrowserViewForBrowser(browser);
+    if (view && view != this && view->browser_->GetProfile() == profile.get() &&
+        view->myarc_window_group_ == myarc_window_group_ &&
+        !view->GetWidget()->IsClosed()) {
+      target = view;
+      break;
+    }
+  }
+  const gfx::Rect bounds = GetRestoredBounds();
+  const bool maximized = IsMaximized();
+  if (!target) {
+    if (GetBrowserWindowCreationStatusForProfile(*profile) !=
+        BrowserWindowInterface::CreationStatus::kOk) {
+      MyarcWorkspaceResult(
+          MyarcSwapError("Couldn't open a window for that Profile."));
+      return;
+    }
+    BrowserWindowCreateParams params(*profile, /*from_user_gesture=*/true);
+    params.initial_bounds = bounds;
+    params.initial_show_state = maximized
+                                    ? ui::mojom::WindowShowState::kMaximized
+                                    : ui::mojom::WindowShowState::kNormal;
+    // The workspace decides what the window shows, without a first-run tab
+    // or that Profile's startup pages.
+    params.should_trigger_session_restore = false;
+    BrowserWindowInterface* browser = ::CreateBrowserWindow(std::move(params));
+    target = browser ? GetBrowserViewForBrowser(browser) : nullptr;
+    if (!target) {
+      MyarcWorkspaceResult(
+          MyarcSwapError("Couldn't open a window for that Profile."));
+      return;
+    }
+    target->myarc_window_group_ = myarc_window_group_;
+    myarc::WorkspaceLifecycle::Notify(
+        profile.get(), myarc::WorkspaceLifecycle::Event::kNativeReady);
+  }
+  target->SelectMyarcSpaceWhenReady(space);
+  // Showing the target takes this window's place in the group.
+  target->myarc_swapped_out_ = true;
+  // Keep focus where the user has it: a background window swaps without
+  // bringing the app forward.
+  const bool activate = IsActive() && myarc::IsAppActive();
+  if (gfx::Animation::PrefersReducedMotion() || !myarc_workspace_sidebar_) {
+    target->ShowMyarcGroupWindow(activate);
+    return;
+  }
+  // Slides like a Space switch: the target first shows a copy of this window.
+  myarc::CaptureWidget(
+      *GetWidget(),
+      base::BindOnce(&BrowserView::CoverMyarcSwap,
+                     target->myarc_workspace_weak_factory_.GetWeakPtr(),
+                     myarc_workspace_weak_factory_.GetWeakPtr(),
+                     myarc_workspace_sidebar_->GetSpaceRowsBoundsInWidget(),
+                     activate, generation));
+}
+
+namespace {
+
+// Other Profiles' Spaces follow this Profile's in the footer, so the new
+// Space enters from the right, as a later Space does.
+constexpr int kMyarcSwapSlideShift = -1;
+// Presented frames to wait for the incoming window's page before sliding
+// anyway, and the wait's time limit if frames stop.
+constexpr int kMyarcSwapMaxFrames = 30;
+constexpr base::TimeDelta kMyarcSwapTimeout = base::Seconds(1);
+
+}  // namespace
+
+void BrowserView::CoverMyarcSwap(base::WeakPtr<BrowserView> from,
+                                 gfx::Rect rows,
+                                 bool activate,
+                                 uint64_t generation,
+                                 gfx::ImageSkia image) {
+  // Something else may have shown this window, the outgoing one closed, or a
+  // newer swap started while the outgoing window was captured.
+  if (!myarc_swapped_out_ || browser_widget_->IsClosed() ||
+      !IsLatestMyarcSwap(generation)) {
+    return;
+  }
+  if (!from || from->GetWidget()->IsClosed() || image.isNull()) {
+    ShowMyarcGroupWindow(activate);
+    return;
+  }
+  myarc_swap_cover_ =
+      std::make_unique<myarc::ProfileSwapCover>(*GetWidget(), image);
+  // The window material shows through the cover where the sidebar is
+  // see-through, so this window's own views stay hidden under it.
+  myarc_swap_layered_ = !layer();
+  if (myarc_swap_layered_) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+  }
+  layer()->SetOpacity(0.f);
+  rows.Intersect(gfx::Rect(image.size()));
+  myarc_swap_rows_ = rows.IsEmpty()
+                         ? gfx::ImageSkia()
+                         : gfx::ImageSkiaOperations::ExtractSubset(image, rows);
+  myarc_swap_rows_origin_ = rows.origin();
+  // Clear until the cover is on screen, so the frame this window last
+  // showed never flashes.
+  GetWidget()->SetOpacity(0.f);
+  myarc_swap_timeout_.Start(
+      FROM_HERE, kMyarcSwapTimeout,
+      base::BindOnce(&BrowserView::DropMyarcSwapCover, base::Unretained(this)));
+  // With the cover up, the outgoing window stays until the cover drops.
+  if (!ShowMyarcGroupWindow(activate)) {
+    DropMyarcSwapCover();
+    return;
+  }
+  WaitForMyarcSwapFrame(0);
+}
+
+void BrowserView::WaitForMyarcSwapFrame(int frame) {
+  ui::Compositor* compositor = GetWidget()->GetCompositor();
+  if (!compositor || frame >= kMyarcSwapMaxFrames) {
+    DropMyarcSwapCover();
+    return;
+  }
+  compositor->RequestSuccessfulPresentationTimeForNextFrame(base::BindOnce(
+      [](base::WeakPtr<BrowserView> view, int frame,
+         const viz::FrameTimingDetails&) {
+        if (view && view->myarc_swap_cover_) {
+          view->OnMyarcSwapFrame(frame);
+        }
+      },
+      myarc_workspace_weak_factory_.GetWeakPtr(), frame));
+  compositor->ScheduleFullRedraw();
+}
+
+void BrowserView::OnMyarcSwapFrame(int frame) {
+  if (frame == 0) {
+    // The cover is on screen and matches the outgoing window.
+    GetWidget()->SetOpacity(1.f);
+  }
+  // Waits one more frame once the page is ready, so that frame is on screen.
+  if (frame < 2 || !IsMyarcSwapContentReady()) {
+    WaitForMyarcSwapFrame(frame + 1);
+    return;
+  }
+  DropMyarcSwapCover();
+}
+
+bool BrowserView::IsMyarcSwapContentReady() {
+  if (!myarc_workspace_adapter_ || !myarc_workspace_adapter_->ready() ||
+      myarc_pending_space_) {
+    return false;
+  }
+  if (IsMyarcWorkspaceBlank()) {
+    return true;
+  }
+  content::WebContents* contents = GetActiveWebContents();
+  content::RenderWidgetHostView* view =
+      contents ? contents->GetRenderWidgetHostView() : nullptr;
+  return !view || view->IsSurfaceAvailableForCopy();
+}
+
+void BrowserView::DropMyarcSwapCover() {
+  if (!myarc_swap_cover_) {
+    return;
+  }
+  myarc_swap_timeout_.Stop();
+  myarc_swap_cover_.reset();
+  if (layer()) {
+    layer()->SetOpacity(1.f);
+    if (std::exchange(myarc_swap_layered_, false)) {
+      DestroyLayer();
+    }
+  }
+  GetWidget()->SetOpacity(1.f);
+  if (myarc_workspace_sidebar_) {
+    myarc_workspace_sidebar_->SlideInSpace(std::exchange(myarc_swap_rows_, {}),
+                                           myarc_swap_rows_origin_,
+                                           kMyarcSwapSlideShift);
+  }
+  // This window covers it now, so ordering it out shows nothing.
+  if (BrowserView* outgoing = myarc_swap_outgoing_.get();
+      outgoing && outgoing->myarc_swapped_out_) {
+    outgoing->Hide();
+  }
+  myarc_swap_outgoing_ = nullptr;
+}
+
+bool BrowserView::ShowMyarcGroupWindow(bool activate) {
+  RestoreMyarcWindowGroup();
+  if (!myarc_swapped_out_ || browser_widget_->IsClosed()) {
+    return false;
+  }
+  // Session restore shows and activates every window it restores. A window
+  // that was ordered out stays ordered out.
+  if (SessionRestore::IsRestoring(GetProfile())) {
+    // Never shown, so nothing told its views, and through them its pages,
+    // that it's hidden. Tell them as hiding a shown window does, so its
+    // pages are throttled like any hidden window's.
+    if (!IsVisible()) {
+      GetWidget()->OnNativeWidgetVisibilityChanged(false);
+    }
+    return true;
+  }
+  myarc_swapped_out_ = false;
+  BrowserView* shown = nullptr;
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    BrowserView* view = GetBrowserViewForBrowser(browser);
+    if (view && view != this &&
+        view->myarc_window_group_ == myarc_window_group_ &&
+        !view->myarc_swapped_out_ && view->IsVisible() &&
+        !view->GetWidget()->IsClosed()) {
+      shown = view;
+      break;
+    }
+  }
+  // With no window of the group on screen, this one shows where it was.
+  if (shown) {
+    const gfx::Rect bounds = shown->GetRestoredBounds();
+    if (shown->IsMaximized()) {
+      SetBounds(bounds);
+      Maximize();
+    } else {
+      if (IsMaximized()) {
+        Restore();
+      }
+      SetBounds(bounds);
+    }
+  }
+  myarc::SetShownInWindowsMenu(GetNativeWindow(), true);
+  PersistMyarcWindowGroup();
+  if (activate) {
+    Show();
+  } else {
+    ShowInactive();
+    // Menu commands, new tabs and links from other apps go to the last active
+    // Browser, which must be the shown one even while the app is in the
+    // background. Show() updates it for the other branch. A background app
+    // gets no deactivation, so the state may still read active from an
+    // earlier show, and DidBecomeActive only moves the Browser up when it
+    // reads inactive.
+    auto* state = BrowserActiveStateManager::From(browser_);
+    state->DidBecomeInactive();
+    state->DidBecomeActive();
+    state->DidBecomeInactive();
+  }
+  if (shown) {
+    // Ordered out, not closed: its tabs and state stay for the swap back.
+    shown->myarc_swapped_out_ = true;
+    myarc::SetShownInWindowsMenu(shown->GetNativeWindow(), false);
+    shown->PersistMyarcWindowGroup();
+    if (myarc_swap_cover_) {
+      // The cover matches the outgoing window, so this one goes on top.
+      myarc::OrderWindowAbove(GetNativeWindow(), shown->GetNativeWindow());
+      myarc_swap_outgoing_ = shown->myarc_workspace_weak_factory_.GetWeakPtr();
+    } else {
+      shown->Hide();
+    }
+  }
+  return true;
+}
+
+void BrowserView::RestoreMyarcWindowGroup() {
+  // Only the first show of a restored window reads its saved group.
+  if (std::exchange(myarc_group_restore_checked_, true) ||
+      !myarc_workspace_adapter_ || !SessionRestore::IsRestoring(GetProfile()) ||
+      !myarc_workspace_adapter_->restored_group()) {
+    return;
+  }
+  // Group numbers start over each run, so the saved number maps to a new one
+  // shared by every window restored with it.
+  static base::NoDestructor<std::map<uint64_t, int>> restored_groups;
+  auto [group, added] = restored_groups->try_emplace(
+      myarc_workspace_adapter_->restored_group(), 0);
+  if (added) {
+    group->second = NextMyarcWindowGroup();
+  }
+  myarc_window_group_ = group->second;
+  myarc_swapped_out_ =
+      myarc_workspace_adapter_->restored_group_hidden() && !IsVisible();
+  if (myarc_swapped_out_) {
+    myarc::SetShownInWindowsMenu(GetNativeWindow(), false);
+  }
+  PersistMyarcWindowGroup();
+}
+
+void BrowserView::PersistMyarcWindowGroup() {
+  if (myarc_workspace_adapter_) {
+    myarc_workspace_adapter_->SetWindowGroup(myarc_window_group_,
+                                             myarc_swapped_out_);
+  }
+}
 
