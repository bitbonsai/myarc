+            [](std::vector<base::WeakPtr<BrowserView>> hidden, bool activate) {
+              for (const auto& view : hidden) {
+                if (view && !IsMyarcProfileClosing(*view->GetProfile()) &&
+                    !UnloadController::From(view->browser_)
+                         ->is_attempting_to_close_browser() &&
+                    view->ShowMyarcGroupWindow(activate)) {
