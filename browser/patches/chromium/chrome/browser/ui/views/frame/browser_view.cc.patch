+  auto* const header = vertical_tab_strip_region_view_->GetTopContainer();
+  const bool vertical = ShouldDrawVerticalTabStrip();
+  const bool reparent = vertical ? toolbar_->parent() == top_container_
+                                 : toolbar_->parent() == header;
+  if (reparent) {
+    auto* const focus = GetFocusManager()->GetFocusedView();
+    const bool restore_focus =
+        toolbar_->Contains(focus) ||
+        (!vertical && vertical_tab_strip_region_view_->Contains(focus));
+    if (restore_focus) {
+      GetFocusManager()->ClearFocus();
+      GetFocusManager()->SetStoredFocusView(nullptr);
+    }
+    if (vertical) {
+      toolbar_->SetMyarcSidebarToggle(
+          header->RemoveChildViewT(header->GetCollapseButton()));
+      header->SetMyarcSidebarToolbar(
+          top_container_->RemoveChildViewT(toolbar_.get()));
+    } else {
+      // Clear each borrowed reference before ownership leaves its parent.
+      header->AddChildView(toolbar_->TakeMyarcSidebarToggle());
+      top_container_->AddChildView(header->TakeMyarcSidebarToolbar());
+      toolbar_->SetVisible(true);
+    }
+    EnsureFocusOrder();
+    if (restore_focus) {
+      // Reparenting can hide the old focus target until the new mode lays out.
+      // Never restore into a stale mode, nested UI loop or closing window.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+          FROM_HERE, base::BindOnce(
+                         [](base::WeakPtr<BrowserView> view, bool vertical) {
+                           if (!view || !view->GetWidget() ||
+                               view->GetWidget()->IsClosed() ||
+                               !view->GetWidget()->IsActive() ||
+                               view->ShouldDrawVerticalTabStrip() != vertical ||
+                               view->GetFocusManager()->GetFocusedView()) {
+                             return;
+                           }
+                           view->GetWidget()->LayoutRootViewIfNecessary();
+                           if (!view) {
+                             return;
+                           }
+                           if (view->toolbar_->IsDrawn()) {
+                             view->SetFocusToLocationBar(false);
