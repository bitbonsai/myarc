+bool BrowserView::DropFavorite(uint64_t item, uint64_t before) {
+  auto weak = myarc_workspace_weak_factory_.GetWeakPtr();
+  auto& adapter = *myarc_workspace_adapter_;
+  const auto sidebar = adapter.Sidebar();
+  const bool favorite = std::ranges::any_of(
+      sidebar.favorites, [item](const auto& row) { return row.id == item; });
+  auto result = favorite ? adapter.MoveItemBefore(item, before)
+                         : adapter.Favorite(item);
+  if (!weak) {
+    return false;
+  }
+  if (!favorite && result.ok) {
+    result = weak->myarc_workspace_adapter_->MoveItemBefore(item, before);
+    if (!weak) {
+      return false;
+    }
+  }
+  const bool ok = result.ok;
+  // A reorder failure keeps any successful promotion and reports the error.
+  // Never roll back by unsaving, which would remove the canonical URL.
+  weak->MyarcWorkspaceResult(std::move(result));
+  return ok;
+}
