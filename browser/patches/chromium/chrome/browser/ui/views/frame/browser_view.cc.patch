+// The entry's local name. Arc calls the first Profile "Default" until it is
+// renamed, where Chromium would say "Your Chromium".
+std::u16string MyarcProfileEntryName(const ProfileAttributesEntry& entry) {
+  if (entry.IsUsingDefaultName() &&
+      entry.GetPath() ==
+          profiles::GetDefaultProfileDir(
+              g_browser_process->profile_manager()->user_data_dir())) {
+    return u"Default";
+  }
+  return entry.GetLocalProfileName();
+}
+
+// Guest has no entry.
+std::u16string MyarcProfileName(Profile& profile) {
+  ProfileAttributesEntry* entry = g_browser_process->profile_manager()
+                                      ->GetProfileAttributesStorage()
+                                      .GetProfileAttributesWithPath(
+                                          profile.GetPath());
+  return entry ? MyarcProfileEntryName(*entry)
+               : profiles::GetAvatarNameForProfile(profile.GetPath());
+}
+
+// The Create a Space panel's Profiles in Chromium's display order, each by its
+// directory name. Omitted and ephemeral Profiles stay out.
+std::vector<myarc::ProfileChoice> MyarcProfileChoices() {
+  std::vector<myarc::ProfileChoice> choices;
+  for (const ProfileAttributesEntry* entry :
+       g_browser_process->profile_manager()
+           ->GetProfileAttributesStorage()
+           .GetAllProfilesAttributesSortedForDisplay()) {
+    if (entry->IsOmitted() || entry->IsEphemeral()) {
+      continue;
+    }
+    choices.push_back({.id = entry->GetPath().BaseName().AsUTF8Unsafe(),
+                       .name = MyarcProfileEntryName(*entry)});
+  }
+  return choices;
+}
+
+// The directory of the listed Profile `id`, or empty when the Profile is gone
+// or being deleted.
+base::FilePath MyarcProfilePath(const std::string& id) {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager || !std::ranges::any_of(MyarcProfileChoices(),
+                                       [&id](const myarc::ProfileChoice& c) {
+                                         return c.id == id;
+                                       })) {
+    return {};
+  }
+  const base::FilePath path =
+      manager->user_data_dir().Append(base::FilePath::FromUTF8Unsafe(id));
+  return IsProfileDirectoryMarkedForDeletion(path) ? base::FilePath() : path;
+}
+
+// Every other listed Profile's Spaces from the Spaces index, in the Profile
+// menu's order. Reads Local State only and loads no Profile. Incognito and
+// Guest windows show none.
+std::vector<myarc::SidebarView::OtherSpaceEntry> MyarcOtherSpaces(
+    Profile& profile) {
+  std::vector<myarc::SidebarView::OtherSpaceEntry> result;
+  PrefService* local_state = g_browser_process->local_state();
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (profile.IsOffTheRecord() || profile.IsGuestSession() || !local_state ||
+      !manager) {
+    return result;
+  }
+  const std::vector<myarc::IndexedSpace> index =
+      myarc::ReadSpacesIndex(*local_state);
+  if (index.empty()) {
+    return result;
+  }
+  const std::string own = profile.GetBaseName().AsUTF8Unsafe();
+  using Kind = myarc::SpaceIconChoice::Kind;
+  using IndexedKind = myarc::IndexedSpace::IconKind;
+  for (const myarc::ProfileChoice& choice : MyarcProfileChoices()) {
+    if (choice.id == own ||
+        IsProfileDirectoryMarkedForDeletion(manager->user_data_dir().Append(
+            base::FilePath::FromUTF8Unsafe(choice.id)))) {
+      continue;
+    }
+    for (const myarc::IndexedSpace& space : index) {
+      if (space.profile_dir != choice.id) {
+        continue;
+      }
+      myarc::SpaceIconChoice icon{
+          space.icon_kind == IndexedKind::kEmoji   ? Kind::kEmoji
+          : space.icon_kind == IndexedKind::kNamed ? Kind::kNamed
+                                                   : Kind::kNone,
+          space.icon};
+      if (icon.kind == Kind::kNone || !myarc::IsBundledSpaceIcon(icon)) {
+        icon = {};
+      }
+      result.push_back({.profile_dir = space.profile_dir,
+                        .space_id = space.space_id,
+                        .name = base::UTF8ToUTF16(space.name),
+                        .profile_name = choice.name,
+                        .icon = std::move(icon),
+                        .order = space.order});
+    }
+  }
+  return result;
+}
+
+}  // namespace
+
+std::unique_ptr<myarc::SettingsWindow> BrowserView::CreateMyarcSettingsWindow() {
+  // Settings edit the original Profile's workspace: an Incognito window's
+  // workspace is thrown away, so its Settings set its regular Profile's timer.
+  // Guest keeps no workspace and shows the timer as unavailable.
+  Profile* profile = GetProfile()->GetOriginalProfile();
+  myarc::SettingsWindow::ArchiveTimer timer;
+  timer.profile_name = MyarcProfileName(*profile);
+  timer.get = base::BindRepeating(
+      [](base::WeakPtr<Profile> profile) -> uint64_t {
+        if (!profile) {
+          return 0;
+        }
+        auto& service = myarc::WorkspaceService::ForProfile(*profile);
+        return service.storage_state() ==
+                       myarc::WorkspaceService::StorageState::kEphemeral
+                   ? 0
+                   : service.ArchiveIntervalSecs();
+      },
+      profile->GetWeakPtr());
+  timer.set = base::BindRepeating(
+      [](base::WeakPtr<Profile> profile, base::WeakPtr<BrowserView> view,
+         uint64_t secs) {
+        if (!profile) {
+          return;
+        }
+        auto result =
+            myarc::WorkspaceService::ForProfile(*profile).SetArchiveInterval(
+                secs);
+        if (view) {
+          view->MyarcWorkspaceResult(std::move(result));
+        }
+      },
+      profile->GetWeakPtr(), GetAsWeakPtr());
+  return std::make_unique<myarc::SettingsWindow>(
+      profile, g_browser_process->local_state(),
+      base::BindRepeating(&BrowserView::OpenChromiumSettings, GetAsWeakPtr()),
+      base::BindRepeating(&BrowserView::OpenMyarcSite, GetAsWeakPtr()),
+      std::move(timer));
+}
