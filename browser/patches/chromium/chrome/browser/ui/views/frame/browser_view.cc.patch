+  if (!initialized_ || !GetWidget() || GetWidget()->IsClosed() ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "myarc-visual-parity") ||
+      !vertical_tab_strip_region_view_) {
+    return;
+  }
+  if (!myarc_popup_anchor_) {
+    // Keep the 0016 anchor alive across both modes, including recovery UI.
+    myarc_popup_anchor_ = AddChildView(std::make_unique<views::View>());
+    myarc_popup_anchor_->SetCanProcessEventsWithinSubtree(false);
+    myarc_popup_anchor_->GetViewAccessibility().SetIsIgnored(true);
+  }
