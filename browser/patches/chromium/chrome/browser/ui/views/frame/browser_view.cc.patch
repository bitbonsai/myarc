+std::vector<myarc::SidebarView::DownloadPresentation>
+BrowserView::GetRecentDownloads() const {
+  std::vector<myarc::SidebarView::DownloadPresentation> result;
+  content::DownloadManager* manager =
+      browser_->GetProfile()->GetDownloadManager();
+  if (!manager) {
+    return result;
+  }
+  content::DownloadManager::DownloadVector items;
+  manager->GetAllDownloads(&items);
+  std::erase_if(items, [](const download::DownloadItem* item) {
+    return item->IsTemporary() || item->IsTransient() ||
+           item->GetFileNameToReportUser().empty();
+  });
+  // The Library lists recent downloads; Chrome's page has the rest.
+  constexpr size_t kMaxDownloads = 50;
+  const size_t count = std::min(items.size(), kMaxDownloads);
+  std::partial_sort(items.begin(), items.begin() + count, items.end(),
+                    [](const download::DownloadItem* a,
+                       const download::DownloadItem* b) {
+                      return a->GetStartTime() > b->GetStartTime();
+                    });
+  IconManager* icons = g_browser_process->icon_manager();
+  const float scale = MyarcIconScale();
+  // Only the downloads stack shows icons, so only its rows load them.
+  size_t icon_rows = 0;
+  for (size_t i = 0; i < count; ++i) {
+    const download::DownloadItem* item = items[i];
+    std::u16string detail = base::UTF8ToUTF16(item->GetURL().host());
+    const bool complete =
+        item->GetState() == download::DownloadItem::COMPLETE &&
+        !item->GetFileExternallyRemoved();
+    if (item->GetState() != download::DownloadItem::COMPLETE) {
+      detail = item->GetState() == download::DownloadItem::IN_PROGRESS
+                   ? u"Downloading"
+                   : u"Not downloaded";
+    } else if (item->GetFileExternallyRemoved()) {
+      detail = u"File removed";
+    }
+    ui::ImageModel icon;
+    const base::FilePath& path = item->GetTargetFilePath();
+    if (complete && icons && !path.empty() &&
+        icon_rows++ < myarc::library::kStackRows) {
+      if (const gfx::Image* image =
+              icons->LookupIconFromFilepath(path, IconLoader::NORMAL, scale);
+          image && !image->IsEmpty()) {
+        icon = ui::ImageModel::FromImage(*image);
+      } else if (myarc_requested_download_icons_.insert(path).second) {
+        // Each path loads once; a failed load keeps the generic icon.
+        icons->LoadIcon(
+            path, IconLoader::NORMAL, scale,
+            base::BindOnce(
+                [](base::WeakPtr<const BrowserView> view, gfx::Image image) {
+                  if (view && !image.IsEmpty() &&
+                      view->myarc_workspace_sidebar_) {
+                    view->myarc_workspace_sidebar_->RefreshDownloadsStack();
+                  }
+                },
+                myarc_workspace_weak_factory_.GetWeakPtr()),
+            &myarc_download_icon_tracker_);
+      }
+    }
+    // History-restored downloads can lack an end time.
+    const base::Time time = complete && !item->GetEndTime().is_null()
+                                ? item->GetEndTime()
+                                : item->GetStartTime();
+    result.push_back({item->GetId(),
+                      item->GetFileNameToReportUser().LossyDisplayName(),
+                      std::move(detail), complete, time, std::move(icon)});
+  }
+  return result;
 }
 
