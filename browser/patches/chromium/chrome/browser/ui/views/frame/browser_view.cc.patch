+  if (content::DownloadManager* manager =
+          browser_->GetProfile()->GetDownloadManager()) {
+    // The watcher and its timer die with this view.
+    myarc_download_watcher_ = std::make_unique<MyarcDownloadWatcher>(
+        manager,
+        base::BindRepeating(
+            [](BrowserView* view) {
+              if (view->myarc_workspace_sidebar_) {
+                view->myarc_workspace_sidebar_->RefreshLibraryDownloads();
+              }
+            },
+            base::Unretained(this)));
+  }
