+myarc::SidebarView::ItemPresentation BrowserView::GetItemPresentation(
+    const myarc::foundation::ItemRecord& item) const {
+  myarc::SidebarView::ItemPresentation result;
+  if (auto metadata = myarc_workspace_adapter_->Metadata(item.id)) {
+    result.title = metadata->title;
+    result.icon = ui::ImageModel::FromImage(metadata->icon);
+    if (metadata->loading) {
+      if (result.title.empty() && !item.title.empty()) {
+        result.title = base::UTF8ToUTF16(std::string(item.title));
+      }
+      if (result.title.empty() && item.has_url) {
+        result.title = base::UTF8ToUTF16(
+            std::string(myarc::foundation::url_label(item.canonical_url)));
+      }
+      result.title += u" (loading)";
+    }
+  }
+  // Dormant and still-loading saved rows use the favicon history cached.
+  if (result.icon.IsEmpty()) {
+    if (gfx::Image icon = myarc_workspace_adapter_->SavedIcon(item);
+        !icon.IsEmpty()) {
+      result.icon = ui::ImageModel::FromImage(icon);
+    }
+  }
+  // Close applies to this window, not another window's live projection.
+  result.is_live =
+      myarc_workspace_live_items_.contains(base::NumberToString(item.id));
+  return result;
+}
+
+void BrowserView::MyarcWorkspaceResult(
+    myarc::foundation::MutationResult result) {
+  myarc_workspace_action_error_ =
+      result.ok ? std::u16string()
+                : base::UTF8ToUTF16(std::string(result.error));
+  // Adapter posts native-selection refresh. Avoid rebuilding row controls or
+  // cancelling menus synchronously inside their own callbacks.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&BrowserView::RefreshMyarcWorkspaceSidebar,
+                                myarc_workspace_weak_factory_.GetWeakPtr()));
+}
+
+void BrowserView::RetryWorkspaceStorage(
+    myarc::SidebarView::StorageRetry retry) {
+  // Let the pressed button unwind before service notifications rebuild rows.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserView> view,
+             myarc::SidebarView::StorageRetry retry) {
+            if (!view || !view->myarc_workspace_adapter_ ||
+                !view->myarc_workspace_sidebar_) {
+              return;
+            }
+            auto& adapter = *view->myarc_workspace_adapter_;
+            auto& service = adapter.service();
+            using Storage = myarc::WorkspaceService::StorageState;
+            using Retry = myarc::SidebarView::StorageRetry;
+            if (retry == Retry::kLoad &&
+                service.storage_state() == Storage::kLoadError) {
+              service.RetryLoad();
+            } else if (retry == Retry::kSave && adapter.ready() &&
+                       service.storage_state() == Storage::kWriteError) {
+              service.RetrySave();
+            }
+          },
+          myarc_workspace_weak_factory_.GetWeakPtr(), retry));
+}
