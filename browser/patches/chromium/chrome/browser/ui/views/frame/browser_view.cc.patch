+// Paints a single device-pixel line across its contents bounds.
+class MyarcPaletteHairline : public views::View {
+  METADATA_HEADER(MyarcPaletteHairline, views::View)
+
+ public:
+  void SetColor(SkColor color) {
+    color_ = color;
+    SchedulePaint();
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    const float dsf = canvas->UndoDeviceScaleFactor();
+    const gfx::Rect bounds = GetContentsBounds();
+    const int x = std::ceil(bounds.x() * dsf);
+    canvas->FillRect(gfx::Rect(x, std::floor(bounds.y() * dsf),
+                               std::floor(bounds.right() * dsf) - x, 1),
+                     color_);
+  }
+
+ private:
+  SkColor color_ = SK_ColorTRANSPARENT;
+};
