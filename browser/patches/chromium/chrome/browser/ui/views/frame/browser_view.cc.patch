+std::optional<BrowserWindow::MyarcTabSaveState>
+BrowserView::GetMyarcTabSaveState(const std::vector<int>& indices) const {
+  if (!myarc_workspace_adapter_) {
+    return std::nullopt;
+  }
+  MyarcTabSaveState result;
+  result.label = u"Workspace save unavailable";
+  if (!myarc_workspace_adapter_->ready() || IsMyarcWorkspaceBlank() ||
+      indices.empty()) {
+    return result;
+  }
+  const auto model = myarc_workspace_adapter_->Sidebar();
+  if (!model.ok) {
+    return result;
+  }
+  bool all_saved = true;
+  bool all_favorites = true;
+  bool all_pins = true;
+  auto* tabs = browser_->GetTabStripModel();
+  for (int index : indices) {
+    if (!tabs->ContainsIndex(index)) {
+      return result;
+    }
+    const auto id = myarc::BrowserWorkspaceAdapter::ItemIdForContents(
+        *tabs->GetWebContentsAt(index));
+    const auto contains = [id](const auto& rows) {
+      return std::ranges::any_of(
+          rows, [id](const auto& row) { return row.id == id; });
+    };
+    const bool favorite = contains(model.favorites);
+    const bool pin = contains(model.pins);
+    if (!favorite && !pin && !contains(model.temporary)) {
+      return result;
+    }
+    all_saved &= favorite || pin;
+    all_favorites &= favorite;
+    all_pins &= pin;
+  }
+  result.enabled = true;
+  result.save = !all_saved;
+  result.label = result.save     ? u"Add to Profile Favorites"
+                 : all_favorites ? u"Remove from Profile Favorites"
+                 : all_pins      ? u"Remove Space Pins"
+                                 : u"Remove saved items";
+  return result;
+}
+
+bool BrowserView::SetMyarcTabsSaved(const std::vector<int>& indices,
+                                    bool saved) {
+  const auto state = GetMyarcTabSaveState(indices);
+  if (!state) {
+    return false;
+  }
+  if (!state->enabled) {
+    myarc_workspace_action_error_ =
+        u"Workspace save unavailable. Select a live page in this Space.";
+    RefreshMyarcWorkspaceSidebar();
+    return true;
+  }
+  // Resolve before mutations: Favorite can reorder native pinned tabs, and a
+  // stable item may have multiple native projections in the selection.
+  const auto model = myarc_workspace_adapter_->Sidebar();
+  if (!model.ok) {
+    myarc_workspace_action_error_ = u"Workspace save unavailable. Try again.";
+    RefreshMyarcWorkspaceSidebar();
+    return true;
+  }
+  std::set<uint64_t> ids;
+  for (int index : indices) {
+    const auto id = myarc::BrowserWorkspaceAdapter::ItemIdForContents(
+        *browser_->GetTabStripModel()->GetWebContentsAt(index));
+    const auto contains = [id](const auto& rows) {
+      return std::ranges::any_of(
+          rows, [id](const auto& row) { return row.id == id; });
+    };
+    if (saved ? contains(model.temporary)
+              : contains(model.favorites) || contains(model.pins)) {
+      ids.insert(id);
+    }
+  }
+  for (uint64_t id : ids) {
+    auto result = saved ? myarc_workspace_adapter_->Favorite(id)
+                        : myarc_workspace_adapter_->Unsave(id);
+    if (!result.ok) {
+      MyarcWorkspaceResult(std::move(result));
+      return true;
+    }
+  }
+  myarc_workspace_action_error_.clear();
+  RefreshMyarcWorkspaceSidebar();
+  return true;
+}
+
+void BrowserView::RefreshMyarcWorkspaceSidebar() {
+  if (!myarc_workspace_adapter_) {
+    return;
+  }
+  if (!myarc_workspace_sidebar_ || !vertical_tab_strip_region_view_) {
+    UpdateMyarcWorkspaceCanvas();
+    return;
+  }
+  auto model = myarc_workspace_adapter_->Sidebar();
+  const bool ready = myarc_workspace_adapter_->ready() && model.ok;
+  // Snapshot local native bindings once per render. Metadata is Profile-wide.
+  myarc_workspace_live_items_.clear();
+  if (ready) {
+    auto* tabs = browser_->GetTabStripModel();
+    for (int i = 0; i < tabs->count(); ++i) {
+      const auto data = myarc::BrowserWorkspaceAdapter::TabExtraData(
+          *tabs->GetWebContentsAt(i));
+      auto binding = data.find(myarc::BrowserWorkspaceAdapter::kItemKey);
+      if (binding != data.end()) {
+        myarc_workspace_live_items_.insert(binding->second);
+      }
+    }
+  }
+  using Storage = myarc::WorkspaceService::StorageState;
+  using Retry = myarc::SidebarView::StorageRetry;
+  auto& service = myarc_workspace_adapter_->service();
+  vertical_tab_strip_region_view_->SetMyarcWorkspaceReady(ready);
+  if (!ready) {
+    const std::u16string reason =
+        u"Workspace unavailable. Native tabs remain available. " +
+        base::UTF8ToUTF16(service.storage_state() == Storage::kLoadError
+                              ? service.storage_error()
+                              : myarc_workspace_adapter_->error());
+    myarc_workspace_sidebar_->SetUnavailable(
+        reason, service.storage_state() == Storage::kLoadError ? Retry::kLoad
+                                                               : Retry::kNone);
+  } else {
+    std::u16string status = myarc_workspace_action_error_;
+    const auto append = [&status](const std::u16string& message) {
+      if (!message.empty()) {
+        if (!status.empty()) {
+          status += u"\n";
+        }
+        status += message;
+      }
+    };
+    append(base::UTF8ToUTF16(myarc_workspace_adapter_->error()));
+    append(base::UTF8ToUTF16(myarc_workspace_adapter_->binding_warning()));
+    switch (service.storage_state()) {
+      case Storage::kLoading:
+        append(u"Loading workspace metadata.");
+        break;
+      case Storage::kLoadError:
+      case Storage::kWriteError:
+        append(u"Workspace storage error: " +
+               base::UTF8ToUTF16(service.storage_error()));
+        break;
+      case Storage::kWritePending:
+        append(u"Workspace changes pending storage write.");
+        break;
+      case Storage::kEphemeral:
+        append(u"Private workspace. Changes stay in memory.");
+        break;
+      case Storage::kReady:
+      case Storage::kWritten:
+        // A completed atomic write is not an OS-crash durability guarantee.
+        break;
+    }
+    myarc_workspace_sidebar_->SetModel(
+        model, status,
+        service.storage_state() == Storage::kWriteError ? Retry::kSave
+                                                        : Retry::kNone);
+  }
+  UpdateMyarcWorkspaceCanvas();
+}
