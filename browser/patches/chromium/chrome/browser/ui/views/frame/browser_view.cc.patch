+void BrowserView::ClearArchive() {
+  if (!myarc_workspace_adapter_ || !myarc_workspace_adapter_->ready() ||
+      myarc_workspace_adapter_->service().ArchivedTabs().empty()) {
+    return;
+  }
+  chrome::ShowBrowserModal(
+      browser(),
+      ui::DialogModel::Builder()
+          .SetTitle(u"Clear Archive?")
+          .AddParagraph(ui::DialogModelLabel(
+              u"All archived tabs in this Profile will be removed. You can\u2019t "
+              u"undo this."))
+          .AddOkButton(
+              base::BindOnce(
+                  [](base::WeakPtr<BrowserView> view) {
+                    if (view && view->myarc_workspace_adapter_) {
+                      view->MyarcWorkspaceResult(
+                          view->myarc_workspace_adapter_->service()
+                              .ClearArchivedTabs());
+                    }
+                  },
+                  myarc_workspace_weak_factory_.GetWeakPtr()),
+              ui::DialogModel::Button::Params().SetLabel(u"Clear Archive"))
+          .AddCancelButton(base::DoNothing())
+          .OverrideDefaultButton(ui::mojom::DialogButton::kCancel)
+          .Build());
+}
