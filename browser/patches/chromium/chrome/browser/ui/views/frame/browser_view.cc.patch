+std::vector<myarc::SidebarView::ArchivedTabPresentation>
+BrowserView::GetArchivedTabs() const {
+  std::vector<myarc::SidebarView::ArchivedTabPresentation> result;
+  if (!myarc_workspace_adapter_ || !myarc_workspace_adapter_->ready()) {
+    return result;
+  }
+  const auto sidebar = myarc_workspace_adapter_->Sidebar();
+  const auto tabs = myarc_workspace_adapter_->service().ArchivedTabs();
+  // Only the showing Library asks, so archive favicons load on demand.
+  myarc_workspace_adapter_->RequestArchivedIcons(tabs);
+  for (const auto& tab : tabs) {
+    const GURL url(std::string(tab.url));
+    myarc::SidebarView::ArchivedTabPresentation row;
+    row.id = tab.id;
+    // Arc's address line: no scheme, "www." or trailing slash.
+    row.url = url_formatter::FormatUrl(
+        url,
+        url_formatter::kFormatUrlOmitDefaults |
+            url_formatter::kFormatUrlOmitHTTPS |
+            url_formatter::kFormatUrlOmitTrivialSubdomains,
+        base::UnescapeRule::SPACES, nullptr, nullptr, nullptr);
+    row.title =
+        tab.title.empty() ? row.url : base::UTF8ToUTF16(std::string(tab.title));
+    for (const auto& space : sidebar.spaces) {
+      if (space.id == tab.space_id) {
+        row.space = base::UTF8ToUTF16(std::string(space.name));
+      }
+    }
+    if (gfx::Image icon = myarc_workspace_adapter_->CachedIcon(
+            std::string_view(tab.url.data(), tab.url.size()));
+        !icon.IsEmpty()) {
+      row.icon = ui::ImageModel::FromImage(icon);
+    }
+    row.archived =
+        base::Time::UnixEpoch() +
+        base::Seconds(base::saturated_cast<int64_t>(tab.archived_secs));
+    result.push_back(std::move(row));
+  }
+  return result;
+}
