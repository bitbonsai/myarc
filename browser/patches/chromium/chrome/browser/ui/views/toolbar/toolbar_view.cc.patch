+void ToolbarView::SetMyarcSidebarToggle(std::unique_ptr<views::View> toggle) {
+  CHECK(back_ && forward_ && reload_ && location_bar_view_)
+      << "myarc-visual-parity requires --disable-features=InitialWebUI";
+  CHECK(!myarc_sidebar_toggle_);
+  myarc_sidebar_toggle_ = AddChildView(std::move(toggle));
+  for (ToolbarButton* button : std::array<ToolbarButton*, 3>{
+           back_.get(), forward_.get(), reload_.get()}) {
+    button->SetLayoutInsets(gfx::Insets());
+  }
+}
+
+std::unique_ptr<views::View> ToolbarView::TakeMyarcSidebarToggle() {
+  auto* toggle = myarc_sidebar_toggle_.get();
+  myarc_sidebar_toggle_ = nullptr;
+  auto owned = RemoveChildViewT(toggle);
+  for (ToolbarButton* button : std::array<ToolbarButton*, 3>{
+           back_.get(), forward_.get(), reload_.get()}) {
+    button->SetLayoutInsets(std::nullopt);
+  }
+  if (background()) {
+    if (auto* corners = background()->AsA<CustomCornersBackground>()) {
+      corners->SetVisible(true);
+    }
+  }
+  InvalidateLayout();
+  return owned;
+}
