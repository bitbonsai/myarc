+constexpr gfx::VectorIconRep kMyarcReloadRep[] = {{kMyarcReloadPath}};
+constexpr gfx::VectorIcon kMyarcReloadIcon(kMyarcReloadRep,
+                                           std::size(kMyarcReloadRep),
+                                           "myarc_reload");
+
+const gfx::VectorIcon& ReloadIcon(const gfx::VectorIcon& chrome_icon) {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+             "myarc-visual-parity")
+             ? kMyarcReloadIcon
+             : chrome_icon;
