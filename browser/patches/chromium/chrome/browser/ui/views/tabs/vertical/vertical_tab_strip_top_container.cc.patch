+void VerticalTabStripTopContainer::SetMyarcSidebarToolbar(
+    std::unique_ptr<views::View> toolbar) {
+  CHECK(!myarc_sidebar_toolbar_);
+  myarc_sidebar_toolbar_ = AddChildView(std::move(toolbar));
+  InvalidateLayout();
+}
+
+std::unique_ptr<views::View>
+VerticalTabStripTopContainer::TakeMyarcSidebarToolbar() {
+  auto* toolbar = myarc_sidebar_toolbar_.get();
+  myarc_sidebar_toolbar_ = nullptr;
+  return RemoveChildViewT(toolbar);
