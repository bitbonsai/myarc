+bool LocationBarView::IsMyarcUrlPill() const {
+  if (!myarc_copy_url_button_ || !browser_) {
+    return false;
+  }
+  const auto* controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  return controller && controller->ShouldDisplayVerticalTabs();
+}
+
+void LocationBarView::CopyMyarcCurrentUrl() {
+  WebContents* const page = GetWebContents();
+  if (IsMyarcUrlPill() && page && !page->GetVisibleURL().is_empty() &&
+      !page->GetController().GetVisibleEntry()->IsInitialEntry() &&
+      chrome::CanCopyUrl(browser_)) {
+    chrome::CopyURL(browser_, page);
+  }
+}
+
+void LocationBarView::OnMouseEntered(const ui::MouseEvent& event) {
+  if (IsMyarcUrlPill()) {
+    myarc_url_hovered_ = true;
+    InvalidateLayout();
+    OnOmniboxHovered(true);
+  }
+  View::OnMouseEntered(event);
+}
+
 void LocationBarView::OnMouseMoved(const ui::MouseEvent& event) {
