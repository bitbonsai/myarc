+class RecoveryLifecycleProbe : public myarc::WorkspaceLifecycle {
+ public:
+  explicit RecoveryLifecycleProbe(Profile* profile)
+      : WorkspaceLifecycle(profile), profile_(profile) {}
+
+  bool restore_started = false;
+  bool choice_finished = false;
+  bool restore_started_before_choice_finished = false;
+
+  void OnLifecycleEvent(Event event) override {
+    if (event == Event::kSessionRestoreStarted) {
+      restore_started = true;
+      restore_started_before_choice_finished =
+          !choice_finished && HasPendingSessionRestore(profile_);
+    } else if (event == Event::kRecoveryChoiceFinished) {
+      choice_finished = true;
+    }
+  }
+  void RestoreTab(BrowserWindowInterface&,
+                  content::WebContents&,
+                  const ExtraData&) override {}
+  void RestoreWindow(BrowserWindowInterface&, const ExtraData&) override {}
+  ExtraData TabData(BrowserWindowInterface&, content::WebContents&) override {
+    return {};
+  }
+  ExtraData WindowData(BrowserWindowInterface&) override { return {}; }
+
+ private:
+  const raw_ptr<Profile> profile_;
+};
+
