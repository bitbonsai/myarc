+
+namespace {
+
+void ApplyMyarcGlassToBubbleWidget(views::Widget* widget) {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "myarc-visual-parity") ||
+      !widget || widget->IsClosed()) {
+    return;
+  }
+  views::NonClientView* non_client = widget->non_client_view();
+  if (!non_client ||
+      !views::AsViewClass<views::BubbleFrameView>(non_client->frame_view())) {
+    return;
+  }
+  const views::WidgetDelegate* delegate = widget->widget_delegate();
+  const bool is_modal =
+      delegate && delegate->GetModalType() != ui::mojom::ModalType::kNone;
+  const ui::ColorProvider* provider = widget->GetColorProvider();
+  const ui::ColorId bg_id =
+      is_modal ? ui::kColorDialogBackground : ui::kColorBubbleBackground;
+  const SkColor opaque_fill =
+      provider ? provider->GetColor(bg_id) : SkColorSetRGB(0x25, 0x25, 0x28);
+  const bool dark = !provider || color_utils::IsDark(opaque_fill);
+  const SkColor glass_tint = dark ? SkColorSetARGB(0xA1, 0x18, 0x18, 0x1D)
+                                  : SkColorSetARGB(0xD4, 0xFA, 0xFA, 0xFD);
+  myarc::ApplyBubbleGlass(*widget,
+                          is_modal ? myarc::GlassMaterial::kSheet
+                                   : myarc::GlassMaterial::kPopover,
+                          dark, glass_tint, opaque_fill);
+}
+
+}  // namespace
+
+void ChromeViewsDelegate::InitMyarcBubbleGlass() {
+  myarc_bubble_glass_observer_ =
+      std::make_unique<views::AnyWidgetObserver>(views::AnyWidgetPasskey{});
+  myarc_bubble_glass_observer_->set_shown_callback(
+      base::BindRepeating(&ApplyMyarcGlassToBubbleWidget));
+}
 
 ui::ContextFactory* ChromeViewsDelegate::GetContextFactory() {
   return content::GetContextFactory();
