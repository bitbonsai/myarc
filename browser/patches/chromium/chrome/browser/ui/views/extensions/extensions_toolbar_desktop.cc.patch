+void ExtensionsToolbarDesktop::SetMyarcSidebarMode(bool enabled) {
+  if (myarc_sidebar_mode_ == enabled) {
+    return;
+  }
+  myarc_sidebar_mode_ = enabled;
+  myarc_revealed_ = false;
+  // The pill shows pinned icons only, as Arc's does, with no container ring.
+  SetHighlightBorderEnabled(!enabled);
+  extensions_button_->SetVisible(!enabled);
+  GetTargetLayoutManager()->SetCrossAxisAlignment(
+      enabled ? views::LayoutAlignment::kCenter
+              : views::LayoutAlignment::kStretch);
+  UpdateAllIcons();
+  UpdateContainerVisibility();
+  GetAnimatingLayoutManager()->ResetLayout();
+  PreferredSizeChanged();
+}
+
+void ExtensionsToolbarDesktop::SetMyarcRevealed(bool revealed) {
+  if (myarc_revealed_ != revealed) {
+    myarc_revealed_ = revealed;
+    UpdateContainerVisibility();
+  }
+}
