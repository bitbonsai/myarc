+void ExtensionsToolbarDesktop::ConfigureMyarcSidebarAction(
+    ToolbarActionView* icon) {
+  views::InkDrop::Get(icon)->SetMode(views::InkDropHost::InkDropMode::OFF);
+  icon->SetShowInkDropWhenHotTracked(false);
+  // FooterTooltip replaces the Chromium hover card and native tooltip.
+  icon->SetTooltipText(std::u16string());
+}
+
+void ExtensionsToolbarDesktop::RestoreDefaultActionChrome(
+    ToolbarActionView* icon) {
+  ConfigureInkDrop(icon);
+  icon->SetShowInkDropWhenHotTracked(true);
+  icon->UpdateState();
+}
+
+void ExtensionsToolbarDesktop::SetMyarcSidebarMode(bool enabled) {
+  if (myarc_sidebar_mode_ == enabled) {
+    return;
+  }
+  myarc_sidebar_mode_ = enabled;
+  myarc_revealed_ = false;
+  // The pill shows pinned icons only, as Arc's does, with no container ring.
+  SetHighlightBorderEnabled(!enabled);
+  extensions_button_->SetVisible(!enabled);
+  GetTargetLayoutManager()->SetCrossAxisAlignment(
+      enabled ? views::LayoutAlignment::kCenter
+              : views::LayoutAlignment::kStretch);
+  if (enabled) {
+    myarc_tooltip_ = std::make_unique<myarc::FooterTooltip>();
+  } else {
+    myarc_hovered_action_ = nullptr;
+    myarc_hovered_label_.clear();
+    if (myarc_tooltip_) {
+      myarc_tooltip_->Hide();
+      myarc_tooltip_.reset();
+    }
+  }
+  UpdateAllIcons();
+  // After UpdateState, which may set a native tooltip when the access-control
+  // hover card is off.
+  for (auto& [id, icon] : icons_) {
+    if (enabled) {
+      ConfigureMyarcSidebarAction(icon);
+    } else {
+      RestoreDefaultActionChrome(icon);
+    }
+  }
+  UpdateContainerVisibility();
+  GetAnimatingLayoutManager()->ResetLayout();
+  PreferredSizeChanged();
+}
+
+void ExtensionsToolbarDesktop::SetMyarcRevealed(bool revealed) {
+  if (myarc_revealed_ != revealed) {
+    myarc_revealed_ = revealed;
+    UpdateContainerVisibility();
+  }
+}
