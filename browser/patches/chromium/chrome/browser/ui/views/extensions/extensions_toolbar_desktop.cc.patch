+
 void ExtensionsToolbarDesktop::UpdateHoverCard(
     ToolbarActionView* action_view,
     ToolbarActionHoverCardUpdateType update_type) {
+  if (myarc_sidebar_mode_) {
+    if (!myarc_tooltip_) {
+      return;
+    }
+    if (!action_view) {
+      myarc_hovered_action_ = nullptr;
+      myarc_hovered_label_.clear();
+      if (update_type == ToolbarActionHoverCardUpdateType::kEvent) {
+        myarc_tooltip_->Press(display::Screen::Get()->GetCursorScreenPoint());
+      } else {
+        myarc_tooltip_->Hide();
+      }
+      return;
+    }
+    const std::u16string label = action_view->view_model()->GetActionName();
+    if (myarc_hovered_action_ == action_view && myarc_hovered_label_ == label) {
+      return;
+    }
+    myarc_hovered_action_ = action_view;
+    myarc_hovered_label_ = label;
+    // Extension name only; Arc's pill tooltips stay short.
+    myarc_tooltip_->Hover(*action_view, {.label = label, .beside = true});
+    return;
+  }
   action_hover_card_controller_->UpdateHoverCard(action_view, update_type);
 }
 
