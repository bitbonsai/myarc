+bool NavigateFromMyarcPalette(BrowserWindowInterface* browser,
+                              std::u16string_view text,
+                              bool new_tab) {
+  if (text.empty() || text.size() > 4096) {
+    return false;
+  }
+  auto* classifier =
+      AutocompleteClassifierFactory::GetForProfile(browser->GetProfile());
+  if (!classifier) {
+    return false;
+  }
+  AutocompleteMatch match;
+  classifier->Classify(std::u16string(text), false, false,
+                       metrics::OmniboxEventProto::BLANK, &match, nullptr);
+  const GURL& url = match.destination_url;
+  if (!url.is_valid() || !(url.SchemeIsHTTPOrHTTPS() ||
+                           url.SchemeIs("chrome") || url.IsAboutBlank())) {
+    return false;
+  }
+#if BUILDFLAG(ENABLE_EXTENSIONS) && (BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC))
+  // This prototype has no consent continuation. Keep required search consent
+  // in the native omnibox instead of navigating without it.
+  if (auto* controller =
+          DefaultSearchExtensionControlledController::From(browser);
+      controller && controller->ShouldRequestConfirmationForExtensionDse(url)) {
+    return false;
+  }
+#endif
+  new_tab |= IsMyarcWorkspaceBlank(browser);
+  if (!new_tab) {
+    if (!browser->GetTabStripModel()->GetActiveWebContents()) {
+      return false;
+    }
+    NavigateParams params(browser, url, ui::PAGE_TRANSITION_TYPED);
+    params.disposition = WindowOpenDisposition::kCurrentTab;
+    Navigate(&params);
+    return true;
+  }
+  return AddAndReturnTabAt(browser, url, -1, true, std::nullopt, false,
+                           NavigateParams::WindowAction::kShowWindow) !=
+         nullptr;
+}
