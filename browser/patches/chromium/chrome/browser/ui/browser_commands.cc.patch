+bool IsMyarcWorkspaceCommandAllowed(const BrowserWindowInterface* browser,
+                                    int command) {
+  // These operations use the entire native strip, including other Spaces.
+  // Keep native fallback available until the Rust projection is ready.
+  switch (command) {
+    case IDC_MOVE_TAB_NEXT:
+    case IDC_MOVE_TAB_PREVIOUS:
+    case IDC_MOVE_TAB_TO_NEW_WINDOW:
+    case IDC_WINDOW_CLOSE_OTHER_TABS:
+    case IDC_WINDOW_CLOSE_TABS_TO_RIGHT:
+    case IDC_BOOKMARK_ALL_TABS:
+    case IDC_GROUP_UNGROUPED_TABS:
+    case IDC_WINDOW_GROUP_TAB:
+    case IDC_GROUP_TARGET_TAB:
+    case IDC_ADD_NEW_TAB_TO_GROUP:
+    case IDC_CREATE_NEW_TAB_GROUP:
+    case IDC_CLOSE_TAB_GROUP:
+    case IDC_ADD_NEW_TAB_RECENT_GROUP: {
+      const auto* window =
+          browser ? BrowserWindow::FromBrowser(browser) : nullptr;
+      if (window && window->IsMyarcWorkspaceActive()) {
+        return false;
+      }
+      break;
+    }
+  }
+  return !IsMyarcPageCommand(command) || !IsMyarcWorkspaceBlank(browser);
+}
