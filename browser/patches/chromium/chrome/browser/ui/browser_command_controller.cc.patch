+// All native update sites, including asynchronous loading/policy updates, pass
+// through this existing updater interface. Keep native eligibility for replay
+// when Space selection changes without a native active-index notification.
+template <typename NativeUpdater>
+class MyarcCommandUpdater final : public NativeUpdater {
+ public:
+  template <typename Delegate>
+  MyarcCommandUpdater(BrowserWindowInterface* browser,
+                      base::flat_map<int, bool>* states,
+                      Delegate* delegate)
+      : NativeUpdater(delegate), browser_(browser), states_(states) {}
+
+  bool UpdateCommandEnabled(int id, bool state) override {
+    if (IsMyarcPageCommand(id)) {
+      (*states_)[id] = state;
+      const bool allowed = IsMyarcWorkspaceCommandAllowed(browser_, id);
+      gated_ |= !allowed;
+      state &= allowed;
+      // Legacy updater does not update Actions. Synchronize only after this
+      // opt-in window has gated a command; stock windows stay unchanged.
+      if (gated_) {
+        if (auto action_id = GetActionIdForCommandId(id)) {
+          if (auto* action = FindAction(*action_id, browser_)) {
+            action->SetEnabled(state);
+          }
+        }
+      }
+    }
+    return NativeUpdater::UpdateCommandEnabled(id, state);
+  }
+
+ private:
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<base::flat_map<int, bool>> states_;
+  bool gated_ = false;
+};
+
+// Routes Arc keyboard navigation through the workspace adapter, which reads
+// sidebar and Space order from Rust. Returns false for windows without an
+// adapter and for commands that keep their stock meaning.
+bool ExecuteMyarcWorkspaceCommand(BrowserWindowInterface* browser, int id) {
+  auto* adapter = myarc::BrowserWorkspaceAdapter::ForBrowser(*browser);
+  if (!adapter) {
+    return false;
+  }
+  switch (id) {
+    case IDC_MYARC_TOGGLE_PIN:
+      adapter->TogglePin();
+      return true;
+    case IDC_MYARC_SELECT_SPACE_0:
+    case IDC_MYARC_SELECT_SPACE_1:
+    case IDC_MYARC_SELECT_SPACE_2:
+    case IDC_MYARC_SELECT_SPACE_3:
+    case IDC_MYARC_SELECT_SPACE_4:
+    case IDC_MYARC_SELECT_SPACE_5:
+    case IDC_MYARC_SELECT_SPACE_6:
+    case IDC_MYARC_SELECT_SPACE_7:
+      adapter->SelectSpaceAt(id - IDC_MYARC_SELECT_SPACE_0);
+      return true;
+    case IDC_MYARC_SELECT_LAST_SPACE:
+      adapter->SelectSpaceAt(-1);
+      return true;
+    case IDC_MYARC_SELECT_NEXT_SPACE:
+      adapter->StepSpace(1);
+      return true;
+    case IDC_MYARC_SELECT_PREVIOUS_SPACE:
+      adapter->StepSpace(-1);
+      return true;
+    // Hidden tabs from other Spaces stay in the native strip, so numbered and
+    // next/previous tab commands follow the sidebar instead.
+    case IDC_SELECT_TAB_0:
+    case IDC_SELECT_TAB_1:
+    case IDC_SELECT_TAB_2:
+    case IDC_SELECT_TAB_3:
+    case IDC_SELECT_TAB_4:
+    case IDC_SELECT_TAB_5:
+    case IDC_SELECT_TAB_6:
+    case IDC_SELECT_TAB_7:
+      adapter->ActivateSidebarItemAt(id - IDC_SELECT_TAB_0);
+      return true;
+    case IDC_SELECT_LAST_TAB:
+      adapter->ActivateSidebarItemAt(-1);
+      return true;
+    case IDC_SELECT_NEXT_TAB:
+      adapter->StepSidebarItem(1);
+      return true;
+    case IDC_SELECT_PREVIOUS_TAB:
+      adapter->StepSidebarItem(-1);
+      return true;
+    default:
+      return false;
+  }
+}
