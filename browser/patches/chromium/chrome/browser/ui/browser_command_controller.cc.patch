+// Routes Arc keyboard navigation through the workspace adapter, which reads
+// sidebar and Space order from Rust. Returns false for windows without an
+// adapter and for commands that keep their stock meaning.
+bool ExecuteMyarcWorkspaceCommand(BrowserWindowInterface* browser, int id) {
+  // An open Peek takes Cmd+W and Cmd+O, so the tab beneath stays.
+  if (auto* peek = myarc::PeekController::ForBrowser(*browser);
+      peek && peek->HandleCommand(id)) {
+    return true;
+  }
+  // Ctrl-Option-Cmd-A replays the welcome's arrival, outside the tour.
+  if (id == IDC_MYARC_REPLAY_INTRO) {
+    if (BrowserView* view = BrowserView::GetBrowserViewForBrowser(browser)) {
+      view->PlayMyarcIntro();
+    }
+    return true;
+  }
+  // Option-Cmd-N, as in Arc's View menu.
+  if (id == IDC_MYARC_NEW_LITTLE_ARC) {
+    myarc::OpenLittleArc(*browser->GetProfile(), GURL());
+    return true;
+  }
+  // Cmd+O in a Little Arc is its "Open in" button: the page moves into a
+  // Space and the window closes.
+  if (id == IDC_OPEN_FILE && myarc::IsLittleArc(*browser)) {
+    myarc::MoveLittleArcToSpace(*browser);
+    return true;
+  }
+  // Option-Cmd-O picks the Space first.
+  if (id == IDC_MYARC_LITTLE_ARC_PICK_SPACE) {
+    myarc::ShowLittleArcSpacePicker(*browser);
+    return true;
+  }
+  // Profile-wide Boosts kill switch.
+  if (id == IDC_MYARC_TOGGLE_BOOSTS) {
+    myarc::BoostsService::ForProfile(*browser->GetProfile())
+        .ToggleGlobalEnabled();
+    return true;
+  }
+  auto* adapter = myarc::BrowserWorkspaceAdapter::ForBrowser(*browser);
+  if (!adapter) {
+    return false;
+  }
+  switch (id) {
+    case IDC_MYARC_TOGGLE_PIN:
+      adapter->TogglePin();
+      return true;
+    case IDC_MYARC_SELECT_SPACE_0:
+    case IDC_MYARC_SELECT_SPACE_1:
+    case IDC_MYARC_SELECT_SPACE_2:
+    case IDC_MYARC_SELECT_SPACE_3:
+    case IDC_MYARC_SELECT_SPACE_4:
+    case IDC_MYARC_SELECT_SPACE_5:
+    case IDC_MYARC_SELECT_SPACE_6:
+    case IDC_MYARC_SELECT_SPACE_7:
+      adapter->SelectSpaceAt(id - IDC_MYARC_SELECT_SPACE_0);
+      return true;
+    case IDC_MYARC_SELECT_LAST_SPACE:
+      adapter->SelectSpaceAt(-1);
+      return true;
+    case IDC_MYARC_SELECT_NEXT_SPACE:
+      adapter->StepSpace(1);
+      return true;
+    case IDC_MYARC_SELECT_PREVIOUS_SPACE:
+      adapter->StepSpace(-1);
+      return true;
+    case IDC_MYARC_SEPARATE_SPLIT:
+      if (auto* page = browser->GetTabStripModel()->GetActiveWebContents()) {
+        adapter->SeparateSplit(
+            myarc::BrowserWorkspaceAdapter::ItemIdForContents(*page));
+      }
+      return true;
+    case IDC_MYARC_FOCUS_SPLIT_PANE_0:
+    case IDC_MYARC_FOCUS_SPLIT_PANE_1:
+      adapter->FocusSplitPane(id - IDC_MYARC_FOCUS_SPLIT_PANE_0);
+      return true;
+    // Arc's View menu extras.
+    case IDC_MYARC_CLEAR_COOKIES_RELOAD:
+    case IDC_MYARC_CLEAR_CACHE_RELOAD:
+      adapter->ClearSiteDataAndReload(id == IDC_MYARC_CLEAR_COOKIES_RELOAD);
+      return true;
+    case IDC_MYARC_TOGGLE_PINS_COLLAPSED:
+      adapter->TogglePinsCollapsed();
+      return true;
+    case IDC_MYARC_EXPAND_SPLIT:
+      adapter->ExpandCurrentSplit();
+      return true;
+    // Hidden tabs from other Spaces stay in the native strip, so numbered and
+    // next/previous tab commands follow the sidebar instead.
+    case IDC_SELECT_TAB_0:
+    case IDC_SELECT_TAB_1:
+    case IDC_SELECT_TAB_2:
+    case IDC_SELECT_TAB_3:
+    case IDC_SELECT_TAB_4:
+    case IDC_SELECT_TAB_5:
+    case IDC_SELECT_TAB_6:
+    case IDC_SELECT_TAB_7:
+      adapter->ActivateSidebarItemAt(id - IDC_SELECT_TAB_0);
+      return true;
+    case IDC_SELECT_LAST_TAB:
+      adapter->ActivateSidebarItemAt(-1);
+      return true;
+    case IDC_SELECT_NEXT_TAB:
+      adapter->StepSidebarItem(1);
+      return true;
+    case IDC_SELECT_PREVIOUS_TAB:
+      adapter->StepSidebarItem(-1);
+      return true;
+    // Arc's Ctrl+Tab walks the recently shown rows of the Space, further
+    // back for each press while Ctrl stays down.
+    case IDC_CYCLE_TO_NEXT_TAB:
+      adapter->CycleRecentTab(1, /*watch_release=*/true);
+      return true;
+    case IDC_CYCLE_TO_PREV_TAB:
+      adapter->CycleRecentTab(-1, /*watch_release=*/true);
+      return true;
+    default:
+      return false;
+  }
+}
