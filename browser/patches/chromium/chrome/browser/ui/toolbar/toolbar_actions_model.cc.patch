diff --git a/chrome/browser/ui/toolbar/toolbar_actions_model.cc b/chrome/browser/ui/toolbar/toolbar_actions_model.cc
index f35b42be33952f9d4b01728c82ce064830bda1e4..01a5e16d5af098beaa0f23858d2f79a4852cb5e0 100644
--- a/chrome/browser/ui/toolbar/toolbar_actions_model.cc
+++ b/chrome/browser/ui/toolbar/toolbar_actions_model.cc
@@ -47,6 +47,7 @@
 #include "extensions/common/manifest.h"
 #include "extensions/common/manifest_constants.h"
 #include "extensions/common/permissions/permissions_data.h"
+#include "myarc/blocker.h"
 
 #if !BUILDFLAG(IS_ANDROID)
 #include "chrome/browser/ui/web_applications/app_browser_controller.h"
@@ -142,7 +143,11 @@ void ToolbarActionsModel::OnExtensionInstalled(
   const bool is_installed_from_sync =
       sync_service && sync_service->IsPendingSyncInstall(extension->id());
 
-  const bool is_installed_by_default = extension->was_installed_by_default();
+  // myArc's bundled blocker already has its own switch in the Site Info
+  // popover, so leave it unpinned on install unless the user pins it manually.
+  const bool is_installed_by_default =
+      extension->was_installed_by_default() ||
+      extension->id() == myarc::kBlockerExtensionId;
 
   bool is_feature_enabled =
       base::FeatureList::IsEnabled(features::kExtensionsPinnedByDefault);
@@ -341,6 +346,17 @@ void ToolbarActionsModel::OnReady() {
   extension_management_observation_.Observe(management);
 
   actions_initialized_ = true;
+
+  // One-time migration for Profiles created before myArc stopped pinning the
+  // bundled blocker by default. Manual pins after this stay respected.
+  if (!profile_->IsOffTheRecord() &&
+      !prefs_->GetBoolean(myarc::kBlockerUnpinnedPref)) {
+    prefs_->SetBoolean(myarc::kBlockerUnpinnedPref, true);
+    if (IsActionPinned(myarc::kBlockerExtensionId)) {
+      SetActionVisibility(myarc::kBlockerExtensionId, false);
+    }
+  }
+
   for (Observer& observer : observers_) {
     observer.OnToolbarModelInitialized();
   }
