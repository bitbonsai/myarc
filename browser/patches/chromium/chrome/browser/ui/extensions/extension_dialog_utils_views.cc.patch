+// Returns whether the dialog can anchor to `container`. A hidden container
+// still works when it reveals itself for a single extension (myArc's URL pill).
+bool CanAnchorDialog(
+    ExtensionsContainerViews* container,
+    const std::vector<extensions::ExtensionId>& extension_ids) {
+  if (!container) {
+    return false;
+  }
+  const bool can_show =
+      container->IsVisible() ||
+      (extension_ids.size() == 1 &&
+       container->CanRevealForExtension(extension_ids[0]));
+  return can_show && !GetDialogAnchor(container, extension_ids).IsNull();
+}
+
 }  // namespace
 
