+IN_PROC_BROWSER_TEST_P(MyarcWorkspaceCommandSafetyTest,
+                       DifferentNativeTabRestoresActionState) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      workspace_browser_, embedded_test_server()->GetURL("/title1.html")));
+  auto* tabs = workspace_browser_->GetTabStripModel();
+  auto* first_page = tabs->GetActiveWebContents();
+  const auto first_space = adapter_->Sidebar().current_space.id;
+  const auto second_space = adapter_->CreateSpace("Second populated Space");
+  ASSERT_TRUE(second_space.ok);
+  ASSERT_TRUE(adapter_->SelectSpace(second_space.id).ok);
+  ASSERT_TRUE(
+      adapter_
+          ->OpenInCurrentSpace(embedded_test_server()->GetURL("/title2.html"))
+          .ok);
+  auto* second_page = tabs->GetActiveWebContents();
+  ASSERT_NE(first_page, second_page);
+  ASSERT_TRUE(content::WaitForLoadStop(second_page));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return adapter_->DisplayedContents() == second_page &&
+           !view_->IsMyarcWorkspaceBlank();
+  }));
+  auto* root = BrowserActions::From(workspace_browser_)->root_action_item();
+  auto* zoom =
+      actions::ActionManager::Get().FindAction(kActionShowZoomBubble, root);
+  auto* lens = actions::ActionManager::Get().FindAction(
+      kActionContentContextLensRegionSearch, root);
+  ASSERT_TRUE(zoom);
+  ASSERT_TRUE(lens);
+  const bool zoom_enabled = zoom->GetEnabled();
+  const bool lens_enabled = lens->GetEnabled();
+  ASSERT_TRUE(zoom_enabled);
+
+  ASSERT_TRUE(adapter_->SelectSpace(first_space).ok);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return adapter_->DisplayedContents() == first_page &&
+           tabs->GetActiveWebContents() == first_page;
+  }));
+  auto* toolbar = view_->toolbar();
+  ASSERT_TRUE(toolbar);
+  auto* location = toolbar->location_bar_view();
+  ASSERT_TRUE(location);
+  auto* omnibox = location->omnibox_view();
+  ASSERT_TRUE(omnibox);
+  auto* reload = toolbar->reload_button();
+  ASSERT_TRUE(reload);
+  view_->GetWidget()->LayoutRootViewIfNecessary();
+  ASSERT_TRUE(location->IsDrawn());
+  ASSERT_TRUE(location->location_icon_view()->IsDrawn());
+  ASSERT_TRUE(reload->IsDrawn());
+  EXPECT_NE(std::u16string::npos, omnibox->GetText().find(u"/title1.html"));
+
+  const auto empty_space = adapter_->CreateSpace("Empty between native tabs");
+  ASSERT_TRUE(empty_space.ok);
+  ASSERT_TRUE(adapter_->SelectSpace(empty_space.id).ok);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return view_->IsMyarcWorkspaceBlank() && !zoom->GetEnabled() &&
+           !lens->GetEnabled();
+  }));
+  ASSERT_EQ(first_page, tabs->GetActiveWebContents());
+  // Real toolbar/loading updates and layout must not re-expose retained P1.
+  view_->UpdateToolbar(first_page);
+  view_->UpdateReloadStopState(true, true);
+  view_->GetWidget()->LayoutRootViewIfNecessary();
+  EXPECT_TRUE(location->IsDrawn());
+  EXPECT_TRUE(omnibox->IsDrawn());
+  EXPECT_TRUE(omnibox->GetText().empty());
+  EXPECT_EQ(nullptr, location->GetWebContents());
+  EXPECT_FALSE(location->ShowPageInfoDialog());
+  EXPECT_FALSE(location->location_icon_view()->IsDrawn());
+  EXPECT_FALSE(view_->toolbar_button_provider()->GetBackButton()->IsDrawn());
+  EXPECT_FALSE(toolbar->forward_button()->IsDrawn());
+  EXPECT_FALSE(reload->IsDrawn());
+  EXPECT_FALSE(reload->GetEnabled());
+  EXPECT_EQ(ReloadControl::Mode::kReload, reload->GetVisibleMode());
+  EXPECT_TRUE(IsCommandEnabled(workspace_browser_, IDC_FOCUS_LOCATION));
+  EXPECT_TRUE(IsCommandEnabled(workspace_browser_, IDC_NEW_TAB));
+
+  // No manual sidebar or command refresh: P1 -> empty -> P2 must notify
+  // Actions.
+  ASSERT_TRUE(adapter_->SelectSpace(second_space.id).ok);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return adapter_->DisplayedContents() == second_page &&
+           tabs->GetActiveWebContents() == second_page &&
+           !view_->IsMyarcWorkspaceBlank() &&
+           zoom->GetEnabled() == zoom_enabled &&
+           lens->GetEnabled() == lens_enabled;
+  }));
+  EXPECT_EQ(second_space.id, adapter_->Sidebar().current_space.id);
+  EXPECT_EQ(zoom_enabled, zoom->GetEnabled());
+  EXPECT_EQ(lens_enabled, lens->GetEnabled());
+  view_->GetWidget()->LayoutRootViewIfNecessary();
+  EXPECT_TRUE(location->IsDrawn());
+  EXPECT_EQ(second_page, location->GetWebContents());
+  EXPECT_NE(std::u16string::npos, omnibox->GetText().find(u"/title2.html"));
+  EXPECT_TRUE(location->location_icon_view()->IsDrawn());
+  EXPECT_TRUE(view_->toolbar_button_provider()->GetBackButton()->IsDrawn());
+  EXPECT_TRUE(toolbar->forward_button()->IsDrawn());
+  EXPECT_TRUE(reload->IsDrawn());
+  EXPECT_TRUE(reload->GetEnabled());
+}
