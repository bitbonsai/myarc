+  EXPECT_TRUE(adapter_->Sidebar().favorites.empty());
+  EXPECT_EQ(id, myarc::BrowserWorkspaceAdapter::ItemIdForContents(*page));
+  PinTab(workspace_browser_);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const auto model = adapter_->Sidebar();
+    const int index = tabs->GetIndexOfWebContents(page);
+    return model.ok && model.favorites.size() == 1u &&
+           model.favorites[0].id == id && tabs->ContainsIndex(index) &&
+           tabs->IsTabPinned(index);
+  }));
+  const auto canonical =
+      std::string(adapter_->Sidebar().favorites[0].canonical_url);
+  auto* tab_list = TabListInterface::From(workspace_browser_);
+  ASSERT_TRUE(tab_list);
+  tab_list->UnpinTab(
+      tabs->GetTabAtIndex(tabs->GetIndexOfWebContents(page))->GetHandle());
+  // Extension API unpin is consumed without deleting managed saved data.
+  auto model = adapter_->Sidebar();
+  ASSERT_EQ(1u, model.favorites.size());
+  EXPECT_EQ(id, model.favorites[0].id);
+  EXPECT_EQ(canonical, std::string(model.favorites[0].canonical_url));
+  EXPECT_TRUE(tabs->IsTabPinned(tabs->GetIndexOfWebContents(page)));
+
+  tabs->SetTabPinned(tabs->GetIndexOfWebContents(page), false);
+  ASSERT_FALSE(tabs->IsTabPinned(tabs->GetIndexOfWebContents(page)));
+  // Generic native bit changes are repaired by the posted projection refresh.
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const int index = tabs->GetIndexOfWebContents(page);
+    return tabs->ContainsIndex(index) && tabs->IsTabPinned(index);
+  }));
+  model = adapter_->Sidebar();
+  ASSERT_EQ(1u, model.favorites.size());
+  EXPECT_EQ(id, model.favorites[0].id);
+  EXPECT_EQ(canonical, std::string(model.favorites[0].canonical_url));
+  EXPECT_EQ(id, myarc::BrowserWorkspaceAdapter::ItemIdForContents(*page));
+
+  // Explicit UI removal uses Unsave, never just the generic pin bit.
+  tabs->ExecuteContextMenuCommand(tabs->GetIndexOfWebContents(page),
+                                  TabStripModel::CommandTogglePinned);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const auto model = adapter_->Sidebar();
+    return model.ok && model.favorites.empty() && model.pins.empty() &&
+           model.temporary.size() == 1u && model.temporary[0].id == id &&
+           adapter_->DisplayedContents() == page &&
+           myarc::BrowserWorkspaceAdapter::ItemIdForContents(*page) == id &&
+           !tabs->IsTabPinned(tabs->GetIndexOfWebContents(page));
+  }));
+  EXPECT_FALSE(view_->IsMyarcWorkspaceBlank());
+  EXPECT_EQ(id, myarc::BrowserWorkspaceAdapter::ItemIdForContents(*page));
+}
