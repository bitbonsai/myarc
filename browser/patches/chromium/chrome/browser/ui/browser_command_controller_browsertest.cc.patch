+IN_PROC_BROWSER_TEST_P(MyarcWorkspaceCommandSafetyTest,
+                       HiddenTabCommandsAndUpdates) {
+  auto* tabs = workspace_browser_->GetTabStripModel();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      workspace_browser_, GURL("data:text/html,<title>Command test</title>")));
+  auto* hidden = tabs->GetActiveWebContents();
+  auto* root = BrowserActions::From(workspace_browser_)->root_action_item();
+  auto* source =
+      actions::ActionManager::Get().FindAction(kActionViewSource, root);
+  auto* zoom =
+      actions::ActionManager::Get().FindAction(kActionShowZoomBubble, root);
+  ASSERT_TRUE(source);
+  ASSERT_TRUE(zoom);
+  ASSERT_TRUE(CanViewSource(workspace_browser_));
+  const bool source_enabled = source->GetEnabled();
+  const bool zoom_enabled = zoom->GetEnabled();
+  ASSERT_TRUE(source_enabled);
+  auto* helper = CoreTabHelper::FromWebContents(hidden);
+  ASSERT_TRUE(helper);
+  helper->UpdateContentRestrictions(CONTENT_RESTRICTION_COPY |
+                                    CONTENT_RESTRICTION_CUT |
+                                    CONTENT_RESTRICTION_PASTE);
+  EXPECT_FALSE(IsCommandEnabled(workspace_browser_, IDC_COPY));
+  const int index = tabs->active_index();
+  const int count = tabs->count();
+  const GURL old_url = hidden->GetVisibleURL();
+  const auto old_space = adapter_->Sidebar().current_space.id;
+  ASSERT_NO_FATAL_FAILURE(EnterEmptySpace());
+  // Inspect Actions before any command updates can mask missing transition
+  // work.
+  EXPECT_FALSE(source->GetEnabled());
+  EXPECT_FALSE(zoom->GetEnabled());
+  ASSERT_EQ(hidden, tabs->GetActiveWebContents());
+  ASSERT_EQ(index, tabs->active_index());
+
+  constexpr int page_commands[] = {
+      IDC_BACK,
+      IDC_FORWARD,
+      IDC_RELOAD,
+      IDC_STOP,
+      IDC_HOME,
+      IDC_CLOSE_TAB,
+      IDC_DUPLICATE_TAB,
+      IDC_NEW_SPLIT_TAB,
+      IDC_PRINT,
+      IDC_SAVE_PAGE,
+      IDC_VIEW_SOURCE,
+      IDC_FIND,
+      IDC_ZOOM_PLUS,
+      IDC_DEV_TOOLS,
+      IDC_COPY_URL,
+      IDC_BOOKMARK_THIS_TAB,
+      IDC_WINDOW_PIN_TAB,
+#if BUILDFLAG(IS_MAC)
+      IDC_TOGGLE_JAVASCRIPT_APPLE_EVENTS,
+#endif
+  };
+  auto* controller = BrowserCommandController::From(workspace_browser_);
+  for (int id : page_commands) {
+    SCOPED_TRACE(id);
+    // Check the genuine native baseline, without force-enabling test commands.
+    EXPECT_FALSE(IsCommandEnabled(workspace_browser_, id));
+    EXPECT_FALSE(ExecuteCommand(workspace_browser_, id));
+  }
+  // Real updater entry points must retain the blank gate and field editing.
+  controller->TabStateChanged();
+  controller->ContentRestrictionsChanged();
+  controller->FullscreenStateChanged();
+  controller->LoadingStateChanged(true, true);
+  EXPECT_FALSE(source->GetEnabled());
+  EXPECT_FALSE(zoom->GetEnabled());
+  EXPECT_FALSE(IsCommandEnabled(workspace_browser_, IDC_STOP));
+  EXPECT_TRUE(IsCommandEnabled(workspace_browser_, IDC_NEW_TAB));
+  EXPECT_TRUE(IsCommandEnabled(workspace_browser_, IDC_NEW_WINDOW));
+  EXPECT_TRUE(IsCommandEnabled(workspace_browser_, IDC_FOCUS_LOCATION));
+  EXPECT_TRUE(IsCommandEnabled(workspace_browser_, IDC_CUT));
+  EXPECT_TRUE(IsCommandEnabled(workspace_browser_, IDC_COPY));
+  EXPECT_TRUE(IsCommandEnabled(workspace_browser_, IDC_PASTE));
+
+  // Direct helpers bypass ExecuteCommand; they must share the same gate.
+  CloseTab(workspace_browser_);
+  DuplicateTab(workspace_browser_);
+  Home(workspace_browser_, WindowOpenDisposition::kCurrentTab);
+  PinTab(workspace_browser_);
+  NewSplitTab(workspace_browser_, split_tabs::SplitTabLayout::kSideBySide,
+              split_tabs::SplitTabCreatedSource::kKeyboardShortcut);
+  EXPECT_EQ(count, tabs->count());
+  EXPECT_EQ(old_url, hidden->GetVisibleURL());
+  EXPECT_FALSE(tabs->IsTabPinned(index));
+  EXPECT_FALSE(
+      tabs->IsContextMenuCommandEnabled(index, TabStripModel::CommandCloseTab));
+  tabs->ExecuteContextMenuCommand(index, TabStripModel::CommandCloseTab);
+  EXPECT_EQ(count, tabs->count());
+
+  source->InvokeAction();
+#if BUILDFLAG(IS_MAC)
+  EXPECT_TRUE(IsMyarcPageCommand(IDC_TOGGLE_JAVASCRIPT_APPLE_EVENTS));
+  auto* apple_events = actions::ActionManager::Get().FindAction(
+      kActionToggleJavascriptAppleEvents, root);
+  ASSERT_TRUE(apple_events);
+  EXPECT_FALSE(apple_events->GetEnabled());
+  const bool apple_events_allowed =
+      workspace_browser_->GetProfile()->GetPrefs()->GetBoolean(
+          prefs::kAllowJavascriptAppleEvents);
+  apple_events->InvokeAction();
+  EXPECT_EQ(apple_events_allowed,
+            workspace_browser_->GetProfile()->GetPrefs()->GetBoolean(
+                prefs::kAllowJavascriptAppleEvents));
+#endif
+  EXPECT_EQ(old_url, hidden->GetVisibleURL());
+  EXPECT_EQ(count, tabs->count());
+
+  ASSERT_TRUE(adapter_->SelectSpace(old_space).ok);
+  view_->RefreshMyarcWorkspaceSidebar();
+  EXPECT_FALSE(view_->IsMyarcWorkspaceBlank());
+  EXPECT_TRUE(IsCommandEnabled(workspace_browser_, IDC_CLOSE_TAB));
+  EXPECT_TRUE(IsCommandEnabled(workspace_browser_, IDC_RELOAD));
+  EXPECT_EQ(source_enabled, source->GetEnabled());
+  EXPECT_EQ(zoom_enabled, zoom->GetEnabled());
+  EXPECT_FALSE(IsCommandEnabled(workspace_browser_, IDC_COPY));
+  EXPECT_FALSE(IsCommandEnabled(workspace_browser_, IDC_CUT));
+  EXPECT_FALSE(IsCommandEnabled(workspace_browser_, IDC_PASTE));
+  EXPECT_EQ(hidden, adapter_->DisplayedContents());
+}
