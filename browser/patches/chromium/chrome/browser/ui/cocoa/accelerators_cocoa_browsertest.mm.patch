+IN_PROC_BROWSER_TEST_F(MyarcAcceleratorsCocoaBrowserTest, CopyURLShortcut) {
+  const ui::Accelerator* accelerator =
+      AcceleratorsCocoa::GetInstance()->GetAcceleratorForCommand(IDC_COPY_URL);
+  ASSERT_TRUE(accelerator);
+  EXPECT_EQ(ui::VKEY_C, accelerator->key_code());
+  EXPECT_TRUE(accelerator->IsCmdDown());
+  EXPECT_TRUE(accelerator->IsShiftDown());
+  EXPECT_FALSE(accelerator->IsAltDown());
+  EXPECT_FALSE(accelerator->IsCtrlDown());
+
+  bool hidden_shortcut_found = false;
+  for (const auto& shortcut : GetShortcutsNotPresentInMainMenu()) {
+    if (shortcut.command_key && shortcut.shift_key && !shortcut.cntrl_key &&
+        !shortcut.opt_key && shortcut.vkey_code == kVK_ANSI_C) {
+      hidden_shortcut_found = true;
+      EXPECT_EQ(IDC_COPY_URL, shortcut.chrome_command);
+    }
+  }
+  EXPECT_TRUE(hidden_shortcut_found);
+}
