 #import "ui/base/cocoa/macos27_sdk.h"
 #include "ui/base/l10n/l10n_util.h"
@@ -34,6 +38,33 @@ namespace {
 
 using Item = internal::MenuItemBuilder;
 
+bool UseMyarcAppMenu() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  return command_line->HasSwitch("myarc-visual-parity") &&
+         command_line->HasSwitch("myarc-workspace-sidebar");
+}
+
+// myArc puts its nightly label (Info.plist `MyarcVersion`, written when the
+// nightly is packaged) above About, read-only. Builds without it say "dev".
+// About, Hide and Quit name myArc, not the Chromium product name.
+void AddMyarcVersionItem(NSMenu* app_menu) {
+  NSString* version = base::apple::ObjCCast<NSString>(
+      [base::apple::OuterBundle() objectForInfoDictionaryKey:@"MyarcVersion"]);
+  NSMenuItem* version_item =
+      [[NSMenuItem alloc] initWithTitle:version.length ? version : @"dev"
+                                 action:nil
+                          keyEquivalent:@""];
+  version_item.enabled = NO;
+  [app_menu insertItem:version_item atIndex:0];
+  [app_menu itemWithTag:IDC_ABOUT].title =
+      l10n_util::GetNSStringFWithFixup(IDS_ABOUT_MAC, u"myArc");
+  [app_menu itemWithTag:IDC_HIDE_APP].title =
+      l10n_util::GetNSStringFWithFixup(IDS_HIDE_APP_MAC, u"myArc");
+  [app_menu itemWithTag:IDC_EXIT].title =
+      l10n_util::GetNSStringFWithFixup(IDS_EXIT_MAC, u"myArc");
+}
+
 // Capitalization Policy (go/chrome-capitalization):
 // Native macOS system menu bar items follow Apple Human Interface
 // Guidelines (HIG) and must use Title Case (via `_MAC` string variants or
@@ -107,6 +138,10 @@ NSMenuItem* BuildAppMenu(NSApplication* nsapp,
 
   nsapp.servicesMenu = services_item.submenu;
 
+  if (UseMyarcAppMenu()) {
+    AddMyarcVersionItem(item.submenu);
+  }
+
   return item;
 }
 
@@ -500,6 +535,18 @@ NSMenuItem* BuildWindowMenu(NSApplication* nsapp,
           })
           .Build();
   // clang-format on
+  if (UseMyarcAppMenu() && !is_pwa) {
+    // myArc hides the extensions toolbar, so the bundled blocker's popup,
+    // with its per-site switch, opens from here.
+    NSMenuItem* blocker_item =
+        [[NSMenuItem alloc] initWithTitle:@"Ad Blocking for This Site\u2026"
+                                   action:@selector(commandDispatch:)
+                            keyEquivalent:@""];
+    blocker_item.tag = IDC_MYARC_BLOCKER_POPUP;
+    NSInteger extensions_index =
+        [item.submenu indexOfItemWithTag:IDC_MANAGE_EXTENSIONS];
+    [item.submenu insertItem:blocker_item atIndex:extensions_index + 1];
+  }
   nsapp.windowsMenu = item.submenu;
   return item;
 }
