+                IDC_MYARC_NEW_LITTLE_ARC)) {
+      KeyEquivalentAndModifierMask* equivalent =
+          GetKeyEquivalentAndModifierMaskFromAccelerator(*accelerator);
+      little_arc_item.keyEquivalent = equivalent.keyEquivalent;
+      little_arc_item.keyEquivalentModifierMask = equivalent.modifierMask;
+    }
+    [item.submenu insertItem:[NSMenuItem separatorItem] atIndex:0];
+    [item.submenu insertItem:little_arc_item atIndex:0];
+    // Arc's View menu: Collapse Pinned Tabs after the sidebar toggle, then
+    // Clear Cookies and Refresh, Clear Cache and Refresh and Expand Current
+    // Split after the reloads. None has a shortcut in Arc.
+    const auto add_after = [&item](int after, NSString* title, int command) {
