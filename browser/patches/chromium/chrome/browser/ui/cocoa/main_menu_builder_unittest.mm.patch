+TEST(MainMenuBuilderTest, MyarcAppMenuShowsVersionAboveAbout) {
+  base::test::ScopedCommandLine scoped_command_line;
+  base::CommandLine* command_line = scoped_command_line.GetProcessCommandLine();
+  command_line->AppendSwitch("myarc-visual-parity");
+  command_line->AppendSwitch("myarc-workspace-sidebar");
+
+  NSMenu* app_menu =
+      [chrome::BuildMainMenu(nil, nil, u"Chromium", /*is_pwa=*/false,
+                             /*is_rtl=*/false) itemAtIndex:0]
+          .submenu;
+  NSMenuItem* version_item = [app_menu itemAtIndex:0];
+  EXPECT_NSEQ(@"dev", version_item.title);
+  EXPECT_FALSE(version_item.enabled);
+  EXPECT_EQ(nil, version_item.action);
+  NSMenuItem* about_item = [app_menu itemAtIndex:1];
+  EXPECT_EQ(IDC_ABOUT, about_item.tag);
+  EXPECT_NSEQ(l10n_util::GetNSStringF(IDS_ABOUT_MAC, u"myArc"),
+              about_item.title);
+  EXPECT_TRUE([app_menu itemAtIndex:2].separatorItem);
+}
