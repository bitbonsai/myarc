+TEST(MainMenuBuilderTest, MyarcAppMenuShowsVersionAboveAbout) {
+  base::test::ScopedCommandLine scoped_command_line;
+  base::CommandLine* command_line = scoped_command_line.GetProcessCommandLine();
+  command_line->AppendSwitch("myarc-visual-parity");
+  command_line->AppendSwitch("myarc-workspace-sidebar");
+
+  NSMenu* app_menu =
+      [chrome::BuildMainMenu(nil, nil, u"Chromium", /*is_pwa=*/false,
+                             /*is_rtl=*/false) itemAtIndex:0]
+          .submenu;
+  NSMenuItem* version_item = [app_menu itemAtIndex:0];
+  EXPECT_NSEQ(@"dev", version_item.title);
+  EXPECT_FALSE(version_item.enabled);
+  EXPECT_EQ(nil, version_item.action);
+  NSMenuItem* about_item = [app_menu itemAtIndex:1];
+  EXPECT_EQ(IDC_ABOUT, about_item.tag);
+  EXPECT_NSEQ(l10n_util::GetNSStringF(IDS_ABOUT_MAC, u"myArc"),
+              about_item.title);
+  EXPECT_TRUE([app_menu itemAtIndex:2].separatorItem);
+  EXPECT_NSEQ(l10n_util::GetNSStringF(IDS_HIDE_APP_MAC, u"myArc"),
+              [app_menu itemWithTag:IDC_HIDE_APP].title);
+  EXPECT_NSEQ(l10n_util::GetNSStringF(IDS_EXIT_MAC, u"myArc"),
+              [app_menu itemWithTag:IDC_EXIT].title);
+}
+
+TEST(MainMenuBuilderTest, MyarcMenuBarMatchesArcStructure) {
+  base::test::ScopedCommandLine scoped_command_line;
+  base::CommandLine* command_line = scoped_command_line.GetProcessCommandLine();
+  command_line->AppendSwitch("myarc-visual-parity");
+  command_line->AppendSwitch("myarc-workspace-sidebar");
+
+  NSMenu* main_menu = chrome::BuildMainMenu(nil, nil, u"Chromium",
+                                            /*is_pwa=*/false, /*is_rtl=*/false);
+  // Arc top-level order: App, File, Edit, View, Spaces, Tabs, Archive,
+  // Extensions, Window, Help.
+  ASSERT_EQ(10, main_menu.numberOfItems);
+  EXPECT_EQ(IDC_CHROME_MENU, [main_menu itemAtIndex:0].tag);
+  EXPECT_EQ(IDC_FILE_MENU, [main_menu itemAtIndex:1].tag);
+  EXPECT_EQ(IDC_EDIT_MENU, [main_menu itemAtIndex:2].tag);
+  EXPECT_EQ(IDC_VIEW_MENU, [main_menu itemAtIndex:3].tag);
+  EXPECT_EQ(IDC_MYARC_SPACES_MENU, [main_menu itemAtIndex:4].tag);
+  EXPECT_EQ(IDC_MYARC_TABS_MENU, [main_menu itemAtIndex:5].tag);
+  EXPECT_EQ(IDC_MYARC_ARCHIVE_MENU, [main_menu itemAtIndex:6].tag);
+  EXPECT_EQ(IDC_MYARC_EXTENSIONS_MENU, [main_menu itemAtIndex:7].tag);
+  EXPECT_EQ(IDC_WINDOW_MENU, [main_menu itemAtIndex:8].tag);
+
+  // Replaced Chromium top-level menus are removed.
+  EXPECT_EQ(nil, [main_menu itemWithTag:IDC_HISTORY_MENU]);
+  EXPECT_EQ(nil, [main_menu itemWithTag:IDC_BOOKMARKS_MENU]);
+  EXPECT_EQ(nil, [main_menu itemWithTag:IDC_PROFILE_MAIN_MENU]);
+  EXPECT_EQ(nil, [main_menu itemWithTag:IDC_TAB_MENU]);
+
+  // Key Arc items in Edit, View, Spaces, Tabs, Archive, Extensions, Window.
+  NSMenu* edit_menu = [main_menu itemWithTag:IDC_EDIT_MENU].submenu;
+  EXPECT_NE(nil, [edit_menu itemWithTag:IDC_COPY_URL]);
+  EXPECT_NE(nil, [edit_menu itemWithTag:IDC_MYARC_COPY_URL_MARKDOWN]);
+  EXPECT_NE(nil, [edit_menu itemWithTag:IDC_MYARC_COPY_URL_QUOTE]);
+
+  NSMenu* view_menu = [main_menu itemWithTag:IDC_VIEW_MENU].submenu;
+  EXPECT_EQ(nil, [view_menu itemWithTag:IDC_SHOW_BOOKMARK_BAR]);
+  EXPECT_NE(nil, [view_menu itemWithTag:IDC_NEW_SPLIT_TAB]);
+  EXPECT_NE(nil, [view_menu itemWithTag:IDC_MYARC_SEPARATE_SPLIT]);
+  EXPECT_NE(nil, [view_menu itemWithTag:IDC_MYARC_EXPAND_SPLIT]);
+
+  NSMenu* spaces_menu = [main_menu itemWithTag:IDC_MYARC_SPACES_MENU].submenu;
+  EXPECT_NE(nil, spaces_menu.delegate);
+  EXPECT_NE(nil, [spaces_menu itemWithTag:IDC_MYARC_NEW_SPACE]);
+  EXPECT_NE(nil, [spaces_menu itemWithTag:IDC_MYARC_MANAGE_SPACES]);
+
+  NSMenu* tabs_menu = [main_menu itemWithTag:IDC_MYARC_TABS_MENU].submenu;
+  EXPECT_NE(nil, [tabs_menu itemWithTag:IDC_MYARC_TOGGLE_PIN]);
+  EXPECT_NE(nil, [tabs_menu itemWithTag:IDC_MYARC_NEW_FOLDER]);
+  EXPECT_NE(nil, [tabs_menu itemWithTag:IDC_MYARC_REVEAL_TAB]);
+  EXPECT_NE(nil, [tabs_menu itemWithTag:IDC_MYARC_CLEAR_TODAY]);
+  EXPECT_NE(nil, [tabs_menu itemWithTag:IDC_MYARC_RESET_SPACE_TABS]);
+
+  NSMenu* archive_menu = [main_menu itemWithTag:IDC_MYARC_ARCHIVE_MENU].submenu;
+  EXPECT_NE(nil, [archive_menu itemWithTag:IDC_BACK]);
+  EXPECT_NE(nil, [archive_menu itemWithTag:IDC_FORWARD]);
+  EXPECT_NE(nil, [archive_menu itemWithTag:IDC_SHOW_HISTORY]);
+  EXPECT_NE(nil, [archive_menu itemWithTag:IDC_MYARC_VIEW_ARCHIVE]);
+  EXPECT_NE(nil, [archive_menu itemWithTag:IDC_MYARC_CLEAR_ARCHIVE]);
+
+  NSMenu* extensions_menu =
+      [main_menu itemWithTag:IDC_MYARC_EXTENSIONS_MENU].submenu;
+  EXPECT_NE(nil, [extensions_menu itemWithTag:IDC_MYARC_ADD_EXTENSION]);
+  EXPECT_NE(nil, [extensions_menu itemWithTag:IDC_MANAGE_EXTENSIONS]);
+  EXPECT_NE(nil, [extensions_menu itemWithTag:IDC_MYARC_BLOCKER_POPUP]);
+
+  NSMenu* window_menu = [main_menu itemWithTag:IDC_WINDOW_MENU].submenu;
+  EXPECT_NE(nil, [window_menu itemWithTag:IDC_MYARC_STAY_ON_TOP]);
+  EXPECT_NE(nil, [window_menu itemWithTag:IDC_MYARC_OPEN_LIBRARY]);
+  EXPECT_NE(nil, [window_menu itemWithTag:IDC_MYARC_VIEW_MEDIA]);
+  EXPECT_NE(nil, [window_menu itemWithTag:IDC_MYARC_VIEW_BOOSTS]);
+  EXPECT_EQ(nil, [window_menu itemWithTag:IDC_MANAGE_EXTENSIONS]);
+}
