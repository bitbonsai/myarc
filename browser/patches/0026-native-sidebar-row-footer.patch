+IN_PROC_BROWSER_TEST_F(BrowserViewSidebarPresentationTest,
+                       FooterUsesFixedSquaresAndRevealsCurrentSpace) {
+  for (int i = 0; i < 18; ++i) {
+    ASSERT_TRUE(service().CreateSpace("Footer " + base::NumberToString(i)).ok);
+  }
+  auto* adapter = browser_view()->GetMyarcWorkspaceAdapter();
+  auto model = adapter->Sidebar();
+  ASSERT_TRUE(model.ok);
+  const auto last = model.spaces[model.spaces.size() - 1].id;
+  ASSERT_TRUE(adapter->SelectSpace(last).ok);
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  RunScheduledLayouts();
+  auto* library = Button(u"Library");
+  auto* create = Button(u"Create Space");
+  auto* current = Button(u"Space: Footer 17");
+  ASSERT_TRUE(library);
+  ASSERT_TRUE(create);
+  ASSERT_TRUE(current);
+  EXPECT_EQ(gfx::Size(32, 32), library->size());
+  EXPECT_EQ(gfx::Size(32, 32), create->size());
+  EXPECT_EQ(gfx::Size(32, 32), current->size());
+  EXPECT_FALSE(library->GetImage(views::Button::STATE_NORMAL).isNull());
+  EXPECT_FALSE(current->GetImage(views::Button::STATE_NORMAL).isNull());
+  EXPECT_EQ(ui::kColorSysSurfaceContainer, current->GetBgColorIdOverride());
+  EXPECT_EQ(library->GetBoundsInScreen().CenterPoint().y(),
+            current->GetBoundsInScreen().CenterPoint().y());
+  EXPECT_EQ(create->GetBoundsInScreen().CenterPoint().y(),
+            current->GetBoundsInScreen().CenterPoint().y());
+  auto* scroll = views::ScrollView::GetScrollViewForContents(current->parent());
+  ASSERT_TRUE(scroll);
+  EXPECT_GT(scroll->CurrentOffset().x(), 0);
+  EXPECT_TRUE(
+      scroll->GetVisibleRect().Contains(views::View::ConvertRectToTarget(
+          current, scroll, current->GetLocalBounds())));
+  for (const auto& space : adapter->Sidebar().spaces) {
+    auto* choice =
+        Button(u"Space: " + base::UTF8ToUTF16(std::string(space.name)));
+    ASSERT_TRUE(choice);
+    EXPECT_EQ(gfx::Size(32, 32), choice->size());
+    if (space.id != last) {
+      EXPECT_EQ(u"\u2022", choice->GetText());
+      EXPECT_TRUE(choice->GetImage(views::Button::STATE_NORMAL).isNull());
+    }
+  }
+}
