+IN_PROC_BROWSER_TEST_F(BrowserViewSidebarPresentationTest,
+                       LibraryDispatchesDownloadsAndExistingSpaceActions) {
+  ASSERT_TRUE(service().CreateSpace("Library target").ok);
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  auto* view = sidebar();
+  ASSERT_TRUE(view);
+  auto* menu = myarc::SidebarViewTestApi::LibraryMenu(view);
+  ASSERT_EQ(u"Downloads", menu->GetLabelAt(0));
+  auto* other = CreateBrowser(profile());
+  const GURL other_url =
+      other->GetTabStripModel()->GetActiveWebContents()->GetLastCommittedURL();
+  const int other_count = other->GetTabStripModel()->count();
+  menu->ActivatedAt(0, 0);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return active_web_contents()->GetLastCommittedURL() ==
+           GURL(chrome::kChromeUIDownloadsURL);
+  }));
+  EXPECT_EQ(other_count, other->GetTabStripModel()->count());
+  EXPECT_EQ(
+      other_url,
+      other->GetTabStripModel()->GetActiveWebContents()->GetLastCommittedURL());
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  menu = myarc::SidebarViewTestApi::LibraryMenu(sidebar());
+  bool selected = false;
+  for (size_t i = 0; i < menu->GetItemCount(); ++i) {
+    if (menu->GetLabelAt(i) == u"Switch to Space: Library target") {
+      menu->ActivatedAt(i, 0);
+      selected = true;
+      break;
+    }
+  }
+  ASSERT_TRUE(selected);
+  EXPECT_EQ("Library target", std::string(browser_view()
+                                              ->GetMyarcWorkspaceAdapter()
+                                              ->Sidebar()
+                                              .current_space.name));
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  menu = myarc::SidebarViewTestApi::LibraryMenu(sidebar());
+  ASSERT_EQ(u"Create Space", menu->GetLabelAt(menu->GetItemCount() - 1));
+  menu->ActivatedAt(menu->GetItemCount() - 1, 0);
+  views::DialogDelegate* dialog = nullptr;
+  for (const auto& widget : views::Widget::GetAllOwnedWidgets(
+           browser_view()->GetWidget()->GetNativeView())) {
+    if (widget->widget_delegate()->GetWindowTitle() == u"Create Space") {
+      dialog = widget->widget_delegate()->AsDialogDelegate();
+      break;
+    }
+  }
+  ASSERT_TRUE(dialog);
+  auto* name =
+      views::AsViewClass<views::Textfield>(dialog->GetInitiallyFocusedView());
+  ASSERT_TRUE(name);
+  name->SetText(u"Library created");
+  dialog->AcceptDialog();
+  const auto after_create =
+      browser_view()->GetMyarcWorkspaceAdapter()->Sidebar();
+  bool created = false;
+  for (const auto& space : after_create.spaces) {
+    created |= std::string(space.name) == "Library created";
+  }
+  EXPECT_TRUE(created);
+  CloseBrowserSynchronously(other);
+}
