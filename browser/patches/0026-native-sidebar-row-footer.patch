+IN_PROC_BROWSER_TEST_F(BrowserViewSidebarPresentationTest,
+                       CloseStaysInsideHighlightWithoutTitleShift) {
+  const GURL url("data:text/html,<title>Sidebar row fixture</title>");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  RunScheduledLayouts();
+  auto* activate = Button(u"Sidebar row fixture");
+  auto* close = Button(u"Close live page: Sidebar row fixture");
+  ASSERT_TRUE(activate);
+  ASSERT_TRUE(close);
+  auto* row = activate->parent();
+  ASSERT_EQ(row, close->parent());
+  ASSERT_TRUE(row->background());
+  EXPECT_TRUE(row->GetLocalBounds().Contains(close->bounds()));
+  EXPECT_TRUE(row->GetLocalBounds().Contains(activate->bounds()));
+  EXPECT_EQ(activate->width() + close->width(), row->width());
+  EXPECT_EQ(gfx::Size(32, 32), close->size());
+  EXPECT_EQ(activate->context_menu_controller(),
+            close->context_menu_controller());
+  EXPECT_TRUE(close->context_menu_controller());
+  browser_view()->GetFocusManager()->ClearFocus();
+  ui::MouseEvent exit(ui::EventType::kMouseExited, gfx::PointF(), gfx::PointF(),
+                      ui::EventTimeForNow(), 0, 0);
+  row->OnMouseExited(exit);
+  EXPECT_TRUE(close->GetImage(views::Button::STATE_NORMAL).isNull());
+  const auto child_bounds = ChildBounds(activate);
+  const gfx::Rect target = close->bounds();
+  ui::MouseEvent enter(ui::EventType::kMouseEntered, gfx::PointF(),
+                       gfx::PointF(), ui::EventTimeForNow(), 0, 0);
+  row->OnMouseEntered(enter);
+  RunScheduledLayouts();
+  EXPECT_EQ(gfx::Size(20, 20),
+            close->GetImage(views::Button::STATE_NORMAL).size());
+  EXPECT_EQ(child_bounds, ChildBounds(activate));
+  EXPECT_EQ(target, close->bounds());
+  row->OnMouseExited(exit);
+  activate->RequestFocus();
+  EXPECT_FALSE(close->GetImage(views::Button::STATE_NORMAL).isNull());
+  close->RequestFocus();
+  EXPECT_TRUE(close->HasFocus());
+  EXPECT_FALSE(close->GetImage(views::Button::STATE_NORMAL).isNull());
+  EXPECT_EQ(child_bounds, ChildBounds(activate));
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  RunScheduledLayouts();
+  close = Button(u"Close live page: Sidebar row fixture");
+  ASSERT_TRUE(close);
+  EXPECT_TRUE(close->HasFocus());
+  EXPECT_FALSE(close->GetImage(views::Button::STATE_NORMAL).isNull());
+  ASSERT_TRUE(Button(u"Library"));
+  Button(u"Library")->RequestFocus();
+  close->parent()->OnMouseExited(exit);
+  EXPECT_TRUE(close->GetImage(views::Button::STATE_NORMAL).isNull());
+}
