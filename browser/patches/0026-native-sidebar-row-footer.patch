+class BrowserViewSidebarPresentationTest : public BrowserViewStorageRetryTest {
+ protected:
+  void SetUpOnMainThread() override {
+    BrowserViewStorageRetryTest::SetUpOnMainThread();
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return browser_view()->GetMyarcWorkspaceAdapter()->ready(); }));
+  }
+
+  myarc::SidebarView* sidebar(views::View* root = nullptr) {
+    if (!root) {
+      root = browser_view();
+    }
+    if (auto* result = views::AsViewClass<myarc::SidebarView>(root)) {
+      return result;
+    }
+    for (const auto& child : root->children()) {
+      if (auto* result = sidebar(child)) {
+        return result;
+      }
+    }
+    return nullptr;
+  }
+
+  std::vector<gfx::Rect> ChildBounds(views::View* button) {
+    std::vector<gfx::Rect> result;
+    for (const auto& child : button->children()) {
+      result.push_back(child->bounds());
+    }
+    return result;
+  }
+};
