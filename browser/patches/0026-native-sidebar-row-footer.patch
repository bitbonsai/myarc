+void BrowserView::OpenDownloads() {
+  // Menu dispatch unwinds before tab selection can rebuild sidebar children.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<BrowserView> view) {
+                       if (view) {
+                         chrome::ExecuteCommand(view->browser_.get(),
+                                                IDC_SHOW_DOWNLOADS);
+                       }
+                     },
+                     myarc_workspace_weak_factory_.GetWeakPtr()));
+}
