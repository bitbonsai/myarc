+class ChromeAimEligibilityServiceMyarcBrowserTest
+    : public AimEligibilityTestBase,
+      public testing::WithParamInterface<int> {
+ public:
+  ChromeAimEligibilityServiceMyarcBrowserTest() {
+    features_.InitWithFeaturesAndParameters(
+        {{omnibox::kAimEnabled, {}},
+         {omnibox::kAim3pEntrypoint,
+          {{omnibox::kAim3pEntrypointDebug.name, "true"}}},
+         {omnibox::internal::kWebUIOmniboxAimPopup, {}}},
+        {omnibox::kAimServerEligibilityEnabled});
+  }
+
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    AimEligibilityTestBase::SetUpCommandLine(command_line);
+    if (GetParam() & 1) {
+      command_line->AppendSwitch("myarc-visual-parity");
+    }
+    if (GetParam() & 2) {
+      command_line->AppendSwitch("myarc-workspace-sidebar");
+    }
+  }
+
+ private:
+  base::test::ScopedFeatureList features_;
+};
+
+IN_PROC_BROWSER_TEST_P(ChromeAimEligibilityServiceMyarcBrowserTest,
+                       PrototypeOmitsUnsupportedEntrypoints) {
+  const bool prototype = GetParam() == 3;
+  Profile* const regular = GetProfile();
+  Profile* const otr = regular->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  auto* const regular_service = GetAimEligibilityService(regular);
+  auto* const otr_service = GetAimEligibilityService(otr);
+  ASSERT_TRUE(regular_service);
+  ASSERT_TRUE(otr_service);
+  EXPECT_NE(regular_service, otr_service);
+
+  for (Profile* profile : {regular, otr}) {
+    SCOPED_TRACE(profile->IsOffTheRecord());
+    SetUpDefaultSearchEngine(profile, /*is_google_dse=*/true);
+    auto* const service = GetAimEligibilityService(profile);
+    auto* const prefs = profile->GetPrefs();
+    auto* const button = AiModeButtonServiceFactory::GetForProfile(profile);
+    ASSERT_TRUE(button);
+    ASSERT_TRUE(button->GetCurrentConfig());
+    auto* const search = TemplateURLServiceFactory::GetForProfile(profile);
+    prefs->SetInteger(omnibox::kAIModeSettings, 0);
+    prefs->SetBoolean(omnibox::kShowAiModeOmniboxButton, true);
+
+    EXPECT_EQ(!prototype, service->IsAimAllowedByFeatureAndPolicy());
+    EXPECT_EQ(!prototype, service->IsAimLocallyEligible());
+    EXPECT_EQ(!prototype, service->IsAimEligible());
+    EXPECT_EQ(!prototype, OmniboxFieldTrial::IsAimOmniboxEntrypointEnabled(
+                              service, button, search));
+    EXPECT_EQ(!prototype, omnibox::ShouldShowAimContextMenuOption(profile));
+    EXPECT_FALSE(prefs->IsManagedPreference(omnibox::kAIModeSettings));
+    EXPECT_EQ(0, prefs->GetInteger(omnibox::kAIModeSettings));
+    EXPECT_TRUE(prefs->GetBoolean(omnibox::kShowAiModeOmniboxButton));
+
+    // Native policy still applies, and resetting it cannot enable prototype AI.
+    prefs->SetInteger(omnibox::kAIModeSettings, 1);
+    EXPECT_FALSE(service->IsAimAllowedByFeatureAndPolicy());
+    prefs->SetInteger(omnibox::kAIModeSettings, 0);
+    EXPECT_EQ(!prototype, service->IsAimAllowedByFeatureAndPolicy());
+
+    // The non-Google entrypoint uses feature/policy eligibility directly.
+    SetUpDefaultSearchEngine(profile, /*is_google_dse=*/false);
+    EXPECT_FALSE(service->IsAimEligible());
+    EXPECT_EQ(!prototype, service->IsAimAllowedByFeatureAndPolicy());
+    ASSERT_TRUE(button->GetCurrentConfig());
+    EXPECT_EQ(!prototype, OmniboxFieldTrial::IsAimOmniboxEntrypointEnabled(
+                              service, button, search));
+    EXPECT_FALSE(omnibox::IsAimPopupEnabled(profile));
+    EXPECT_EQ(!prototype, omnibox::ShouldShowAimContextMenuOption(profile));
+    ASSERT_TRUE(search->GetDefaultSearchProvider());
+    EXPECT_EQ("https://www.bing.com/search?q={searchTerms}",
+              search->GetDefaultSearchProvider()->url());
+  }
+}
