+IN_PROC_BROWSER_TEST_F(SessionCrashedBubbleViewTest,
+                       RecoveryChoiceHandsOffAfterDialogDeletion) {
+  Profile* const profile = browser()->GetProfile();
+  RecoveryLifecycleProbe probe(profile);
+  ExitTypeService::GetInstanceForProfile(profile)
+      ->SetLastSessionExitTypeForTest(ExitType::kCrashed);
+  ShowUi("SessionCrashedBubble");
+  ASSERT_TRUE(myarc::WorkspaceLifecycle::HasPendingSessionRestore(profile));
+
+  crash_bubble_->AcceptDialog();
+
+  EXPECT_TRUE(probe.choice_finished);
+  EXPECT_TRUE(probe.restore_started);
+  EXPECT_TRUE(probe.restore_started_before_choice_finished);
+  EXPECT_TRUE(base::test::RunUntil([profile] {
+    return !myarc::WorkspaceLifecycle::HasPendingSessionRestore(profile);
+  }));
+}
+
+IN_PROC_BROWSER_TEST_F(SessionCrashedBubbleViewTest,
+                       StartupPagesReleaseRecoveryChoice) {
+  Profile* const profile = browser()->GetProfile();
+  RecoveryLifecycleProbe probe(profile);
+  SessionStartupPref startup_pref(SessionStartupPref::URLS);
+  startup_pref.urls.emplace_back("about:blank");
+  SessionStartupPref::SetStartupPref(profile, startup_pref);
+  ShowUi("SessionCrashedBubble");
+  ASSERT_TRUE(myarc::WorkspaceLifecycle::HasPendingSessionRestore(profile));
+
+  crash_bubble_->CancelDialog();
+
+  EXPECT_TRUE(probe.choice_finished);
+  EXPECT_FALSE(probe.restore_started);
+  EXPECT_FALSE(myarc::WorkspaceLifecycle::HasPendingSessionRestore(profile));
+}
+
+IN_PROC_BROWSER_TEST_F(SessionCrashedBubbleViewTest,
+                       AbortedRecoveryShowReleasesChoice) {
+  Profile* const profile = browser()->GetProfile();
+  RecoveryLifecycleProbe probe(profile);
+  BrowserWindowCreateParams params(profile, /*from_user_gesture=*/true);
+  auto* const window = CreateBrowserWindow(std::move(params));
+  // No active tab: Show must release the choice without displaying a dialog.
+  SessionCrashedBubble::ShowIfNotOffTheRecordProfile(window, false);
+  EXPECT_TRUE(base::test::RunUntil([&probe] { return probe.choice_finished; }));
+  EXPECT_FALSE(probe.restore_started);
+  EXPECT_FALSE(myarc::WorkspaceLifecycle::HasPendingSessionRestore(profile));
+  CloseBrowserSynchronously(window);
+}
+
+IN_PROC_BROWSER_TEST_F(SessionCrashedBubbleViewTest,
+                       WindowCloseReleasesRecoveryChoice) {
+  Profile* const profile = browser()->GetProfile();
+  RecoveryLifecycleProbe probe(profile);
+  BrowserWindowCreateParams params(profile, /*from_user_gesture=*/true);
