+IN_PROC_BROWSER_TEST_F(BrowserViewPaletteIntentTest,
+                       HoverRetainsExplicitTabEnterAndMouseActivation) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL original = embedded_test_server()->GetURL("/title1.html");
+  const GURL matched = embedded_test_server()->GetURL("/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), original));
+  auto* contents = active_web_contents();
+  AddTab(browser(), matched);
+  auto* other = active_web_contents();
+  ASSERT_TRUE(content::WaitForLoadStop(other));
+  browser()->GetTabStripModel()->ActivateTabAt(
+      browser()->GetTabStripModel()->GetIndexOfWebContents(contents));
+  const int count = browser()->GetTabStripModel()->count();
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(false));
+  Type(base::UTF8ToUTF16(matched.spec()));
+  auto* row = Result(matched);
+  ASSERT_TRUE(row);
+  EXPECT_EQ(views::View::FocusBehavior::ALWAYS, row->GetFocusBehavior());
+  auto* focus = palette()->GetWidget()->GetFocusManager();
+  ASSERT_EQ(input(), focus->GetFocusedView());
+  focus->SetKeyboardAccessible(true);
+  focus->AdvanceFocus(false);  // Same traversal used by Tab.
+  ASSERT_EQ(row, focus->GetFocusedView());
+  const gfx::Point point = row->GetLocalBounds().CenterPoint();
+  row->OnMouseEntered(ui::MouseEvent(ui::EventType::kMouseEntered, point, point,
+                                     ui::EventTimeForNow(), ui::EF_NONE,
+                                     ui::EF_NONE));
+  row->OnMouseExited(ui::MouseEvent(ui::EventType::kMouseExited, point, point,
+                                    ui::EventTimeForNow(), ui::EF_NONE,
+                                    ui::EF_NONE));
+  EXPECT_EQ(row, focus->GetFocusedView());
+  EXPECT_TRUE(row->OnKeyPressed(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_RETURN, ui::EF_NONE)));
+  EXPECT_EQ(other, active_web_contents());
+
+  browser()->GetTabStripModel()->ActivateTabAt(
+      browser()->GetTabStripModel()->GetIndexOfWebContents(contents));
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(false));
+  Type(base::UTF8ToUTF16(matched.spec()));
+  row = Result(matched);
+  ASSERT_TRUE(row);
+  row->OnMouseEntered(ui::MouseEvent(ui::EventType::kMouseEntered, point, point,
+                                     ui::EventTimeForNow(), ui::EF_NONE,
+                                     ui::EF_NONE));
+  EXPECT_EQ(input(),
+            palette()->GetWidget()->GetFocusManager()->GetFocusedView());
+  ASSERT_TRUE(row->OnMousePressed(ui::MouseEvent(
+      ui::EventType::kMousePressed, point, point, ui::EventTimeForNow(),
+      ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON)));
+  row->OnMouseReleased(ui::MouseEvent(
+      ui::EventType::kMouseReleased, point, point, ui::EventTimeForNow(),
+      ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON));
+  EXPECT_EQ(other, active_web_contents());
+  EXPECT_EQ(original, contents->GetLastCommittedURL());
+  EXPECT_EQ(matched, other->GetLastCommittedURL());
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+}
