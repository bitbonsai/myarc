+#if BUILDFLAG(IS_MAC)
+class BrowserViewPinnedFadeTest : public BrowserViewTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    BrowserViewTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitch("myarc-visual-parity");
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(BrowserViewPinnedFadeTest, EligibilityMotionAndReset) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto rich_animation = gfx::AnimationTestApi::SetRichAnimationRenderMode(
+      gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  auto reduced_motion =
+      gfx::AnimationTestApi::SetPrefersReducedMotionForTesting(false);
+  gfx::ScopedAnimationDurationScaleMode duration(
+      gfx::ScopedAnimationDurationScaleMode::NORMAL_DURATION);
+  auto* tabs = browser()->GetTabStripModel();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  tabs->SetTabPinned(0, true);
+  AddTab(browser(), embedded_test_server()->GetURL("/title2.html"));
+  ASSERT_TRUE(content::WaitForLoadStop(active_web_contents()));
+  tabs->SetTabPinned(1, true);
+  AddTab(browser(), embedded_test_server()->GetURL("/title3.html"));
+  ASSERT_TRUE(content::WaitForLoadStop(active_web_contents()));
+  ASSERT_TRUE(browser_view()->GetWidget()->IsActive());
+
+  auto* view = browser_view()->multi_contents_view()->GetActiveContentsView();
+  ui::Layer* layer = view->holder()->layer();
+  ASSERT_TRUE(layer);
+  auto* animator = layer->GetAnimator();
+  const auto opacity = ui::LayerAnimationElement::OPACITY;
+  // An ordinary tab entering a saved page stays immediate and opaque.
+  tabs->ActivateTabAt(0);
+  EXPECT_FALSE(animator->IsAnimatingProperty(opacity));
+  EXPECT_FLOAT_EQ(1.f, layer->opacity());
+
+  // Existing live saved pages fade only presentation, including rapid switches.
+  tabs->ActivateTabAt(1);
+  EXPECT_EQ(tabs->GetWebContentsAt(1), view->web_contents());
+  EXPECT_TRUE(animator->IsAnimatingProperty(opacity));
+  EXPECT_FLOAT_EQ(1.f, layer->GetTargetOpacity());
+  tabs->ActivateTabAt(0);
+  EXPECT_EQ(tabs->GetWebContentsAt(0), view->web_contents());
+  EXPECT_TRUE(animator->IsAnimatingProperty(opacity));
+  tabs->ActivateTabAt(2);
+  EXPECT_FALSE(animator->IsAnimatingProperty(opacity));
+  EXPECT_FLOAT_EQ(1.f, layer->opacity());
+
+  {
+    auto reduce =
+        gfx::AnimationTestApi::SetPrefersReducedMotionForTesting(true);
+    tabs->ActivateTabAt(0);
+    tabs->ActivateTabAt(1);
+    EXPECT_FALSE(animator->IsAnimatingProperty(opacity));
+    EXPECT_FLOAT_EQ(1.f, layer->opacity());
+  }
+
+  tabs->ActivateTabAt(0);
+  EXPECT_TRUE(animator->IsAnimatingProperty(opacity));
+  view->SetWebContents(nullptr);
+  EXPECT_FALSE(animator->IsAnimatingProperty(opacity));
+  EXPECT_FLOAT_EQ(1.f, layer->opacity());
+  view->SetWebContents(tabs->GetWebContentsAt(0));
+}
+#endif
