+class MyarcPaletteView : public views::BoxLayoutView,
+                         public views::TextfieldController {
+  METADATA_HEADER(MyarcPaletteView, views::BoxLayoutView)
+
+ public:
+  MyarcPaletteView(base::WeakPtr<BrowserWindowInterface> browser, int width)
+      : browser_(browser), width_(width) {
+    SetOrientation(views::BoxLayout::Orientation::kVertical);
+    SetBetweenChildSpacing(8);
+    auto* header = AddChildView(std::make_unique<views::BoxLayoutView>());
+    header->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+    header->SetCrossAxisAlignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto* icon = header->AddChildView(std::make_unique<views::ImageView>());
+    icon->SetImage(ui::ImageModel::FromVectorIcon(vector_icons::kSearchIcon,
+                                                  SK_ColorWHITE, 18));
+    input_ = header->AddChildView(std::make_unique<views::Textfield>());
+    input_->SetController(this);
+    input_->SetPlaceholderText(u"Search or Enter URL...");
+    input_->GetViewAccessibility().SetName(u"Search or Enter URL");
+    input_->SetTextInputType(ui::TEXT_INPUT_TYPE_URL);
+    input_->SetFontList(gfx::FontList().DeriveWithSizeDelta(5));
+    input_->SetBackgroundColor(SkColorSetRGB(30, 28, 32));
+    input_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(8, 12)));
+    header->SetFlexForView(input_, 1);
+    header->SetPreferredSize(gfx::Size(width_, 52));
+    rows_ = AddChildView(std::make_unique<views::BoxLayoutView>());
+    rows_->SetOrientation(views::BoxLayout::Orientation::kVertical);
+    rows_->SetBetweenChildSpacing(4);
+    error_ = AddChildView(std::make_unique<views::Label>());
+    error_->SetEnabledColor(SkColorSetRGB(255, 170, 170));
+    error_->SetVisible(false);
+    Rebuild();
+  }
+
+  views::Textfield* input() { return input_; }
+
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& text) override {
+    Rebuild();
+  }
+
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override {
+    if (event.type() != ui::EventType::kKeyPressed ||
+        sender->IsIMEComposing()) {
+      return false;
+    }
+    if (event.key_code() == ui::VKEY_ESCAPE) {
+      GetWidget()->Close();
+      return true;
+    }
+    if (event.key_code() == ui::VKEY_RETURN) {
+      if (selected_ >= 0) {
+        SwitchToTab(selected_);
+      } else {
+        Submit();
+      }
+      return true;
+    }
+    if (!matches_.empty() && (event.key_code() == ui::VKEY_DOWN ||
+                              event.key_code() == ui::VKEY_UP)) {
+      const int count = static_cast<int>(matches_.size());
+      selected_ =
+          event.key_code() == ui::VKEY_DOWN
+              ? (selected_ + 1) % count
+              : (selected_ < 0 ? count - 1 : (selected_ + count - 1) % count);
+      UpdateSelection();
+      return true;
+    }
+    return false;
+  }
+
+ private:
+  void Resize() {
+    const int row_count = std::max(1, static_cast<int>(matches_.size()));
+    SetPreferredSize(gfx::Size(
+        width_, 60 + row_count * 48 + (error_->GetVisible() ? 32 : 0)));
+    if (GetWidget()) {
+      GetWidget()
+          ->widget_delegate()
+          ->AsBubbleDialogDelegate()
+          ->SizeToContents();
+    }
+  }
+
+  void UpdateSelection() {
+    for (size_t i = 0; i < buttons_.size(); ++i) {
+      buttons_[i]->SetBackground(views::CreateRoundedRectBackground(
+          static_cast<int>(i) == selected_ ? SkColorSetRGB(66, 66, 210)
+                                           : SK_ColorTRANSPARENT,
+          8));
+    }
+  }
+
+  void Rebuild() {
+    buttons_.clear();
+    matches_.clear();
+    rows_->RemoveAllChildViews();
+    selected_ = -1;
+    error_->SetVisible(false);
+    if (input_->GetText().size() > 4096) {
+      error_->SetText(u"Use at most 4096 characters.");
+      error_->SetVisible(true);
+      Resize();
+      return;
+    }
+    const std::u16string query = base::i18n::ToLower(input_->GetText());
+    if (browser_) {
+      auto* model = browser_->GetTabStripModel();
+      // shortcut: scan 512 tabs and show eight; expand for large-workspace
+      // search.
+      for (int i = 0; i < std::min(model->count(), 512) && matches_.size() < 8;
+           ++i) {
+        auto* contents = model->GetWebContentsAt(i);
+        const GURL& url = contents->GetLastCommittedURL();
+        if (url.is_empty() || url.IsAboutBlank()) {
+          continue;
+        }
+        std::u16string title = contents->GetTitle().substr(0, 160);
+        const std::u16string address =
+            base::UTF8ToUTF16(url.spec().substr(0, 512));
+        if (!query.empty() &&
+            base::i18n::ToLower(title + u" " + address).find(query) ==
+                std::u16string::npos) {
+          continue;
+        }
+        if (title.empty()) {
+          title = address;
+        }
+        const int index = static_cast<int>(matches_.size());
+        matches_.push_back(contents->GetWeakPtr());
+        auto* button = rows_->AddChildView(std::make_unique<views::LabelButton>(
+            base::BindRepeating(&MyarcPaletteView::SwitchToTab,
+                                base::Unretained(this), index),
+            title));
+        button->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+        button->SetEnabledTextColors(SK_ColorWHITE);
+        button->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(10, 12)));
+        button->SetPreferredSize(gfx::Size(width_, 44));
+        button->SetTooltipText(u"Switch to tab: " + address);
+        button->SetFocusBehavior(views::View::FocusBehavior::ALWAYS);
+        buttons_.push_back(button);
+      }
+    }
+    if (matches_.empty()) {
+      auto* hint = rows_->AddChildView(std::make_unique<views::Label>(
+          u"Enter opens a new tab. Esc cancels."));
+      hint->SetEnabledColor(SkColorSetRGB(170, 166, 180));
+      hint->SetPreferredSize(gfx::Size(width_, 44));
+    } else {
+      selected_ = 0;
+      UpdateSelection();
+    }
+    Resize();
+  }
+
+  void SwitchToTab(int index) {
+    if (!browser_ || index < 0 || index >= static_cast<int>(matches_.size()) ||
+        !matches_[index]) {
+      Rebuild();
+      return;
+    }
+    const int current = browser_->GetTabStripModel()->GetIndexOfWebContents(
+        matches_[index].get());
+    if (current < 0) {
+      Rebuild();
+      return;
+    }
+    GetWidget()->Close();
+    if (browser_) {
+      browser_->GetTabStripModel()->ActivateTabAt(current);
+    }
+  }
+
+  void Submit() {
+    if (!browser_ ||
+        !chrome::NavigateFromMyarcPalette(browser_.get(), input_->GetText())) {
+      error_->SetText(
+          u"Enter a web URL or search. This address is unsupported.");
+      error_->SetVisible(true);
+      Resize();
+      return;
+    }
+    if (GetWidget() && !GetWidget()->IsClosed()) {
+      GetWidget()->Close();
+    }
+  }
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  const int width_;
+  raw_ptr<views::Textfield> input_ = nullptr;
+  raw_ptr<views::BoxLayoutView> rows_ = nullptr;
+  raw_ptr<views::Label> error_ = nullptr;
+  std::vector<base::WeakPtr<content::WebContents>> matches_;
+  std::vector<raw_ptr<views::LabelButton>> buttons_;
+  int selected_ = -1;
+};
