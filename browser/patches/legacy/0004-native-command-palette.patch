+  delegate->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate->SetShowCloseButton(false);
+  delegate->SetShowTitle(false);
+  delegate->SetTitle(u"New Tab");
+  delegate->set_corner_radius(12);
+  delegate->set_margins(gfx::Insets(12));
+  delegate->SetBackgroundColor(SkColorSetRGB(30, 28, 32));
+  auto* content = delegate->SetContentsView(
+      std::make_unique<MyarcPaletteView>(browser_->GetWeakPtr(), width));
+  delegate->SetInitiallyFocusedView(content->input());
+  myarc_command_palette_widget_ = views::BubbleDialogDelegate::CreateBubble(
+      delegate,
+      base::IgnoreArgs<views::Widget::ClosedReason>(base::BindOnce(
+          &BrowserView::OnMyarcCommandPaletteClosed, GetAsWeakPtr())));
+  myarc_command_palette_widget_->SetColorModeOverride(
+      ui::ColorProviderKey::ColorMode::kDark);
+  if (!multi_contents_view_->layer()) {
+    multi_contents_view_->SetPaintToLayer();
+    multi_contents_view_->layer()->SetFillsBoundsOpaquely(false);
+  }
+  multi_contents_view_->layer()->SetOpacity(0.0f);
+  // The layout requires this parent visible; hide native hosts to block page
+  // clicks.
+  for (const auto& container :
+       multi_contents_view_->contents_container_views()) {
+    container->contents_view()->holder()->SetVisible(false);
+  }
+  myarc_command_palette_widget_->Show();
+  content->input()->RequestFocus();
+  return true;
+}
+
+void BrowserView::OnMyarcCommandPaletteClosed() {
+  if (multi_contents_view_ && multi_contents_view_->layer()) {
+    multi_contents_view_->layer()->SetOpacity(1.0f);
+    for (const auto& container :
+         multi_contents_view_->contents_container_views()) {
+      auto* contents = container->contents_view();
+      contents->holder()->SetVisible(contents->web_contents() &&
+                                     !contents->web_contents()->IsCrashed());
+    }
+  }
+  if (myarc_command_palette_delegate_) {
+    myarc_command_palette_delegate_->SetAnchorView(nullptr);
+  }
+  if (myarc_command_palette_widget_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(myarc_command_palette_widget_));
+  }
+  if (myarc_command_palette_delegate_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(myarc_command_palette_delegate_));
+  }
+}
