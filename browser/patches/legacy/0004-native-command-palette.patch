+
+bool NavigateFromMyarcPalette(BrowserWindowInterface* browser,
+                              std::u16string_view text) {
+  if (text.empty() || text.size() > 4096) {
+    return false;
+  }
+  auto* classifier =
+      AutocompleteClassifierFactory::GetForProfile(browser->GetProfile());
+  if (!classifier) {
+    return false;
+  }
+  AutocompleteMatch match;
+  classifier->Classify(std::u16string(text), false, false,
+                       metrics::OmniboxEventProto::BLANK, &match, nullptr);
+  const GURL& url = match.destination_url;
+  if (!url.is_valid() || !(url.SchemeIsHTTPOrHTTPS() ||
+                           url.SchemeIs("chrome") || url.IsAboutBlank())) {
+    return false;
+  }
+  return AddAndReturnTabAt(browser, url, -1, true, std::nullopt, false,
+                           NavigateParams::WindowAction::kShowWindow) !=
+         nullptr;
+}
