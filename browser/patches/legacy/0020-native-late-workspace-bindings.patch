+IN_PROC_BROWSER_TEST_P(SessionCrashedBubbleMyarcViewTest,
+                       HorizontalRestoreHintsSurviveLateVerticalPresentation) {
+  using Adapter = myarc::BrowserWorkspaceAdapter;
+  using Lifecycle = myarc::WorkspaceLifecycle;
+  auto* const profile = browser()->GetProfile();
+  profile->GetPrefs()->SetBoolean(prefs::kVerticalTabsEnabled, false);
+  auto* const main_adapter = BrowserView::GetBrowserViewForBrowser(browser())
+                                 ->GetMyarcWorkspaceAdapter();
+  ASSERT_TRUE(main_adapter);
+  ASSERT_TRUE(base::test::RunUntil([&] { return main_adapter->ready(); }));
+
+  BrowserWindowCreateParams source_params(profile, true);
+  auto* const source = CreateBrowserWindow(std::move(source_params));
+  auto* const source_adapter =
+      BrowserView::GetBrowserViewForBrowser(source)->GetMyarcWorkspaceAdapter();
+  ASSERT_TRUE(source_adapter);
+  chrome::AddTabAt(source, GURL("about:blank"), -1, true);
+  auto* const favorite = source->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(favorite));
+  ASSERT_TRUE(base::test::RunUntil([&] { return source_adapter->ready(); }));
+  const auto original_space = source_adapter->Sidebar().current_space.id;
+  ASSERT_TRUE(
+      source_adapter->Favorite(Adapter::ItemIdForContents(*favorite)).ok);
+  const auto reading = source_adapter->CreateSpace("Reading");
+  ASSERT_TRUE(reading.ok);
+  ASSERT_TRUE(source_adapter->SelectSpace(reading.id).ok);
+  ASSERT_TRUE(source_adapter->OpenInCurrentSpace(GURL("about:blank")).ok);
+  auto* const temporary = source->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_NE(favorite, temporary);
+  ASSERT_TRUE(content::WaitForLoadStop(temporary));
+  ASSERT_TRUE(source_adapter->SelectSpace(original_space).ok);
+  ASSERT_TRUE(base::test::RunUntil([&] { return source_adapter->ready(); }));
+
+  auto* const lifecycle = Lifecycle::Get(profile);
+  ASSERT_TRUE(lifecycle);
+  const auto window_data = lifecycle->WindowData(*source);
+  const auto favorite_data = lifecycle->TabData(*source, *favorite);
+  const auto temporary_data = lifecycle->TabData(*source, *temporary);
+  ASSERT_FALSE(window_data.empty());
+  ASSERT_FALSE(favorite_data.empty());
+  ASSERT_FALSE(temporary_data.empty());
+  const auto favorite_id = Adapter::ItemIdForContents(*favorite);
+  const auto temporary_id = Adapter::ItemIdForContents(*temporary);
+  const auto snapshot = source_adapter->service().ExportSnapshot();
+  ASSERT_TRUE(snapshot);
+  const auto checkpoint = myarc::internal::EncodeWorkspaceMetadata(*snapshot);
+  ASSERT_TRUE(checkpoint);
+  const std::vector<sessions::SerializedNavigationEntry> favorite_navigation = {
+      sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+          0, favorite->GetController().GetLastCommittedEntry())};
+  const std::vector<sessions::SerializedNavigationEntry> temporary_navigation =
+      {sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+          0, temporary->GetController().GetLastCommittedEntry())};
+
+  // Use captured native hints, never URL matching or reconstructed model IDs.
+  // This counted hold models insertion, not an actual disk/PID session restore.
+  Lifecycle::Notify(profile, Lifecycle::Event::kSessionRestoreStarted);
+  base::ScopedClosureRunner finish_restore(base::BindOnce(
+      &Lifecycle::Notify, profile, Lifecycle::Event::kSessionRestoreFinished));
+  CloseBrowserSynchronously(source);
+  BrowserWindowCreateParams params(profile, true);
+  params.vertical_tab_strip_collapsed = GetParam();
+  auto* const window = CreateBrowserWindow(std::move(params));
+  auto* const view = BrowserView::GetBrowserViewForBrowser(window);
+  auto* const adapter = view->GetMyarcWorkspaceAdapter();
+  ASSERT_TRUE(adapter);
+  EXPECT_FALSE(adapter->ready());
+  EXPECT_EQ(view->top_container(), view->toolbar()->parent());
+  lifecycle->RestoreWindow(*window, window_data);
+  auto* const restored_favorite = chrome::AddRestoredTab(
+      window, favorite_navigation, 0, 0, std::string(), std::nullopt,
+      /*select=*/true, /*pin=*/true, base::TimeTicks::Now(), base::Time::Now(),
+      nullptr, sessions::SerializedUserAgentOverride(), favorite_data,
+      /*from_session_restore=*/true, /*is_active_browser=*/false);
+  auto* const restored_temporary = chrome::AddRestoredTab(
+      window, temporary_navigation, 1, 0, std::string(), std::nullopt,
+      /*select=*/false, /*pin=*/false, base::TimeTicks::Now(),
+      base::Time::Now(), nullptr, sessions::SerializedUserAgentOverride(),
+      temporary_data,
+      /*from_session_restore=*/true, /*is_active_browser=*/false);
+  EXPECT_EQ(favorite_id, Adapter::ItemIdForContents(*restored_favorite));
+  EXPECT_EQ(temporary_id, Adapter::ItemIdForContents(*restored_temporary));
+  Lifecycle::Notify(profile, Lifecycle::Event::kNativeReady);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(adapter->ready());
+  EXPECT_EQ(checkpoint, myarc::internal::EncodeWorkspaceMetadata(
+                            *adapter->service().ExportSnapshot()));
+  finish_restore.RunAndReset();
+  ASSERT_TRUE(base::test::RunUntil([&] { return adapter->ready(); }));
+  ASSERT_FALSE(profile->GetPrefs()->GetBoolean(prefs::kVerticalTabsEnabled));
+
+  for (int cycle = 0; cycle < 3; ++cycle) {
+    chrome::ToggleVerticalTabs(window);
+    view->GetWidget()->LayoutRootViewIfNecessary();
+    EXPECT_EQ(adapter, view->GetMyarcWorkspaceAdapter());
+    EXPECT_EQ(restored_favorite, adapter->DisplayedContents());
+    EXPECT_EQ(2, window->GetTabStripModel()->count());
+    EXPECT_EQ(window_data, lifecycle->WindowData(*window));
+    EXPECT_EQ(favorite_data, lifecycle->TabData(*window, *restored_favorite));
+    EXPECT_EQ(temporary_data, lifecycle->TabData(*window, *restored_temporary));
+    EXPECT_EQ(checkpoint, myarc::internal::EncodeWorkspaceMetadata(
+                              *adapter->service().ExportSnapshot()));
+    EXPECT_EQ(GURL("about:blank"),
+              restored_favorite->GetController().GetVisibleEntry()->GetURL());
+    EXPECT_EQ(GURL("about:blank"),
+              restored_temporary->GetController().GetVisibleEntry()->GetURL());
+    chrome::ToggleVerticalTabs(window);
+  }
+  CloseBrowserSynchronously(window);
+}
+
 INSTANTIATE_TEST_SUITE_P(All,
                          SessionCrashedBubbleMyarcViewTest,
                          testing::Bool());
