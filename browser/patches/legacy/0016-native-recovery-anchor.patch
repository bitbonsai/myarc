+++ b/chrome/browser/ui/views/frame/BUILD.gn
@@ -591,6 +591,7 @@ source_set("app_menu_button_impl") {
   public_deps = [ ":app_menu_button" ]
   deps = [
     ":app_menu_button_observer",
+    ":browser_view",
     "//chrome/browser/ui:browser_actions",
     "//chrome/browser/ui:browser_element_identifiers",
     "//chrome/browser/ui:browser_window_header",
