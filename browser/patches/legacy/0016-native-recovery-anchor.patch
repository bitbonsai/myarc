--- a/chrome/browser/ui/views/frame/app_menu_button.cc
+++ b/chrome/browser/ui/views/frame/app_menu_button.cc
@@ -20,6 +20,7 @@
 #include "chrome/browser/ui/views/app_menu/action_app_menu.h"
 #include "chrome/browser/ui/views/chrome_typography.h"
 #include "chrome/browser/ui/views/frame/app_menu_button_observer.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
 #include "chrome/browser/ui/views/interaction/browser_elements_views.h"
 #include "chrome/browser/ui/views/toolbar/app_menu.h"
 #include "chrome/browser/ui/views/toolbar/toolbar_ink_drop_util.h"
@@ -57,6 +58,14 @@ views::BubbleAnchor AppMenuButton::GetAnchor() {
   // anchor instead.
   auto* const elements = BrowserElementsViews::From(this);
   CHECK(elements);
+  // The opt-in shell hides this button before the window is shown, when the
+  // tracked fallback is not registered yet. Its View anchor also survives a
+  // hidden sidebar.
+  auto* const browser_view =
+      elements->GetViewAs<BrowserView>(kBrowserViewElementId);
+  if (browser_view && browser_view->myarc_popup_anchor()) {
+    return views::BubbleAnchor(browser_view->myarc_popup_anchor());
+  }
   auto* const element = elements->GetElement(kFallbackPopupAnchorElementId);
   CHECK(element);
   return views::BubbleAnchor(element);
diff --git a/chrome/browser/ui/views/frame/browser_view.cc b/chrome/browser/ui/views/frame/browser_view.cc
index 1c1306e78f5aad8d377bfb8ab72c96635fd970d0..d211df41b83d58d1cb820555565bedb7f7d9b21d 100644
--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -5436,6 +5436,9 @@ void BrowserView::Layout(PassKey) {
     if (fallback_popup_anchor_) {
       fallback_popup_anchor_->MaybeUpdateAnchor(rect);
     }
+    if (myarc_popup_anchor_) {
+      myarc_popup_anchor_->SetBoundsRect(rect);
+    }
 
     if (dialog_anchor_) {
       rect.Offset(0, -kAdditionalDialogToolbarOverlap);
@@ -5682,6 +5685,11 @@ void BrowserView::AddedToWidget() {
         sidebar_header->RemoveChildViewT(sidebar_header->GetCollapseButton()));
     sidebar_header->SetMyarcSidebarToolbar(
         top_container_->RemoveChildViewT(toolbar_.get()));
+    // Keep popup anchoring independent of sidebar visibility and tracker
+    // registration during startup. Layout uses the upstream fallback position.
+    myarc_popup_anchor_ = AddChildView(std::make_unique<views::View>());
+    myarc_popup_anchor_->SetCanProcessEventsWithinSubtree(false);
+    myarc_popup_anchor_->GetViewAccessibility().SetIsIgnored(true);
   }
 
   dialog_anchor_ = std::make_unique<views::ViewSubregionAnchor>(
diff --git a/chrome/browser/ui/views/frame/browser_view.h b/chrome/browser/ui/views/frame/browser_view.h
