 class SessionCrashedBubbleViewTest : public DialogBrowserTest {
  public:
@@ -51,6 +65,85 @@ class SessionCrashedBubbleViewTest : public DialogBrowserTest {
   raw_ptr<views::BubbleDialogDelegate, DanglingUntriaged> crash_bubble_;
 };
 
+class SessionCrashedBubbleMyarcViewTest
+    : public SessionCrashedBubbleViewTest,
+      public testing::WithParamInterface<bool> {
+ public:
+  SessionCrashedBubbleMyarcViewTest() {
+    features_.InitAndDisableFeature(features::kInitialWebUI);
+  }
+
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    SessionCrashedBubbleViewTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitch("myarc-visual-parity");
+    command_line->AppendSwitch("myarc-workspace-sidebar");
+  }
+
+ private:
+  base::test::ScopedFeatureList features_;
+};
+
+IN_PROC_BROWSER_TEST_P(SessionCrashedBubbleMyarcViewTest,
+                       RecoveryBeforeWindowShownAndWithHiddenSidebar) {
+  Profile* const profile = browser()->GetProfile();
+  profile->GetPrefs()->SetBoolean(prefs::kVerticalTabsEnabled, true);
+  BrowserWindowCreateParams params(profile, /*from_user_gesture=*/true);
+  params.initial_bounds = gfx::Rect(50, 50, 1000, 800);
+  params.vertical_tab_strip_collapsed = GetParam();
+  auto* const window = CreateBrowserWindow(std::move(params));
+  auto* const view = BrowserView::GetBrowserViewForBrowser(window);
+  ASSERT_TRUE(view);
+  chrome::AddTabAt(window, GURL("about:blank"), -1, true);
+  view->GetWidget()->LayoutRootViewIfNecessary();
+
+  ASSERT_FALSE(view->GetWidget()->IsVisible());
+  auto* const elements = BrowserElementsViews::From(window);
+  ASSERT_FALSE(elements->GetElement(kFallbackPopupAnchorElementId));
+  auto* const menu = view->toolbar_button_provider()->GetAppMenuControl();
+  ASSERT_FALSE(menu->IsDrawn());
+  auto* const anchor = view->myarc_popup_anchor();
+  ASSERT_TRUE(anchor);
+  EXPECT_EQ(view, anchor->parent());
+  EXPECT_FALSE(anchor->bounds().IsEmpty());
+  EXPECT_EQ(anchor, menu->GetAnchor().GetIfView());
+
+  // Exercise the startup entry point, with a forced exit type rather than an
+  // actual browser crash. The tracked fallback does not exist yet.
+  ExitTypeService::GetInstanceForProfile(profile)
+      ->SetLastSessionExitTypeForTest(ExitType::kCrashed);
+  SessionCrashedBubble::ShowIfNotOffTheRecordProfile(window, false);
+  ASSERT_TRUE(base::test::RunUntil(
+      [] { return SessionCrashedBubbleView::GetInstanceForTest(); }));
+  auto* const bubble = SessionCrashedBubbleView::GetInstanceForTest();
+  ASSERT_TRUE(bubble);
+  EXPECT_EQ(anchor, bubble->GetAnchorView());
+  EXPECT_TRUE(bubble->ShouldShowCloseButton());
+  EXPECT_TRUE(bubble->IsDialogButtonEnabled(ui::mojom::DialogButton::kOk));
+
+  view->GetWidget()->Show();
+  EXPECT_TRUE(bubble->GetWidget()->IsVisible());
+  EXPECT_TRUE(anchor->IsDrawn());
+  // Even an entirely hidden sidebar must not hide the popup anchor.
+  view->vertical_tab_strip_region_view_for_testing()->SetVisible(false);
+  view->GetWidget()->SetBounds(gfx::Rect(50, 50, 1100, 700));
+  view->GetWidget()->LayoutRootViewIfNecessary();
+  EXPECT_TRUE(anchor->IsDrawn());
+  EXPECT_EQ(anchor, menu->GetAnchor().GetIfView());
+  ASSERT_TRUE(elements->GetElement(kFallbackPopupAnchorElementId));
+  EXPECT_EQ(
+      elements->GetElement(kFallbackPopupAnchorElementId)->GetScreenBounds(),
+      anchor->GetAnchorBoundsInScreen());
+  EXPECT_EQ(anchor->GetAnchorBoundsInScreen(), bubble->GetAnchorRect());
+  EXPECT_TRUE(bubble->GetWidget()->IsVisible());
+  bubble->GetWidget()->CloseNow();
+  EXPECT_EQ(nullptr, SessionCrashedBubbleView::GetInstanceForTest());
+  CloseBrowserSynchronously(window);
+}
+
+INSTANTIATE_TEST_SUITE_P(All,
+                         SessionCrashedBubbleMyarcViewTest,
+                         testing::Bool());
