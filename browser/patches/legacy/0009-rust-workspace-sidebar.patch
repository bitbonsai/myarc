+void BrowserView::ShowMyarcSpaceDialog(uint64_t space) {
+  if (!myarc_workspace_adapter_ || !myarc_workspace_adapter_->ready() ||
+      !GetWidget()) {
+    return;
+  }
+  CloseMyarcSpaceDialog();
+  myarc_space_dialog_delegate_ = std::make_unique<views::DialogDelegate>();
+  auto* dialog = myarc_space_dialog_delegate_.get();
+  dialog->SetOwnershipOfNewWidget(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+  dialog->SetTitle(space ? u"Rename Space" : u"Create Space");
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kOk,
+                         space ? u"Rename" : u"Create");
+  auto body = std::make_unique<views::BoxLayoutView>();
+  body->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  body->SetInsideBorderInsets(gfx::Insets(16));
+  body->SetBetweenChildSpacing(12);
+  body->SetPreferredSize(gfx::Size(360, 180));
+  myarc_space_name_ = body->AddChildView(std::make_unique<views::Textfield>());
+  myarc_space_name_->GetViewAccessibility().SetName(u"Space name");
+  if (space) {
+    auto model = myarc_workspace_adapter_->Sidebar();
+    if (!model.ok) {
+      myarc_space_name_ = nullptr;
+      myarc_space_dialog_delegate_.reset();
+      return;
+    }
+    for (const auto& record : model.spaces) {
+      if (record.id == space) {
+        myarc_space_name_->SetText(base::UTF8ToUTF16(std::string(record.name)));
+        myarc_space_name_->SelectAll(false);
+        break;
+      }
+    }
+  }
+  myarc_space_error_ = body->AddChildView(std::make_unique<views::Label>(
+      u"Space names allow up to 128 UTF-8 bytes."));
+  myarc_space_error_->SetMultiLine(true);
+  myarc_space_error_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  dialog->SetContentsView(std::move(body));
+  dialog->SetInitiallyFocusedView(myarc_space_name_);
+  dialog->SetAcceptCallbackWithClose(base::BindRepeating(
+      [](base::WeakPtr<BrowserView> view, uint64_t space) {
+        return view && view->AcceptMyarcSpaceDialog(space);
+      },
+      myarc_workspace_weak_factory_.GetWeakPtr(), space));
+  myarc_space_dialog_widget_.reset(views::DialogDelegate::CreateDialogWidget(
+      dialog, GetNativeWindow(), GetWidget()->GetNativeView()));
+  myarc_space_dialog_widget_->MakeCloseSynchronous(
+      base::IgnoreArgs<views::Widget::ClosedReason>(
+          base::BindOnce(&BrowserView::CloseMyarcSpaceDialog,
+                         myarc_workspace_weak_factory_.GetWeakPtr())));
+  myarc_space_dialog_widget_->Show();
+}
+
+bool BrowserView::AcceptMyarcSpaceDialog(uint64_t space) {
+  if (!myarc_workspace_adapter_ || !myarc_space_name_ || !myarc_space_error_) {
+    return false;
+  }
+  // Bound UTF-16 before converting. Rust owns the UTF-8 length/name rules.
+  if (myarc_space_name_->GetText().size() > 128) {
+    myarc_space_error_->SetText(u"Space name exceeds 128 UTF-8 bytes.");
+    myarc_space_name_->SetInvalid(true);
+    return false;
+  }
+  const auto name = base::UTF16ToUTF8(myarc_space_name_->GetText());
+  auto result = space ? myarc_workspace_adapter_->RenameSpace(space, name)
+                      : myarc_workspace_adapter_->CreateSpace(name);
+  const bool ok = result.ok;
+  if (!ok) {
+    myarc_space_name_->SetInvalid(true);
+    myarc_space_error_->SetText(base::UTF8ToUTF16(std::string(result.error)));
+    myarc_space_error_->GetViewAccessibility().AnnounceText(
+        myarc_space_error_->GetText());
+  }
+  MyarcWorkspaceResult(std::move(result));
+  return ok;
+}
+
+void BrowserView::CloseMyarcSpaceDialog() {
+  myarc_space_name_ = nullptr;
+  myarc_space_error_ = nullptr;
+  myarc_space_dialog_widget_.reset();
+  myarc_space_dialog_delegate_.reset();
+}
+
+void BrowserView::UpdateMyarcWorkspaceCanvas() {
+  if (!myarc_workspace_adapter_ || !multi_contents_view_) {
+    return;
+  }
+  const bool blank = IsMyarcWorkspaceBlank();
+  const bool was_blank = std::exchange(myarc_workspace_blank_, blank);
+  if (blank) {
+    if (!was_blank && GetFocusManager()) {
+      GetFocusManager()->ClearFocus();
+      GetFocusManager()->SetStoredFocusView(nullptr);
+      restore_focus_on_activation_ = false;
+      if (myarc_workspace_sidebar_ && myarc_workspace_sidebar_->IsDrawn()) {
+        myarc_workspace_sidebar_->RequestFocus();
+      }
+    }
+    // MultiContentsView is required by frame layout and stays visible. Hide its
+    // native hosts instead; keep original tabs/services alive in TabStripModel.
+    multi_contents_view_->CloseSplitView();
+    for (ContentsContainerView* container :
+         multi_contents_view_->contents_container_views()) {
+      container->contents_view()->SetWebContents(nullptr);
+      container->SetVisible(false);
+    }
+    infobar_container_->ChangeInfoBarManager(nullptr);
+    if (bookmark_bar_view_) {
+      bookmark_bar_view_->SetVisible(false);
+    }
+  } else if (was_blank) {
+    multi_contents_view_->GetActiveContentsContainerView()->SetVisible(true);
+    auto* displayed =
+        myarc_workspace_adapter_->ready()
+            ? myarc_workspace_adapter_->DisplayedContents()
+            : browser_->GetTabStripModel()->GetActiveWebContents();
+    if (displayed) {
+      OnActiveTabChanged(nullptr, displayed,
+                         browser_->GetTabStripModel()->active_index(), 0);
+    }
+  }
+  if (toolbar_) {
+    if (!blank) {
+      auto* displayed =
+          myarc_workspace_adapter_->ready()
+              ? myarc_workspace_adapter_->DisplayedContents()
+              : browser_->GetTabStripModel()->GetActiveWebContents();
+      if (displayed) {
+        toolbar_->Update(displayed);
+        UpdateReloadStopState(displayed->IsLoading(), true);
+      }
+    }
+    // Hide stale URL and security presentation together. Native navigation and
+    // security services resume unchanged when a real page is displayed.
+    if (toolbar_->location_bar_view()) {
+      toolbar_->location_bar_view()->SetVisible(!blank);
+    }
+    if (auto* back = ToolbarButtonProvider::From(browser_)->GetBackButton()) {
+      back->SetEnabled(!blank && chrome::IsCommandEnabled(browser_, IDC_BACK));
+    }
+    if (auto* forward = toolbar_->forward_button()) {
+      forward->SetEnabled(!blank &&
+                          chrome::IsCommandEnabled(browser_, IDC_FORWARD));
+    }
+    if (auto* reload = toolbar_->reload_button()) {
+      reload->SetEnabled(!blank &&
+                         chrome::IsCommandEnabled(browser_, IDC_RELOAD));
+    }
+  }
+  if (blank) {
+    UpdateReloadStopState(false, true);
+    if (auto* frame = GetFrameView()) {
+      frame->UpdateThrobber(false);
+    }
+  }
+  if (browser_widget_) {
+    UpdateTitleBar();
+  }
+  InvalidateLayout();
+}
