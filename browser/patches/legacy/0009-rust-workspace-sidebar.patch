+
+bool BrowserView::IsMyarcWorkspaceBlank() const {
+  return myarc_workspace_adapter_ && myarc_workspace_adapter_->ready() &&
+         !myarc_workspace_adapter_->DisplayedContents();
+}
+
+void BrowserView::RefreshMyarcWorkspaceSidebar() {
+  if (!myarc_workspace_adapter_ || !myarc_workspace_sidebar_ ||
+      !vertical_tab_strip_region_view_) {
+    return;
+  }
+  auto model = myarc_workspace_adapter_->Sidebar();
+  const bool ready = myarc_workspace_adapter_->ready() && model.ok;
+  // Snapshot local native bindings once per render. Metadata is Profile-wide.
+  myarc_workspace_live_items_.clear();
+  if (ready) {
+    auto* tabs = browser_->GetTabStripModel();
+    for (int i = 0; i < tabs->count(); ++i) {
+      const auto data = myarc::BrowserWorkspaceAdapter::TabExtraData(
+          *tabs->GetWebContentsAt(i));
+      auto binding = data.find(myarc::BrowserWorkspaceAdapter::kItemKey);
+      if (binding != data.end()) {
+        myarc_workspace_live_items_.insert(binding->second);
+      }
+    }
+  }
+  vertical_tab_strip_region_view_->SetMyarcWorkspaceReady(ready);
+  if (!ready) {
+    myarc_workspace_sidebar_->SetUnavailable(
+        u"Workspace unavailable. Native tabs remain available. " +
+        base::UTF8ToUTF16(myarc_workspace_adapter_->error()));
+  } else {
+    using Storage = myarc::WorkspaceService::StorageState;
+    auto& service = myarc_workspace_adapter_->service();
+    std::u16string status = myarc_workspace_action_error_;
+    const auto append = [&status](const std::u16string& message) {
+      if (!message.empty()) {
+        if (!status.empty()) {
+          status += u"\n";
+        }
+        status += message;
+      }
+    };
+    append(base::UTF8ToUTF16(myarc_workspace_adapter_->error()));
+    append(base::UTF8ToUTF16(myarc_workspace_adapter_->binding_warning()));
+    switch (service.storage_state()) {
+      case Storage::kLoading:
+        append(u"Loading workspace metadata.");
+        break;
+      case Storage::kLoadError:
+      case Storage::kWriteError:
+        append(u"Workspace storage error: " +
+               base::UTF8ToUTF16(service.storage_error()));
+        break;
+      case Storage::kWritePending:
+        append(u"Workspace changes pending storage write.");
+        break;
+      case Storage::kEphemeral:
+        append(u"Private workspace. Changes stay in memory.");
+        break;
+      case Storage::kReady:
+      case Storage::kWritten:
+        // A completed atomic write is not an OS-crash durability guarantee.
+        break;
+    }
+    myarc_workspace_sidebar_->SetModel(model, status);
+  }
+  UpdateMyarcWorkspaceCanvas();
+}
+
+myarc::SidebarView::ItemPresentation BrowserView::GetItemPresentation(
+    const myarc::foundation::ItemRecord& item) const {
+  myarc::SidebarView::ItemPresentation result;
+  if (auto metadata = myarc_workspace_adapter_->Metadata(item.id)) {
+    result.title = metadata->title;
+    result.icon = ui::ImageModel::FromImage(metadata->icon);
+    if (metadata->loading) {
+      if (result.title.empty() && item.has_url) {
+        result.title = base::UTF8ToUTF16(std::string(item.canonical_url));
+      }
+      result.title += u" (loading)";
+    }
+  }
+  // Close applies to this window, not another window's live projection.
+  result.is_live =
+      myarc_workspace_live_items_.contains(base::NumberToString(item.id));
+  return result;
+}
+
+void BrowserView::MyarcWorkspaceResult(
+    myarc::foundation::MutationResult result) {
+  myarc_workspace_action_error_ =
+      result.ok ? std::u16string()
+                : base::UTF8ToUTF16(std::string(result.error));
+  // Adapter posts native-selection refresh. Avoid rebuilding row controls or
+  // cancelling menus synchronously inside their own callbacks.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&BrowserView::RefreshMyarcWorkspaceSidebar,
+                                myarc_workspace_weak_factory_.GetWeakPtr()));
+}
