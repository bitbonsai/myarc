+IN_PROC_BROWSER_TEST_F(BrowserViewStorageRetryTest,
+                       RestoreHoldAndPrivateWorkspaceHaveNoRetry) {
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return browser_view()->GetMyarcWorkspaceAdapter()->ready(); }));
+  ExpectNoRetry();
+  myarc::BrowserWorkspaceAdapter::BeginSessionRestore(*profile());
+  ExpectNoRetry();
+  EXPECT_FALSE(Button(u"Create Space"));
+  ASSERT_TRUE(
+      myarc::BrowserWorkspaceAdapter::FinishSessionRestore(*profile()).ok);
+  auto* private_browser = CreateIncognitoBrowser(profile());
+  auto* private_view = BrowserView::GetBrowserViewForBrowser(private_browser);
+  tabs::VerticalTabStripStateController::From(private_browser)
+      ->SetVerticalTabsEnabled(true);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return private_view->GetMyarcWorkspaceAdapter()->ready(); }));
+  EXPECT_EQ(
+      Storage::kEphemeral,
+      private_view->GetMyarcWorkspaceAdapter()->service().storage_state());
+  private_view->RefreshMyarcWorkspaceSidebar();
+  EXPECT_FALSE(FindButton(private_view, u"Retry loading"));
+  EXPECT_FALSE(FindButton(private_view, u"Retry saving"));
+  CloseBrowserSynchronously(private_browser);
+}
