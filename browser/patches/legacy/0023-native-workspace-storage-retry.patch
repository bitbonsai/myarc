+IN_PROC_BROWSER_TEST_F(BrowserViewStorageRetryTest,
+                       RetrySavingRetainsMemoryAndUsesActualWriter) {
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return browser_view()->GetMyarcWorkspaceAdapter()->ready() &&
+           service().storage_state() == Storage::kWritten;
+  }));
+  ExpectNoRetry();
+  const auto backup = metadata_path().AddExtensionASCII("fixture-backup");
+  std::string original;
+  {
+    base::ScopedAllowBlockingForTesting allow_io;
+    ASSERT_TRUE(base::ReadFileToString(metadata_path(), &original));
+    ASSERT_TRUE(base::Move(metadata_path(), backup));
+    ASSERT_TRUE(base::CreateDirectory(metadata_path()));
+  }
+  ASSERT_TRUE(service().CreateSpace("Memory-only retry Space").ok);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return service().storage_state() == Storage::kWriteError; }));
+  auto snapshot = service().ExportSnapshot();
+  ASSERT_TRUE(snapshot);
+  auto expected = myarc::internal::EncodeWorkspaceMetadata(*snapshot);
+  ASSERT_TRUE(expected);
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  ASSERT_TRUE(Button(u"Retry saving"));
+  EXPECT_FALSE(Button(u"Retry loading"));
+  bool saw_pending = false;
+  auto subscription = service().Subscribe(base::BindLambdaForTesting([&] {
+    if (service().storage_state() == Storage::kWritePending) {
+      saw_pending = true;
+      ExpectNoRetry();
+    }
+  }));
+  PressRetry(u"Retry saving");
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return saw_pending && service().storage_state() == Storage::kWriteError;
+  }));
+  snapshot = service().ExportSnapshot();
+  ASSERT_TRUE(snapshot);
+  EXPECT_EQ(expected, myarc::internal::EncodeWorkspaceMetadata(*snapshot));
+  {
+    base::ScopedAllowBlockingForTesting allow_io;
+    EXPECT_TRUE(base::DirectoryExists(metadata_path()));
+    std::string bytes;
+    ASSERT_TRUE(base::ReadFileToString(backup, &bytes));
+    EXPECT_EQ(original, bytes);
+    ASSERT_TRUE(base::DeleteFile(metadata_path()));  // Empty fixture directory.
+    ASSERT_TRUE(base::Move(backup, metadata_path()));
+  }
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  saw_pending = false;
+  PressRetry(u"Retry saving");
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return saw_pending && service().storage_state() == Storage::kWritten;
+  }));
+  ExpectNoRetry();
+  EXPECT_TRUE(service().storage_error().empty());
+  {
+    base::ScopedAllowBlockingForTesting allow_io;
+    std::string bytes;
+    ASSERT_TRUE(base::ReadFileToString(metadata_path(), &bytes));
+    EXPECT_EQ(*expected, bytes);
+  }
+}
