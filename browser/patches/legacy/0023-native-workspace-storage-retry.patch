+class BrowserViewStorageRetryTest : public BrowserViewTest {
+ protected:
+  using Storage = myarc::WorkspaceService::StorageState;
+
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    BrowserViewTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitch("myarc-visual-parity");
+    command_line->AppendSwitch("myarc-workspace-sidebar");
+  }
+
+  void SetUpOnMainThread() override {
+    BrowserViewTest::SetUpOnMainThread();
+    tabs::VerticalTabStripStateController::From(browser())
+        ->SetVerticalTabsEnabled(true);
+    RunScheduledLayouts();
+  }
+
+  myarc::WorkspaceService& service() {
+    return browser_view()->GetMyarcWorkspaceAdapter()->service();
+  }
+
+  views::MdTextButton* FindButton(views::View* root,
+                                  const std::u16string& name) {
+    if (auto* button = views::AsViewClass<views::MdTextButton>(root);
+        button && button->GetViewAccessibility().GetCachedName() == name) {
+      return button;
+    }
+    for (const auto& child : root->children()) {
+      if (auto* button = FindButton(child, name)) {
+        return button;
+      }
+    }
+    return nullptr;
+  }
+
+  views::MdTextButton* Button(const std::u16string& name) {
+    return FindButton(browser_view(), name);
+  }
+
+  void ExpectNoRetry() {
+    browser_view()->RefreshMyarcWorkspaceSidebar();
+    EXPECT_FALSE(Button(u"Retry loading"));
+    EXPECT_FALSE(Button(u"Retry saving"));
+  }
+
+  void PressRetry(const std::u16string& name) {
+    auto* button = Button(name);
+    ASSERT_TRUE(button);
+    EXPECT_EQ(views::View::FocusBehavior::ALWAYS, button->GetFocusBehavior());
+    button->RequestFocus();
+    EXPECT_TRUE(button->HasFocus());
+    views::test::ButtonTestApi(button).NotifyClick(
+        ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_SPACE, ui::EF_NONE));
+  }
+
+  base::FilePath metadata_path() {
+    return profile()->GetPath().AppendASCII("myarc-workspace-v1.json");
+  }
+};
