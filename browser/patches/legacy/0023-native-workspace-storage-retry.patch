+class BrowserViewStorageLoadRetryTest : public BrowserViewStorageRetryTest {
+ protected:
+  bool SetUpUserDataDirectory() override {
+    if (!BrowserViewStorageRetryTest::SetUpUserDataDirectory()) {
+      return false;
+    }
+    base::FilePath user_data;
+    if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data)) {
+      return false;
+    }
+    const auto path = user_data.AppendASCII(chrome::kInitialProfile)
+                          .AppendASCII("myarc-workspace-v1.json");
+    return base::CreateDirectory(path.DirName()) &&
+           base::WriteFile(path, "invalid synthetic workspace input");
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(BrowserViewStorageLoadRetryTest,
+                       RetryPreservesBadInputThenLoadsRepairedFile) {
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return service().storage_state() == Storage::kLoadError; }));
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  ASSERT_TRUE(Button(u"Retry loading"));
+  EXPECT_FALSE(Button(u"Retry saving"));
+  EXPECT_FALSE(Button(u"Create Space"));
+  EXPECT_FALSE(service().CreateSpace("Blocked").ok);
+  const int native_tabs = browser()->GetTabStripModel()->count();
+  auto* page = active_web_contents();
+  const GURL url = page->GetLastCommittedURL();
+  bool saw_loading = false;
+  auto subscription = service().Subscribe(base::BindLambdaForTesting([&] {
+    if (service().storage_state() == Storage::kLoading) {
+      saw_loading = true;
+      ExpectNoRetry();
+    }
+  }));
+  PressRetry(u"Retry loading");
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return saw_loading && service().storage_state() == Storage::kLoadError;
+  }));
+  {
+    base::ScopedAllowBlockingForTesting allow_io;
+    std::string bytes;
+    ASSERT_TRUE(base::ReadFileToString(metadata_path(), &bytes));
+    EXPECT_EQ("invalid synthetic workspace input", bytes);
+    // Fixture repair uses a real core-produced snapshot; UI never edits input.
+    auto workspace = myarc::foundation::new_workspace();
+    auto repaired = myarc::internal::EncodeWorkspaceMetadata(
+        myarc::foundation::export_snapshot(*workspace));
+    ASSERT_TRUE(repaired);
+    ASSERT_TRUE(base::WriteFile(metadata_path(), *repaired));
+  }
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  saw_loading = false;
+  PressRetry(u"Retry loading");
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return saw_loading && browser_view()->GetMyarcWorkspaceAdapter()->ready();
+  }));
+  ExpectNoRetry();
+  EXPECT_TRUE(service().storage_error().empty());
+  EXPECT_EQ(native_tabs, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(page, active_web_contents());
+  EXPECT_EQ(url, page->GetLastCommittedURL());
+}
