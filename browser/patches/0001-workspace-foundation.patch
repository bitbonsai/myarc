+std::unique_ptr<views::View> Box(Orientation orientation, int spacing) {
+  auto view = std::make_unique<views::View>();
+  view->SetLayoutManager(
+      std::make_unique<views::BoxLayout>(orientation, gfx::Insets(), spacing));
+  return view;
