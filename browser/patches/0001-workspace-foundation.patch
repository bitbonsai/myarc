new file mode 100644
index 0000000..205231f0adf041583f1f951276c77df709a64326
--- /dev/null
+++ b/myarc/workspace_lifecycle.cc
@@ -0,0 +1,100 @@
+#include "myarc/workspace_lifecycle.h"
+
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/threading/thread_checker.h"
+
+namespace myarc {
+namespace {
+
+struct Registry {
+  std::map<Profile*, WorkspaceLifecycle*> registrations;
+  // Each startup launch, recovery choice and SessionRestoreImpl owns a count.
+  // Recovery transfers to a restorer before releasing its choice count.
+  std::map<Profile*, size_t> pending;
+  THREAD_CHECKER(thread_checker);
+};
+
+Registry& GetRegistry() {
+  static base::NoDestructor<Registry> registry;
+  DCHECK_CALLED_ON_VALID_THREAD(registry->thread_checker);
+  return *registry;
+}
+
+std::map<Profile*, WorkspaceLifecycle*>& Registrations() {
+  return GetRegistry().registrations;
+}
+
+std::map<Profile*, size_t>& PendingRestores() {
+  return GetRegistry().pending;
+}
+
+}  // namespace
+
+WorkspaceLifecycle::WorkspaceLifecycle(Profile* profile) {
+  const bool inserted = Registrations().emplace(profile, this).second;
+  DCHECK(inserted);
+}
+
+WorkspaceLifecycle::~WorkspaceLifecycle() {
+  std::erase_if(Registrations(),
+                [this](const auto& entry) { return entry.second == this; });
+}
+
+WorkspaceLifecycle* WorkspaceLifecycle::Get(Profile* profile) {
+  auto it = Registrations().find(profile);
+  return it == Registrations().end() ? nullptr : it->second;
+}
+
+bool WorkspaceLifecycle::HasPendingSessionRestore(Profile* profile) {
+  return PendingRestores().contains(profile);
+}
+
+void WorkspaceLifecycle::Notify(Profile* profile, Event event) {
+  if (event == Event::kStartupStarted ||
+      event == Event::kRecoveryChoiceStarted ||
+      event == Event::kSessionRestoreStarted) {
+    ++PendingRestores()[profile];
+  } else if (event == Event::kStartupFinished ||
+             event == Event::kRecoveryChoiceFinished ||
+             event == Event::kSessionRestoreFinished) {
+    auto it = PendingRestores().find(profile);
+    if (it != PendingRestores().end() && --it->second == 0) {
+      PendingRestores().erase(it);
+    }
+  }
+  if (auto* lifecycle = Get(profile)) {
+    lifecycle->OnLifecycleEvent(event);
+  }
+}
+
+void WorkspaceLifecycle::NotifyAll(Event event) {
+  // A callback may tear down another Profile in a nested UI loop.
+  const std::vector<std::pair<Profile*, WorkspaceLifecycle*>> registrations(
+      Registrations().begin(), Registrations().end());
+  for (const auto& [profile, lifecycle] : registrations) {
+    if (Get(profile) == lifecycle) {
+      lifecycle->OnLifecycleEvent(event);
+    }
+  }
+}
+
+WorkspaceLifecycle::ExtraData WorkspaceLifecycle::PreserveUnknownData(
+    const ExtraData& data) {
+  ExtraData unknown = data;
+  // shortcut: private upstream keys require auditing on each Chromium rebase.
+  // Mirrors browser_tabrestore, BrowserLiveTabContext and the adapter.
+  for (const char* key :
+       {"myarc.item.v1", "myarc.window.v1", "myarc.space.v1",
+        "glic.instance_id", "glic.conversation_id", "glic.panel_open",
+        "glic.pinned_instances", "contextual_tasks.task_id",
+        "contextual_tasks.thread_url", "send_tab_to_self.entry_guid",
+        "vertical_tab_strip_collapsed", "vertical_tab_strip_uncollapsed_width",
+        "focused_tab_group_id"}) {
+    unknown.erase(key);
+  }
+  return unknown;
+}
+
+}  // namespace myarc
diff --git a/myarc/workspace_lifecycle.h b/myarc/workspace_lifecycle.h
new file mode 100644
index 0000000..37752643778c06b4866ee5fe3e00ca344b322a36
--- /dev/null
+++ b/myarc/workspace_lifecycle.h
@@ -0,0 +1,64 @@
+#ifndef MYARC_WORKSPACE_LIFECYCLE_H_
+#define MYARC_WORKSPACE_LIFECYCLE_H_
+
+#include <map>
+#include <string>
+
+class BrowserWindowInterface;
+class Profile;
+namespace content {
+class WebContents;
+}
+
+namespace myarc {
+
+// UI-sequence, exact-Profile registration owned by that Profile's runtime.
+// Chrome sessions/lifetime call this boundary without depending on the adapter.
+// Lookup never constructs a service or opts a Profile/window into myarc.
+class WorkspaceLifecycle {
+ public:
+  using ExtraData = std::map<std::string, std::string>;
+  enum class Event {
+    kStartupStarted,
+    kStartupFinished,
+    kRecoveryChoiceStarted,
+    kRecoveryChoiceFinished,
+    kRestoreStarted,
+    kSessionRestoreStarted,
+    kSessionRestoreFinished,
+    kNativeReady,
+    kSessionReset,
+    kShutdownStarted,
+    kShutdownCancelled,
+  };
+
+  explicit WorkspaceLifecycle(Profile* profile);
+  virtual ~WorkspaceLifecycle();
+  WorkspaceLifecycle(const WorkspaceLifecycle&) = delete;
+  WorkspaceLifecycle& operator=(const WorkspaceLifecycle&) = delete;
+
+  static WorkspaceLifecycle* Get(Profile* profile);
+  static void Notify(Profile* profile, Event event);
+  static void NotifyAll(Event event);
+  // Covers startup, pending crash recovery choice and native completion
+  // observers, even after upstream removes its restorer from IsRestoring().
+  // No delegate/service is created.
+  static bool HasPendingSessionRestore(Profile* profile);
+  // Preserve opaque keys, while current native producers and bounded adapter
+  // helpers regenerate the keys they own (including deliberately absent ones).
+  static ExtraData PreserveUnknownData(const ExtraData& data);
+
+  virtual void OnLifecycleEvent(Event event) = 0;
+  virtual void RestoreTab(BrowserWindowInterface& browser,
+                          content::WebContents& contents,
+                          const ExtraData& data) = 0;
+  virtual void RestoreWindow(BrowserWindowInterface& browser,
+                             const ExtraData& data) = 0;
+  virtual ExtraData TabData(BrowserWindowInterface& browser,
+                            content::WebContents& contents) = 0;
+  virtual ExtraData WindowData(BrowserWindowInterface& browser) = 0;
+};
+
+}  // namespace myarc
+
+#endif  // MYARC_WORKSPACE_LIFECYCLE_H_
diff --git a/myarc/workspace_lifecycle_check.cc b/myarc/workspace_lifecycle_check.cc
new file mode 100644
index 0000000..63d51ccf30b48cc2bd5bcbb76a5d970de2372205
