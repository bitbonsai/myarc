diff --git a/myarc/bridge.rs b/myarc/bridge.rs
new file mode 100644
index 0000000..f648ecf9a00de36706a1898c62fe1ec5709c9910
--- /dev/null
+++ b/myarc/bridge.rs
@@ -0,0 +1,416 @@
+chromium::import! {
+    "//myarc:workspace";
+}
+
+pub struct Workspace(workspace::Workspace);
+
+// All records own their buffers. Calls are synchronous on the browser UI sequence;
+// only exported records, never Workspace or native runtime IDs, cross to storage.
+#[cxx::bridge(namespace = "myarc::foundation")]
+mod ffi {
+    struct RenameResult {
+        ok: bool,
+        name: String,
+        error: String,
+    }
+
+    struct MutationResult {
+        ok: bool,
+        id: u64,
+        error: String,
+    }
+
+    enum PlacementKind {
+        Temporary,
+        Pin,
+        Favorite,
+    }
+
+    struct SpaceRecord {
+        id: u64,
+        profile_id: u64,
+        name: String,
+    }
+
+    struct ItemRecord {
+        id: u64,
+        placement: PlacementKind,
+        owner_id: u64,
+        has_url: bool,
+        canonical_url: String,
+    }
+
+    struct WindowRecord {
+        id: u64,
+        space_id: u64,
+        // Zero means no selection; core IDs are always nonzero.
+        selected_item_id: u64,
+    }
+
+    struct StateSnapshot {
+        version: u32,
+        profile_id: u64,
+        next_space_id: u64,
+        next_item_id: u64,
+        next_window_id: u64,
+        spaces: Vec<SpaceRecord>,
+        items: Vec<ItemRecord>,
+        windows: Vec<WindowRecord>,
+    }
+
+    struct SidebarResult {
+        ok: bool,
+        error: String,
+        window_id: u64,
+        current_space: SpaceRecord,
+        selected_item_id: u64,
+        spaces: Vec<SpaceRecord>,
+        favorites: Vec<ItemRecord>,
+        pins: Vec<ItemRecord>,
+        temporary: Vec<ItemRecord>,
+    }
+
+    struct BridgeLimits {
+        version: u32,
+        spaces: usize,
+        items: usize,
+        windows: usize,
+        name_bytes: usize,
+        url_bytes: usize,
+    }
+
+    extern "Rust" {
+        type Workspace;
+        fn new_workspace() -> Box<Workspace>;
+        fn current_name(workspace: &Workspace) -> String;
+        fn rename_space(workspace: &mut Workspace, id: u64, name: &str) -> RenameResult;
+        fn bridge_limits() -> BridgeLimits;
+        fn create_space(workspace: &mut Workspace, name: &str) -> MutationResult;
+        fn create_window(workspace: &mut Workspace, space_id: u64) -> MutationResult;
+        fn close_window(workspace: &mut Workspace, window_id: u64) -> MutationResult;
+        fn select_space(workspace: &mut Workspace, window_id: u64, space_id: u64)
+        -> MutationResult;
+        fn add_temporary_item(workspace: &mut Workspace, space_id: u64) -> MutationResult;
+        fn select_item(workspace: &mut Workspace, window_id: u64, item_id: u64) -> MutationResult;
+        fn live_tab_closed(workspace: &mut Workspace, item_id: u64) -> MutationResult;
+        fn set_placement(
+            workspace: &mut Workspace,
+            item_id: u64,
+            placement: PlacementKind,
+            owner_id: u64,
+            has_url: bool,
+            canonical_url: &str,
+        ) -> MutationResult;
+        fn remove_saved_item(workspace: &mut Workspace, item_id: u64) -> MutationResult;
+        fn reveal_item(workspace: &mut Workspace, window_id: u64, item_id: u64) -> MutationResult;
+        // Zero destination means no live page; zero before means append.
+        fn unsave_item(workspace: &mut Workspace, item_id: u64, live_space: u64) -> MutationResult;
+        fn move_item_before(workspace: &mut Workspace, item_id: u64, before: u64)
+        -> MutationResult;
+        fn reconcile_live_items(workspace: &mut Workspace, live: &[u64]) -> MutationResult;
+        fn sidebar_snapshot(workspace: &Workspace, window_id: u64) -> SidebarResult;
+        fn export_snapshot(workspace: &Workspace) -> StateSnapshot;
+        fn restore_snapshot(workspace: &mut Workspace, snapshot: StateSnapshot) -> MutationResult;
+    }
+}
+
+pub fn new_workspace() -> Box<Workspace> {
+    Box::new(Workspace(workspace::Workspace::default()))
+}
+
+pub fn current_name(workspace: &Workspace) -> String {
+    workspace.0.space_name().to_owned()
+}
+
+pub fn rename_space(workspace: &mut Workspace, id: u64, name: &str) -> ffi::RenameResult {
+    let result = workspace.0.rename_space(id, name);
+    ffi::RenameResult {
+        ok: result.is_ok(),
+        name: current_name(workspace),
+        error: result
+            .err()
+            .map(|error| error.to_string())
+            .unwrap_or_default(),
+    }
+}
+
+pub fn bridge_limits() -> ffi::BridgeLimits {
+    ffi::BridgeLimits {
+        version: workspace::SNAPSHOT_VERSION,
+        spaces: workspace::MAX_SPACES,
+        items: workspace::MAX_ITEMS,
+        windows: workspace::MAX_WINDOWS,
+        name_bytes: workspace::MAX_SPACE_NAME_BYTES,
+        url_bytes: workspace::MAX_URL_BYTES,
+    }
+}
+
+fn outcome<E: std::fmt::Display>(result: Result<u64, E>) -> ffi::MutationResult {
+    match result {
+        Ok(id) => ffi::MutationResult {
+            ok: true,
+            id,
+            error: String::new(),
+        },
+        Err(error) => ffi::MutationResult {
+            ok: false,
+            id: 0,
+            error: error.to_string(),
+        },
+    }
+}
+
+fn reject(message: &str) -> ffi::MutationResult {
+    outcome(Err::<u64, _>(message))
+}
+
+pub fn create_space(workspace: &mut Workspace, name: &str) -> ffi::MutationResult {
+    outcome(
+        workspace
+            .0
+            .create_space(workspace::DEFAULT_PROFILE_ID, name),
+    )
+}
+
+pub fn create_window(workspace: &mut Workspace, space_id: u64) -> ffi::MutationResult {
+    outcome(workspace.0.create_window(space_id))
+}
+
+pub fn close_window(workspace: &mut Workspace, window_id: u64) -> ffi::MutationResult {
+    outcome(workspace.0.close_window(window_id).map(|()| 0))
+}
+
+pub fn select_space(
+    workspace: &mut Workspace,
+    window_id: u64,
+    space_id: u64,
+) -> ffi::MutationResult {
+    outcome(workspace.0.select_space(window_id, space_id).map(|()| 0))
+}
+
+pub fn add_temporary_item(workspace: &mut Workspace, space_id: u64) -> ffi::MutationResult {
+    outcome(workspace.0.add_temporary_item(space_id))
+}
+
+pub fn select_item(workspace: &mut Workspace, window_id: u64, item_id: u64) -> ffi::MutationResult {
+    outcome(workspace.0.select_item(window_id, item_id).map(|()| 0))
+}
+
+pub fn live_tab_closed(workspace: &mut Workspace, item_id: u64) -> ffi::MutationResult {
+    outcome(workspace.0.live_tab_closed(item_id).map(|()| 0))
+}
+
+fn placement(
+    kind: ffi::PlacementKind,
+    owner_id: u64,
+) -> Result<workspace::Placement, &'static str> {
+    match kind {
+        ffi::PlacementKind::Temporary => Ok(workspace::Placement::Temporary { space_id: owner_id }),
+        ffi::PlacementKind::Pin => Ok(workspace::Placement::Pin { space_id: owner_id }),
+        ffi::PlacementKind::Favorite => Ok(workspace::Placement::Favorite {
+            profile_id: owner_id,
+        }),
+        _ => Err("Unknown item placement"),
+    }
+}
+
+pub fn set_placement(
+    workspace: &mut Workspace,
+    item_id: u64,
+    kind: ffi::PlacementKind,
+    owner_id: u64,
+    has_url: bool,
+    canonical_url: &str,
+) -> ffi::MutationResult {
+    if !has_url && !canonical_url.is_empty() {
+        return reject("URL supplied without has_url");
+    }
+    let placement = match placement(kind, owner_id) {
+        Ok(value) => value,
+        Err(error) => return reject(error),
+    };
+    outcome(
+        workspace
+            .0
+            .set_placement(item_id, placement, has_url.then_some(canonical_url))
+            .map(|()| 0),
+    )
+}
+
+pub fn remove_saved_item(workspace: &mut Workspace, item_id: u64) -> ffi::MutationResult {
+    outcome(workspace.0.remove_saved_item(item_id).map(|()| 0))
+}
+
+pub fn reveal_item(workspace: &mut Workspace, window_id: u64, item_id: u64) -> ffi::MutationResult {
+    outcome(workspace.0.reveal_item(window_id, item_id).map(|()| 0))
+}
+
+pub fn unsave_item(
+    workspace: &mut Workspace,
+    item_id: u64,
+    live_space: u64,
+) -> ffi::MutationResult {
+    outcome(
+        workspace
+            .0
+            .unsave_item(item_id, (live_space != 0).then_some(live_space))
+            .map(|()| 0),
+    )
+}
+
+pub fn move_item_before(
+    workspace: &mut Workspace,
+    item_id: u64,
+    before: u64,
+) -> ffi::MutationResult {
+    outcome(
+        workspace
+            .0
+            .move_item_before(item_id, (before != 0).then_some(before))
+            .map(|()| 0),
+    )
+}
+
+pub fn reconcile_live_items(workspace: &mut Workspace, live: &[u64]) -> ffi::MutationResult {
+    outcome(workspace.0.reconcile_live_items(live).map(|()| 0))
+}
+
+fn space_record(space: workspace::Space) -> ffi::SpaceRecord {
+    ffi::SpaceRecord {
+        id: space.id,
+        profile_id: space.profile_id,
+        name: space.name,
+    }
+}
+
+fn item_record(item: workspace::Item) -> ffi::ItemRecord {
+    let (placement, owner_id) = match item.placement {
+        workspace::Placement::Temporary { space_id } => (ffi::PlacementKind::Temporary, space_id),
+        workspace::Placement::Pin { space_id } => (ffi::PlacementKind::Pin, space_id),
+        workspace::Placement::Favorite { profile_id } => (ffi::PlacementKind::Favorite, profile_id),
+    };
+    ffi::ItemRecord {
+        id: item.id,
+        placement,
+        owner_id,
+        has_url: item.canonical_url.is_some(),
+        canonical_url: item.canonical_url.unwrap_or_default(),
+    }
+}
+
+pub fn sidebar_snapshot(workspace: &Workspace, window_id: u64) -> ffi::SidebarResult {
+    match workspace.0.sidebar_snapshot(window_id) {
+        Ok(sidebar) => ffi::SidebarResult {
+            ok: true,
+            error: String::new(),
+            window_id: sidebar.window_id,
+            current_space: space_record(sidebar.current_space),
+            selected_item_id: sidebar.selected_item_id.unwrap_or(0),
+            spaces: sidebar.spaces.into_iter().map(space_record).collect(),
+            favorites: sidebar.favorites.into_iter().map(item_record).collect(),
+            pins: sidebar.pins.into_iter().map(item_record).collect(),
+            temporary: sidebar.temporary.into_iter().map(item_record).collect(),
+        },
+        Err(error) => ffi::SidebarResult {
+            ok: false,
+            error: error.to_string(),
+            window_id,
+            current_space: ffi::SpaceRecord {
+                id: 0,
+                profile_id: 0,
+                name: String::new(),
+            },
+            selected_item_id: 0,
+            spaces: Vec::new(),
+            favorites: Vec::new(),
+            pins: Vec::new(),
+            temporary: Vec::new(),
+        },
+    }
+}
+
+pub fn export_snapshot(workspace: &Workspace) -> ffi::StateSnapshot {
+    let state = workspace.0.snapshot();
+    ffi::StateSnapshot {
+        version: state.version,
+        profile_id: state.profile_id,
+        next_space_id: state.next_space_id,
+        next_item_id: state.next_item_id,
+        next_window_id: state.next_window_id,
+        spaces: state.spaces.into_iter().map(space_record).collect(),
+        items: state.items.into_iter().map(item_record).collect(),
+        windows: state
+            .windows
+            .into_iter()
+            .map(|window| ffi::WindowRecord {
+                id: window.id,
+                space_id: window.space_id,
+                selected_item_id: window.selected_item_id.unwrap_or(0),
+            })
+            .collect(),
+    }
+}
+
+pub fn restore_snapshot(
+    workspace: &mut Workspace,
+    snapshot: ffi::StateSnapshot,
+) -> ffi::MutationResult {
+    if snapshot.spaces.len() > workspace::MAX_SPACES
+        || snapshot.items.len() > workspace::MAX_ITEMS
+        || snapshot.windows.len() > workspace::MAX_WINDOWS
+        || snapshot
+            .spaces
+            .iter()
+            .any(|space| space.name.len() > workspace::MAX_SPACE_NAME_BYTES)
+        || snapshot.items.iter().any(|item| {
+            item.canonical_url.len() > workspace::MAX_URL_BYTES
+                || (!item.has_url && !item.canonical_url.is_empty())
+        })
+    {
+        return reject("Snapshot exceeds bridge bounds or has inconsistent URL presence");
+    }
+    let mut items = Vec::with_capacity(snapshot.items.len());
+    for item in snapshot.items {
+        let placement = match placement(item.placement, item.owner_id) {
+            Ok(value) => value,
+            Err(error) => return reject(error),
+        };
+        items.push(workspace::Item {
+            id: item.id,
+            placement,
+            canonical_url: item.has_url.then_some(item.canonical_url),
+        });
+    }
+    outcome(
+        workspace
+            .0
+            .restore(workspace::WorkspaceSnapshot {
+                version: snapshot.version,
+                profile_id: snapshot.profile_id,
+                next_space_id: snapshot.next_space_id,
+                next_item_id: snapshot.next_item_id,
+                next_window_id: snapshot.next_window_id,
+                spaces: snapshot
+                    .spaces
+                    .into_iter()
+                    .map(|space| workspace::Space {
+                        id: space.id,
+                        profile_id: space.profile_id,
+                        name: space.name,
+                    })
+                    .collect(),
+                items,
+                windows: snapshot
+                    .windows
+                    .into_iter()
+                    .map(|window| workspace::WindowState {
+                        id: window.id,
+                        space_id: window.space_id,
+                        selected_item_id: (window.selected_item_id != 0)
+                            .then_some(window.selected_item_id),
+                    })
+                    .collect(),
+            })
+            .map(|()| 0),
+    )
+}
diff --git a/myarc/bridge_check.cc b/myarc/bridge_check.cc
new file mode 100644
index 0000000..f560ec8bb5404348b833bcb3378e319887be716a
--- /dev/null
+++ b/myarc/bridge_check.cc
@@ -0,0 +1,358 @@
+#include <iostream>
+#include <limits>
+#include <string>
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "myarc/bridge.rs.h"
+#include "myarc/workspace_service.h"
+
+namespace {
+
+bool CheckWorkspaceRecords() {
+  using namespace myarc::foundation;
+  auto model = new_workspace();
+  auto space = create_space(*model, "Research");
+  auto window = create_window(*model, space.id);
+  auto item = add_temporary_item(*model, 1);
+  if (!space.ok || !window.ok || !item.ok ||
+      select_item(*model, window.id, item.id).ok ||
+      !select_item(*model, 1, item.id).ok) {
+    return false;
+  }
+  if (!set_placement(*model, item.id, PlacementKind::Pin, 1, true,
+                     "https://example.test/saved")
+           .ok ||
+      !live_tab_closed(*model, item.id).ok ||
+      sidebar_snapshot(*model, 1).pins.size() != 1 ||
+      set_placement(*model, item.id, PlacementKind::Pin, 1, true,
+                    "javascript:alert(1)")
+          .ok ||
+      !set_placement(*model, item.id, PlacementKind::Favorite, 1, false, "")
+           .ok ||
+      !select_item(*model, window.id, item.id).ok) {
+    return false;
+  }
+  auto sidebar = sidebar_snapshot(*model, window.id);
+  if (!sidebar.ok || sidebar.current_space.id != space.id ||
+      sidebar.favorites.size() != 1 || sidebar.selected_item_id != item.id ||
+      !sidebar.pins.empty() || !sidebar.temporary.empty() ||
+      std::string(sidebar.favorites[0].canonical_url) !=
+          "https://example.test/saved") {
+    return false;
+  }
+  auto restored = new_workspace();
+  if (!restore_snapshot(*restored, export_snapshot(*model)).ok ||
+      sidebar_snapshot(*restored, window.id).selected_item_id != item.id) {
+    return false;
+  }
+  auto invalid = export_snapshot(*model);
+  invalid.items[0].placement = static_cast<PlacementKind>(255);
+  if (restore_snapshot(*restored, std::move(invalid)).ok ||
+      sidebar_snapshot(*restored, window.id).favorites.size() != 1) {
+    return false;
+  }
+  invalid = export_snapshot(*model);
+  invalid.version++;
+  if (restore_snapshot(*restored, std::move(invalid)).ok)
+    return false;
+  invalid = export_snapshot(*model);
+  invalid.spaces[0].name = std::string(bridge_limits().name_bytes + 1, 'x');
+  if (restore_snapshot(*restored, std::move(invalid)).ok)
+    return false;
+  invalid = export_snapshot(*model);
+  for (size_t i = invalid.items.size(); i <= bridge_limits().items; ++i) {
+    invalid.items.push_back(ItemRecord{});
+  }
+  if (restore_snapshot(*restored, std::move(invalid)).ok)
+    return false;
+  if (!remove_saved_item(*model, item.id).ok ||
+      sidebar_snapshot(*model, window.id).selected_item_id != 0 ||
+      !select_space(*model, window.id, 1).ok ||
+      !close_window(*model, window.id).ok ||
+      sidebar_snapshot(*model, window.id).ok) {
+    return false;
+  }
+  auto temporary = add_temporary_item(*model, 1);
+  return temporary.ok && !remove_saved_item(*model, temporary.id).ok &&
+         live_tab_closed(*model, temporary.id).ok &&
+         sidebar_snapshot(*model, 1).temporary.empty();
+}
+
+bool CheckR2Records() {
+  using namespace myarc::foundation;
+  auto model = new_workspace();
+  auto space = create_space(*model, "Other");
+  auto first = add_temporary_item(*model, space.id);
+  auto second = add_temporary_item(*model, space.id);
+  auto orphan = add_temporary_item(*model, 1);
+  const uint64_t live[] = {first.id, second.id};
+  if (!space.ok || !first.ok || !second.ok || !orphan.ok ||
+      !reconcile_live_items(*model, rust::Slice<const uint64_t>(live, 2)).ok ||
+      !sidebar_snapshot(*model, 1).temporary.empty() ||
+      !reveal_item(*model, 1, first.id).ok ||
+      sidebar_snapshot(*model, 1).current_space.id != space.id ||
+      !move_item_before(*model, second.id, first.id).ok ||
+      sidebar_snapshot(*model, 1).temporary[0].id != second.id ||
+      !set_placement(*model, first.id, PlacementKind::Favorite, 1, true,
+                     "https://example.test/saved")
+           .ok ||
+      !unsave_item(*model, first.id, space.id).ok ||
+      sidebar_snapshot(*model, 1).temporary[1].has_url ||
+      !set_placement(*model, first.id, PlacementKind::Pin, space.id, true,
+                     "about:blank")
+           .ok ||
+      !unsave_item(*model, first.id, 0).ok) {
+    return false;
+  }
+  return !reveal_item(*model, 1, first.id).ok &&
+         sidebar_snapshot(*model, 1).temporary.size() == 1;
+}
+
+bool CheckNativeSnapshotBounds() {
+  using namespace myarc::foundation;
+  using myarc::internal::CanonicalizeUrls;
+  auto model = new_workspace();
+  auto state = export_snapshot(*model);
+  state.items.push_back(
+      {1, PlacementKind::Pin, 1, true, rust::String("HTTPS://EXAMPLE.TEST")});
+  const auto limits = bridge_limits();
+  const auto exceed = [](auto& records, size_t limit) {
+    while (records.size() <= limit)
+      records.push_back({});
+  };
+  for (int field = 0; field < 3; ++field) {
+    auto oversized = state;
+    if (field == 0)
+      exceed(oversized.spaces, limits.spaces);
+    else if (field == 1)
+      exceed(oversized.items, limits.items);
+    else
+      exceed(oversized.windows, limits.windows);
+    if (CanonicalizeUrls(oversized) ||
+        std::string(oversized.items[0].canonical_url) !=
+            "HTTPS://EXAMPLE.TEST") {
+      return false;  // Reject counts before traversing/canonicalizing items.
+    }
+  }
+  if (!CanonicalizeUrls(state) ||
+      std::string(state.items[0].canonical_url) != "https://example.test/")
+    return false;
+  state.items[0].has_url = false;
+  if (CanonicalizeUrls(state) || state.items[0].canonical_url.empty())
+    return false;
+  state.items[0].canonical_url = "";
+  return CanonicalizeUrls(state);
+}
+
+bool CheckMetadataRecords() {
+  using namespace myarc::foundation;
+  using myarc::internal::DecodeWorkspaceMetadata;
+  using myarc::internal::EncodeWorkspaceMetadata;
+  auto model = new_workspace();
+  // Exercise exact u64 counters/IDs beyond JSON's safe double range.
+  auto state = export_snapshot(*model);
+  const uint64_t item_id = (uint64_t{1} << 53) + 17;
+  state.items.push_back({item_id, PlacementKind::Favorite, 1, true,
+                         rust::String("https://example.test/\xc3\xa9")});
+  state.next_item_id = std::numeric_limits<uint64_t>::max();
+  state.windows[0].selected_item_id = item_id;
+  if (!restore_snapshot(*model, state).ok)
+    return false;
+  const auto encoded = EncodeWorkspaceMetadata(state);
+  if (!encoded)
+    return false;
+  auto decoded = DecodeWorkspaceMetadata(*encoded);
+  if (!decoded.snapshot || !decoded.error.empty() ||
+      decoded.snapshot->next_item_id != state.next_item_id ||
+      decoded.snapshot->items[0].id != item_id ||
+      !restore_snapshot(*model, std::move(*decoded.snapshot)).ok) {
+    std::cerr << "Metadata round trip failed: " << decoded.error << '\n';
+    return false;
+  }
+  auto rejects = [](const base::DictValue& root) {
+    const auto json = base::WriteJson(root);
+    if (!json)
+      return false;
+    auto result = DecodeWorkspaceMetadata(*json);
+    const bool rejected = !result.snapshot && !result.error.empty();
+    if (!rejected) {
+      std::cerr << "Invalid metadata fixture accepted: " << *json << '\n';
+      if (result.snapshot && !result.snapshot->items.empty()) {
+        std::cerr << "Decoded URL: "
+                  << std::string(result.snapshot->items[0].canonical_url)
+                  << '\n';
+      }
+    }
+    return rejected;
+  };
+  auto root = base::JSONReader::ReadDict(*encoded, base::JSON_PARSE_RFC);
+  if (!root)
+    return false;
+  for (const auto& [field, limit] :
+       {std::pair{"spaces", bridge_limits().spaces},
+        std::pair{"items", bridge_limits().items},
+        std::pair{"windows", bridge_limits().windows}}) {
+    auto oversized = root->Clone();
+    auto* records = oversized.FindList(field);
+    while (records->size() <= limit)
+      records->Append(base::DictValue());
+    if (!rejects(oversized))
+      return false;
+  }
+  // Raw invalid UTF-8 must fail before construction of any rust::String.
+  for (const auto* text : {"Everyday", "https://example.test/"}) {
+    for (const auto* invalid_utf8 : {"\xff", "\xc3\x28"}) {
+      auto invalid_json = *encoded;
+      const auto position = invalid_json.find(text);
+      if (position == std::string::npos) {
+        std::cerr << "Missing UTF-8 fixture text: " << text << '\n';
+        return false;
+      }
+      invalid_json.replace(position, std::string(text).size(), invalid_utf8);
+      const auto invalid = DecodeWorkspaceMetadata(invalid_json);
+      if (invalid.snapshot || invalid.error.empty()) {
+        std::cerr << "Invalid UTF-8 fixture accepted\n";
+        return false;
+      }
+    }
+  }
+  auto* spaces = root->FindList("spaces");
+  (*spaces)[0].GetDict().Set("name",
+                             std::string(bridge_limits().name_bytes + 1, 'x'));
+  if (!rejects(*root))
+    return false;
+  (*spaces)[0].GetDict().Set("name", "Everyday");
+  root->Set("version", 999);
+  if (!rejects(*root))
+    return false;
+  root->Set("version", static_cast<int>(bridge_limits().version));
+  root->Set("future_field", true);
+  if (!rejects(*root))
+    return false;
+  root->Remove("future_field");
+  root->Set("next_item_id", 12);  // Numeric IDs must be rejected.
+  if (!rejects(*root))
+    return false;
+  root->Set("next_item_id", "18446744073709551616");  // u64 overflow.
+  if (!rejects(*root))
+    return false;
+  root->Set("next_item_id", "01");
+  if (!rejects(*root))
+    return false;
+  root->Set("next_item_id", "18446744073709551615");
+  auto* items = root->FindList("items");
+  (*items)[0].GetDict().Set("canonical_url",
+                            std::string(bridge_limits().url_bytes + 1, 'x'));
+  if (!rejects(*root))
+    return false;
+  for (const auto* bad_url : {"https://:80/", "https://user:pass@example.test/",
+                              "javascript:alert(1)", "https://[broken/"}) {
+    (*items)[0].GetDict().Set("canonical_url", bad_url);
+    if (!rejects(*root))
+      return false;
+  }
+  // Follow Chromium canonicalization rather than inventing DNS-name policy.
+  for (const auto& [input, expected] :
+       {std::pair{"HTTPS://EXAMPLE.TEST", "https://example.test/"},
+        std::pair{"https://bad host.test/", "https://bad%20host.test/"}}) {
+    (*items)[0].GetDict().Set("canonical_url", input);
+    const auto canonical_json = base::WriteJson(*root);
+    auto canonical = canonical_json ? DecodeWorkspaceMetadata(*canonical_json)
+                                    : myarc::internal::MetadataResult{};
+    if (!canonical.snapshot ||
+        std::string(canonical.snapshot->items[0].canonical_url) != expected) {
+      return false;
+    }
+  }
+  (*items)[0].GetDict().Set("canonical_url", "https://example.test/");
+  (*items)[0].GetDict().Set("placement", 77);
+  if (!rejects(*root))
+    return false;
+  (*items)[0].GetDict().Set("placement", 2);
+  (*items)[0].GetDict().Set("has_url", false);
+  if (!rejects(*root))
+    return false;
+  (*items)[0].GetDict().Set("has_url", true);
+  for (size_t i = items->size(); i <= bridge_limits().items; ++i) {
+    items->Append(base::DictValue());
+  }
+  if (!rejects(*root))
+    return false;
+  auto malformed = DecodeWorkspaceMetadata("{broken");
+  auto oversized =
+      DecodeWorkspaceMetadata(std::string(20 * 1024 * 1024 + 1, ' '));
+  auto deep = DecodeWorkspaceMetadata("[[[[[[[[[[]]]]]]]]]]");
+  if (malformed.snapshot || malformed.error.empty() || oversized.snapshot ||
+      oversized.error.empty() || deep.snapshot || deep.error.empty()) {
+    return false;
+  }
+  // Syntactically valid records still need Rust semantic validation.
+  state.windows[0].selected_item_id = 42;
+  const auto semantically_invalid = EncodeWorkspaceMetadata(state);
+  if (!semantically_invalid)
+    return false;
+  decoded = DecodeWorkspaceMetadata(*semantically_invalid);
+  return decoded.snapshot &&
+         !restore_snapshot(*model, std::move(*decoded.snapshot)).ok &&
+         sidebar_snapshot(*model, 1).selected_item_id == item_id;
+}
+
+}  // namespace
+
+int main() {
+  auto workspace = myarc::foundation::new_workspace();
+  auto second = myarc::foundation::new_workspace();
+  if (std::string(myarc::foundation::current_name(*workspace)) != "Everyday") {
+    return 1;
+  }
+  const auto renamed =
+      myarc::foundation::rename_space(*workspace, 1, "Research");
+  if (!renamed.ok || std::string(renamed.name) != "Research") {
+    return 2;
+  }
+  const auto invalid = myarc::foundation::rename_space(*workspace, 1, "");
+  if (invalid.ok || std::string(invalid.name) != "Research" ||
+      invalid.error.empty()) {
+    return 3;
+  }
+  const auto unknown = myarc::foundation::rename_space(*workspace, 2, "Other");
+  if (unknown.ok || std::string(unknown.name) != "Research") {
+    return 4;
+  }
+  const auto oversize =
+      myarc::foundation::rename_space(*workspace, 1, std::string(129, 'x'));
+  if (oversize.ok || std::string(oversize.name) != "Research") {
+    return 5;
+  }
+  if (std::string(myarc::foundation::current_name(*second)) != "Everyday") {
+    return 6;
+  }
+  for (int i = 0; i < 1000; ++i) {
+    auto temporary = myarc::foundation::new_workspace();
+    if (!myarc::foundation::rename_space(*temporary, 1, "Owned by Rust").ok) {
+      return 7;
+    }
+  }
+  if (!CheckWorkspaceRecords()) {
+    std::cerr << "Workspace record/transition checks failed\n";
+    return 8;
+  }
+  if (!CheckR2Records()) {
+    std::cerr << "R2 transition checks failed\n";
+    return 10;
+  }
+  if (!CheckNativeSnapshotBounds()) {
+    std::cerr << "Native snapshot count/URL-presence checks failed\n";
+    return 11;
+  }
+  if (!CheckMetadataRecords()) {
+    std::cerr << "Metadata codec/bounds checks failed\n";
+    return 9;
+  }
+  std::cout << "7 legacy C++/Rust checks passed, including 1000 ownership "
+               "round trips; workspace transitions and metadata codec checks "
+               "passed\n";
+  return 0;
+}
