+IN_PROC_BROWSER_TEST_F(BrowserViewSidebarPresentationTest,
+                       CreationMenuSurvivesRowRebuildAndUsesExistingDialog) {
+  auto* view = sidebar();
+  ASSERT_TRUE(view);
+  auto* menu = myarc::SidebarViewTestApi::CreateMenu(view);
+  ASSERT_EQ(2u, menu->GetItemCount());
+  EXPECT_EQ(u"New Space", menu->GetLabelAt(0));
+  EXPECT_EQ(u"New Tab", menu->GetLabelAt(1));
+  myarc::SidebarViewTestApi::SetCreateMenuOpen(view, true);
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  auto* create = Button(u"Create Space");
+  ASSERT_TRUE(create);
+  EXPECT_EQ(u"Close creation menu", create->GetTooltipText());
+  myarc::SidebarViewTestApi::SetCreateMenuOpen(view, false);
+  EXPECT_EQ(u"Create Space", create->GetTooltipText());
+  const auto spaces_before =
+      browser_view()->GetMyarcWorkspaceAdapter()->Sidebar().spaces.size();
+  menu->ActivatedAt(0, 0);
+  views::DialogDelegate* dialog = nullptr;
+  for (const auto& widget : views::Widget::GetAllOwnedWidgets(
+           browser_view()->GetWidget()->GetNativeView())) {
+    if (widget->widget_delegate()->GetWindowTitle() == u"Create Space") {
+      dialog = widget->widget_delegate()->AsDialogDelegate();
+      break;
+    }
+  }
+  ASSERT_TRUE(dialog);
+  dialog->CancelDialog();
+  EXPECT_EQ(
+      spaces_before,
+      browser_view()->GetMyarcWorkspaceAdapter()->Sidebar().spaces.size());
+}
