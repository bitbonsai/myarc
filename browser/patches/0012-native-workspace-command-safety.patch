+IN_PROC_BROWSER_TEST_P(MyarcWorkspaceCommandSafetyTest,
+                       BulkCommandsKeepOtherSpaces) {
+  auto* tabs = workspace_browser_->GetTabStripModel();
+  ASSERT_TRUE(adapter_->OpenInCurrentSpace(GURL("about:blank")).ok);
+  ASSERT_NO_FATAL_FAILURE(EnterEmptySpace());
+  ASSERT_TRUE(adapter_->OpenInCurrentSpace(GURL("about:blank")).ok);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return adapter_->DisplayedContents() == tabs->GetActiveWebContents();
+  }));
+  view_->RefreshMyarcWorkspaceSidebar();
+  ASSERT_FALSE(view_->IsMyarcWorkspaceBlank());
+  ASSERT_TRUE(view_->IsMyarcWorkspaceActive());
+  ASSERT_EQ(1u, adapter_->Sidebar().temporary.size());
+  ASSERT_GE(tabs->count(), 3);
+  std::vector<content::WebContents*> pages;
+  for (int i = 0; i < tabs->count(); ++i) {
+    pages.push_back(tabs->GetWebContentsAt(i));
+  }
+  const int index = tabs->active_index();
+  constexpr std::pair<int, actions::ActionId> commands[] = {
+      {IDC_WINDOW_CLOSE_OTHER_TABS, kActionWindowCloseOtherTabs},
+      {IDC_WINDOW_CLOSE_TABS_TO_RIGHT, kActionWindowCloseTabsToRight},
+      {IDC_BOOKMARK_ALL_TABS, kActionBookmarkAllTabs},
+      {IDC_GROUP_UNGROUPED_TABS, kActionGroupUngroupedTabs},
+      {IDC_MOVE_TAB_NEXT, kActionMoveTabNext},
+      {IDC_MOVE_TAB_PREVIOUS, kActionMoveTabPrevious},
+      {IDC_MOVE_TAB_TO_NEW_WINDOW, kActionMoveTabToNewWindow},
+      {IDC_WINDOW_GROUP_TAB, kActionWindowGroupTab},
+      {IDC_ADD_NEW_TAB_TO_GROUP, kActionAddNewTabToGroup},
+      {IDC_CREATE_NEW_TAB_GROUP, kActionCreateNewTabGroup}};
+  auto* root = BrowserActions::From(workspace_browser_)->root_action_item();
+  for (const auto& [command, action_id] : commands) {
+    SCOPED_TRACE(command);
+    EXPECT_FALSE(IsCommandEnabled(workspace_browser_, command));
+    EXPECT_FALSE(ExecuteCommand(workspace_browser_, command));
+    auto* action = actions::ActionManager::Get().FindAction(action_id, root);
+    ASSERT_TRUE(action);
+    EXPECT_FALSE(action->GetEnabled());
+    // Even stale ActionItems must recheck execution eligibility.
+    action->SetEnabled(true);
+    action->InvokeAction();
+  }
+  EXPECT_FALSE(CanCloseOtherTabs(workspace_browser_));
+  EXPECT_FALSE(CanCloseTabsToRight(workspace_browser_));
+  EXPECT_FALSE(CanBookmarkAllTabs(workspace_browser_));
+  EXPECT_FALSE(CanGroupAllUngroupedTabs(workspace_browser_));
+  EXPECT_FALSE(CanMoveActiveTabToNewWindow(workspace_browser_));
+  EXPECT_FALSE(CanMoveTabsToNewWindow(workspace_browser_, {index}));
+  CloseOtherTabs(workspace_browser_);
+  CloseTabsToRight(workspace_browser_);
+  BookmarkAllTabs(workspace_browser_);
+  EXPECT_FALSE(GroupAllUngroupedTabs(workspace_browser_));
+  GroupTab(workspace_browser_);
+  MoveTabNext(workspace_browser_);
+  MoveTabPrevious(workspace_browser_);
+  MoveActiveTabToNewWindow(workspace_browser_);
+  MoveTabsToNewWindow(workspace_browser_, {index});
+  MoveTabsToExistingWindow(workspace_browser_, browser(), {index});
+  constexpr TabStripModel::ContextMenuCommand context_commands[] = {
+      TabStripModel::CommandCloseOtherTabs,
+      TabStripModel::CommandCloseTabsToRight,
+      TabStripModel::CommandToggleGrouped,
+      TabStripModel::CommandAddToNewGroup,
+      TabStripModel::CommandAddToExistingGroup,
+      TabStripModel::CommandMoveTabsToNewWindow,
+      TabStripModel::CommandMoveToExistingWindow};
+  for (auto command : context_commands) {
+    SCOPED_TRACE(command);
+    EXPECT_FALSE(tabs->IsContextMenuCommandEnabled(index, command));
+    tabs->ExecuteContextMenuCommand(index, command);
+  }
+  ASSERT_EQ(static_cast<int>(pages.size()), tabs->count());
+  EXPECT_EQ(index, tabs->active_index());
+  for (int i = 0; i < tabs->count(); ++i) {
+    EXPECT_EQ(pages[i], tabs->GetWebContentsAt(i));
+    EXPECT_FALSE(tabs->GetTabGroupForTab(i));
+  }
+}
