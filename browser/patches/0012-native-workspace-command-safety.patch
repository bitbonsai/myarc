+void BrowserCommandController::MyarcWorkspaceStateChanged() {
+  // Replay native eligibility for commands initialized once (e.g. Close), then
+  // refresh dynamic tab/policy state. Copy because updates write this map.
+  for (const auto& [id, action_id] : GetCommandIdToActionIdMap()) {
+    if (IsMyarcPageCommand(id) && SupportsCommand(id) &&
+        !myarc_page_command_states_.contains(id)) {
+      myarc_page_command_states_[id] = command_updater_->IsCommandEnabled(id);
+    }
+  }
+  const auto states = myarc_page_command_states_;
+  for (const auto& [id, enabled] : states) {
+    UpdateCommandEnabled(id, enabled);
+  }
+  UpdateCommandsForTabState();
+  UpdateCommandsForFullscreenMode();
+  UpdateCommandsForTabStripStateChanged();
+  if (auto* contents = browser_->GetTabStripModel()->GetActiveWebContents()) {
+    LoadingStateChanged(contents->IsLoading(), true);
+  }
+
+  const auto gate_action = [this](actions::ActionId action_id, int command) {
+    auto* action = FindAction(action_id, browser_);
+    if (!action) {
+      return;
+    }
+    if (!IsMyarcWorkspaceCommandAllowed(browser_, command)) {
+      myarc_page_action_states_.try_emplace(action_id, action->GetEnabled());
+      action->SetEnabled(false);
+    } else if (auto it = myarc_page_action_states_.find(action_id);
+               it != myarc_page_action_states_.end()) {
+      action->SetEnabled(it->second);
+      myarc_page_action_states_.erase(it);
+    }
+  };
+  for (const auto& [id, action_id] : GetCommandIdToActionIdMap()) {
+    if (IsMyarcPageCommand(id) && !SupportsCommand(id)) {
+      gate_action(action_id, id);
+    }
+  }
+  // Zoom's page-action button has no IDC mapping (unlike its menu).
+  gate_action(kActionShowZoomBubble, IDC_ZOOM_MENU);
+  // QR has action-only policy state, independent of legacy command state.
+  UpdateQRCodeGeneratorActionEnabledState();
+}
