+IN_PROC_BROWSER_TEST_P(MyarcWorkspaceCommandSafetyTest,
+                       ActionReplayPreservesSupportAndPolicy) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      workspace_browser_, embedded_test_server()->GetURL("/title1.html")));
+  auto* controller = BrowserCommandController::From(workspace_browser_);
+  auto* root = BrowserActions::From(workspace_browser_)->root_action_item();
+  auto* lens = actions::ActionManager::Get().FindAction(
+      kActionContentContextLensRegionSearch, root);
+  auto* qr =
+      actions::ActionManager::Get().FindAction(kActionQrCodeGenerator, root);
+  ASSERT_TRUE(lens);
+  ASSERT_TRUE(qr);
+  const bool supported = SupportsCommand(
+      workspace_browser_, IDC_CONTENT_CONTEXT_LENS_REGION_SEARCH);
+  EXPECT_EQ(GetParam(), supported);
+  const bool lens_enabled = lens->GetEnabled();
+  const auto old_space = adapter_->Sidebar().current_space.id;
+  const bool qr_policy = g_browser_process->local_state()->GetBoolean(
+      prefs::kQRCodeGeneratorEnabled);
+  base::ScopedClosureRunner restore_qr_policy(base::BindOnce(
+      [](bool enabled) {
+        g_browser_process->local_state()->SetBoolean(
+            prefs::kQRCodeGeneratorEnabled, enabled);
+      },
+      qr_policy));
+  for (int pass = 0; pass < 2; ++pass) {
+    g_browser_process->local_state()->SetBoolean(prefs::kQRCodeGeneratorEnabled,
+                                                 true);
+    controller->TabStateChanged();
+    ASSERT_TRUE(qr->GetEnabled());
+    ASSERT_NO_FATAL_FAILURE(EnterEmptySpace());
+    EXPECT_FALSE(lens->GetEnabled());
+    EXPECT_FALSE(qr->GetEnabled());
+    // A policy change while masked must survive native-state replay.
+    g_browser_process->local_state()->SetBoolean(prefs::kQRCodeGeneratorEnabled,
+                                                 false);
+    controller->MyarcWorkspaceStateChanged();
+    EXPECT_FALSE(lens->GetEnabled());
+    EXPECT_EQ(supported,
+              SupportsCommand(workspace_browser_,
+                              IDC_CONTENT_CONTEXT_LENS_REGION_SEARCH));
+    ASSERT_TRUE(adapter_->SelectSpace(old_space).ok);
+    view_->RefreshMyarcWorkspaceSidebar();
+    EXPECT_EQ(lens_enabled, lens->GetEnabled());
+    EXPECT_FALSE(qr->GetEnabled());
+    EXPECT_EQ(supported,
+              SupportsCommand(workspace_browser_,
+                              IDC_CONTENT_CONTEXT_LENS_REGION_SEARCH));
+  }
+  g_browser_process->local_state()->SetBoolean(prefs::kQRCodeGeneratorEnabled,
+                                               qr_policy);
+  EXPECT_FALSE(IsMyarcPageCommand(IDC_TAKE_SCREENSHOT));
+}
