+  auto invalid = indices();
+  invalid.push_back(tabs->count());
+  EXPECT_TRUE(view_->SetMyarcTabsSaved(invalid, true));
+  EXPECT_TRUE(adapter_->Sidebar().favorites.empty());
+  EXPECT_TRUE(view_->SetMyarcTabsSaved(indices(), true));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const int index = tabs->GetIndexOfWebContents(temporary_page);
+    return tabs->ContainsIndex(index) && tabs->IsTabPinned(index);
+  }));
+  auto model = adapter_->Sidebar();
+  ASSERT_EQ(1u, model.pins.size());
+  EXPECT_EQ(pin_id, model.pins[0].id);
+  ASSERT_EQ(1u, model.favorites.size());
+  EXPECT_EQ(temporary_id, model.favorites[0].id);
+  EXPECT_FALSE(tabs->IsTabPinned(tabs->GetIndexOfWebContents(pin_page)));
+  EXPECT_TRUE(tabs->IsTabPinned(tabs->GetIndexOfWebContents(temporary_page)));
+  EXPECT_TRUE(view_->SetMyarcTabsSaved(indices(), true));
+  EXPECT_EQ(1u, adapter_->Sidebar().pins.size());
+
+  // Unsave a mixed Pin + Temporary selection, without promoting/moving the
+  // already-temporary row. Duplicate indices must dispatch each stable ID once.
+  EXPECT_TRUE(view_->SetMyarcTabsSaved(
+      {tabs->GetIndexOfWebContents(temporary_page)}, false));
+  EXPECT_TRUE(view_->SetMyarcTabsSaved(indices(), false));
+  model = adapter_->Sidebar();
+  EXPECT_TRUE(model.pins.empty());
+  EXPECT_TRUE(model.favorites.empty());
+  EXPECT_EQ(temporary_id,
+            myarc::BrowserWorkspaceAdapter::ItemIdForContents(*temporary_page));
+}
