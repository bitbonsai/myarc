+// These use real Rust projection and native tabs, not a mock workspace model.
+// Runtime execution belongs to the disposable-profile native test runner.
+class MyarcWorkspaceCommandSafetyTest
+    : public InProcessBrowserTest,
+      public testing::WithParamInterface<bool> {
+ public:
+  MyarcWorkspaceCommandSafetyTest() {
+    features_.InitWithFeatureStates(
+        {{features::kUseActionsForBrowserCommands, GetParam()},
+         {features::kTabGroupsFocusing, true}});
+#if BUILDFLAG(ENABLE_EXTENSIONS) && (BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC))
+    consent_features_.InitAndEnableFeature(
+        extensions_features::kSearchEngineExplicitChoiceDialog);
+#endif
+  }
+
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    command_line->AppendSwitch("myarc-visual-parity");
+    command_line->AppendSwitch("myarc-workspace-sidebar");
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    browser()->GetProfile()->GetPrefs()->SetBoolean(prefs::kVerticalTabsEnabled,
+                                                    true);
+    workspace_browser_ = CreateBrowser(browser()->GetProfile());
+    view_ = BrowserView::GetBrowserViewForBrowser(workspace_browser_);
+    ASSERT_TRUE(view_);
+    adapter_ = view_->GetMyarcWorkspaceAdapter();
+    ASSERT_TRUE(adapter_);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return adapter_->service().ExportSnapshot().has_value(); }));
+    // This is a fresh test Profile after native window creation, with no
+    // restore in flight. Production restoration remains owned by the lifecycle
+    // hooks.
+    ASSERT_TRUE(myarc::BrowserWorkspaceAdapter::FinishSessionRestore(
+                    *workspace_browser_->GetProfile())
+                    .ok);
+    ASSERT_TRUE(base::test::RunUntil([&] { return adapter_->ready(); }));
+    ASSERT_TRUE(adapter_->DisplayedContents());
+  }
+
+  void TearDownOnMainThread() override {
+    adapter_ = nullptr;
+    view_ = nullptr;
+    workspace_browser_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+ protected:
+  void EnterEmptySpace() {
+    const auto space = adapter_->CreateSpace("Empty command test");
+    ASSERT_TRUE(space.ok);
+    ASSERT_TRUE(adapter_->SelectSpace(space.id).ok);
+    view_->RefreshMyarcWorkspaceSidebar();
+    ASSERT_TRUE(view_->IsMyarcWorkspaceBlank());
+  }
+
+  base::test::ScopedFeatureList features_;
+#if BUILDFLAG(ENABLE_EXTENSIONS) && (BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC))
+  base::test::ScopedFeatureList consent_features_;
+#endif
+  raw_ptr<BrowserWindowInterface> workspace_browser_ = nullptr;
+  raw_ptr<BrowserView> view_ = nullptr;
+  raw_ptr<myarc::BrowserWorkspaceAdapter> adapter_ = nullptr;
+};
