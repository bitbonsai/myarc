+void ContentsWebView::PrimaryPageChanged(content::Page& page) {
+  WebView::PrimaryPageChanged(page);
+  UpdateMyarcPageBackground();
+}
+
+void ContentsWebView::UpdateMyarcPageBackground() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "myarc-visual-parity")) {
+    return;
+  }
+  auto* contents = web_contents();
+  const GURL url = contents
+                       ? contents->GetPrimaryMainFrame()->GetLastCommittedURL()
+                       : GURL();
+  const bool blank =
+      url.is_empty() || url.IsAboutBlank() || search::IsNTPURL(url);
+  if (contents) {
+    // nullopt restores Blink's default canvas, including page color-scheme.
+    contents->SetPageBaseBackgroundColor(
+        blank ? std::make_optional(SK_ColorTRANSPARENT) : std::nullopt);
+  }
+  SetBackgroundVisible(!blank);
+}
