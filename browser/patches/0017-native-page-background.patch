+IN_PROC_BROWSER_TEST_F(BrowserViewPinnedFadeTest,
+                       PageBackgroundNavigationAndAttachment) {
+  embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+      [](const net::test_server::HttpRequest& request)
+          -> std::unique_ptr<net::test_server::HttpResponse> {
+        if (request.relative_url != "/myarc-background.html" &&
+            request.relative_url != "/myarc-dark-canvas.html") {
+          return nullptr;
+        }
+        auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+        response->set_content_type("text/html");
+        response->set_content(
+            request.relative_url == "/myarc-background.html"
+                ? "<style>:root { color-scheme: dark; background: rgb(23, 45, "
+                  "67); }</style><p>Authored canvas</p>"
+                : "<meta name=color-scheme content=dark><p>Dark canvas</p>");
+        return response;
+      }));
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* contents = active_web_contents();
+  auto* view = browser_view()->multi_contents_view()->GetActiveContentsView();
+  const GURL blank(url::kAboutBlankURL);
+  const GURL ordinary = embedded_test_server()->GetURL("/title1.html");
+  const GURL authored =
+      embedded_test_server()->GetURL("/myarc-background.html");
+  const GURL dark = embedded_test_server()->GetURL("/myarc-dark-canvas.html");
+  const auto opaque = [&] {
+    const auto color = contents->GetBackgroundColor();
+    return color && SkColorGetA(*color) == SK_AlphaOPAQUE;
+  };
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), blank));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return contents->GetBackgroundColor() == SK_ColorTRANSPARENT; }));
+  EXPECT_LT(view->layer()->AsSolidColor()->background_color().fA, 1.f);
+
+  // Same WebContents: clearing both overrides restores the unstyled canvas.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), ordinary));
+  EXPECT_EQ(contents, view->web_contents());
+  ASSERT_TRUE(base::test::RunUntil(opaque));
+  EXPECT_FLOAT_EQ(1.f, view->layer()->AsSolidColor()->background_color().fA);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), authored));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return contents->GetBackgroundColor() == SkColorSetRGB(23, 45, 67);
+  }));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), dark));
+  ASSERT_TRUE(base::test::RunUntil(opaque));
+  EXPECT_NE(SK_ColorWHITE, *contents->GetBackgroundColor());
+
+  // Back/forward can reactivate an existing page, not just commit a new one.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), blank));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return contents->GetBackgroundColor() == SK_ColorTRANSPARENT; }));
+  ASSERT_TRUE(content::HistoryGoBack(contents));
+  ASSERT_TRUE(base::test::RunUntil(opaque));
+  ASSERT_TRUE(content::HistoryGoForward(contents));
+
+  // Workspace-empty detaches; a hidden page can then navigate unobserved.
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return contents->GetBackgroundColor() == SK_ColorTRANSPARENT; }));
+  view->SetWebContents(nullptr);
+  EXPECT_LT(view->layer()->AsSolidColor()->background_color().fA, 1.f);
+  ASSERT_TRUE(content::NavigateToURL(contents, ordinary));
+  ASSERT_TRUE(base::test::RunUntil(opaque));
+  view->SetWebContents(contents);
+  EXPECT_FLOAT_EQ(1.f, view->layer()->AsSolidColor()->background_color().fA);
+
+  // Switching away from a blank tab must not retain its material on return.
+  AddTab(browser(), blank);
+  ASSERT_TRUE(content::WaitForLoadStop(active_web_contents()));
+  EXPECT_NE(contents, view->web_contents());
+  browser()->GetTabStripModel()->ActivateTabAt(0);
+  EXPECT_EQ(contents, view->web_contents());
+  ASSERT_TRUE(base::test::RunUntil(opaque));
+  EXPECT_FLOAT_EQ(1.f, view->layer()->AsSolidColor()->background_color().fA);
+
+  // NTP's virtual chrome://newtab URL can differ from its committed origin.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           chrome::ChromeUINewTabURLAsGURL()));
+  EXPECT_LT(view->layer()->AsSolidColor()->background_color().fA, 1.f);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), ordinary));
+  ASSERT_TRUE(base::test::RunUntil(opaque));
+  EXPECT_FLOAT_EQ(1.f, view->layer()->AsSolidColor()->background_color().fA);
+}
