+IN_PROC_BROWSER_TEST_F(BrowserViewPaletteIntentTest,
+                       LateHistoryDoesNotSelectCurrentButDefaultsNew) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  auto* contents = active_web_contents();
+  const GURL literal = embedded_test_server()->GetURL("/title2.html");
+  const GURL history_match =
+      embedded_test_server()->GetURL("/title2.html?history-only");
+  const GURL new_literal = embedded_test_server()->GetURL("/title3.html");
+  const GURL new_history_match =
+      embedded_test_server()->GetURL("/title3.html?history-default");
+  auto* history_service = HistoryServiceFactory::GetForProfile(
+      profile(), ServiceAccessType::EXPLICIT_ACCESS);
+  ASSERT_TRUE(history_service);
+  history_service->AddPage(history_match, base::Time::Now(),
+                           history::SOURCE_BROWSED);
+  history_service->AddPage(new_history_match, base::Time::Now(),
+                           history::SOURCE_BROWSED);
+  const int count = browser()->GetTabStripModel()->count();
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(false));
+  Type(base::UTF8ToUTF16(literal.spec()));
+  EXPECT_FALSE(Result(history_match));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Result(history_match); }));
+  content::TestNavigationObserver navigation(contents);
+  Press(ui::VKEY_RETURN);
+  navigation.Wait();
+  EXPECT_EQ(contents, active_web_contents());
+  EXPECT_EQ(literal, contents->GetLastCommittedURL());
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(true));
+  Type(base::UTF8ToUTF16(new_literal.spec()));
+  EXPECT_FALSE(Result(new_history_match));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Result(new_history_match); }));
+  Press(ui::VKEY_RETURN);
+  ASSERT_NE(contents, active_web_contents());
+  ASSERT_TRUE(content::WaitForLoadStop(active_web_contents()));
+  EXPECT_EQ(new_history_match, active_web_contents()->GetLastCommittedURL());
+  EXPECT_EQ(literal, contents->GetLastCommittedURL());
+  EXPECT_EQ(count + 1, browser()->GetTabStripModel()->count());
+}
