+IN_PROC_BROWSER_TEST_F(BrowserViewPaletteIntentTest,
+                       ExplicitCurrentResultsRevealOtherSpace) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL original = embedded_test_server()->GetURL("/title1.html");
+  const GURL matched = embedded_test_server()->GetURL("/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), original));
+  auto* contents = active_web_contents();
+  auto* adapter = browser_view()->GetMyarcWorkspaceAdapter();
+  ASSERT_TRUE(adapter);
+  ASSERT_TRUE(base::test::RunUntil([&] { return adapter->ready(); }));
+  const uint64_t original_space = adapter->Sidebar().current_space.id;
+  const auto other_space =
+      adapter->CreateSpace("Palette global result fixture");
+  ASSERT_TRUE(other_space.ok);
+  ASSERT_TRUE(adapter->SelectSpace(other_space.id).ok);
+  ASSERT_TRUE(adapter->OpenInCurrentSpace(matched).ok);
+  auto* other = active_web_contents();
+  ASSERT_NE(contents, other);
+  ASSERT_TRUE(content::WaitForLoadStop(other));
+  const int count = browser()->GetTabStripModel()->count();
+  ASSERT_TRUE(adapter->SelectSpace(original_space).ok);
+  ASSERT_EQ(contents, adapter->DisplayedContents());
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(false));
+  Type(base::UTF8ToUTF16(matched.spec()));
+  ASSERT_TRUE(Result(matched));
+  Press(ui::VKEY_DOWN);
+  Press(ui::VKEY_RETURN);
+  EXPECT_EQ(other, active_web_contents());
+  EXPECT_EQ(other, adapter->DisplayedContents());
+  EXPECT_EQ(other_space.id, adapter->Sidebar().current_space.id);
+
+  ASSERT_TRUE(adapter->SelectSpace(original_space).ok);
+  ASSERT_TRUE(browser_view()->ShowMyarcCommandPalette(false));
+  Type(base::UTF8ToUTF16(matched.spec()));
+  auto* row = Result(matched);
+  ASSERT_TRUE(row);
+  views::test::ButtonTestApi(row).NotifyClick(
+      ui::MouseEvent(ui::EventType::kMouseReleased, gfx::Point(), gfx::Point(),
+                     ui::EventTimeForNow(), ui::EF_LEFT_MOUSE_BUTTON,
+                     ui::EF_LEFT_MOUSE_BUTTON));
+  EXPECT_EQ(other, active_web_contents());
+  EXPECT_EQ(other, adapter->DisplayedContents());
+  EXPECT_EQ(other_space.id, adapter->Sidebar().current_space.id);
+  EXPECT_EQ(original, contents->GetLastCommittedURL());
+  EXPECT_EQ(matched, other->GetLastCommittedURL());
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+}
