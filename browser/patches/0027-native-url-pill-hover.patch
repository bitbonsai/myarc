+void LocationBarView::CopyMyarcCurrentUrl() {
+  WebContents* const page = GetWebContents();
+  if (IsMyarcUrlPill() && page && !page->GetVisibleURL().is_empty() &&
+      !page->GetController().GetVisibleEntry()->IsInitialEntry() &&
+      chrome::CanCopyUrl(browser_)) {
+    chrome::CopyURL(browser_, page);
+  }
