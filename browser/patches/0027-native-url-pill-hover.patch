+  EXPECT_TRUE(bar()->location_icon_view()->GetVisible());
+  EXPECT_TRUE(bar()->location_icon_view()->GetShowText());
+  EXPECT_FALSE(CopyButton()->GetVisible());
+}
+
+IN_PROC_BROWSER_TEST_F(BrowserViewUrlPillTest, EmptyNeverCopiesHiddenPage) {
+  const GURL url = https_server_.GetURL("/title1.html?hidden=old#private");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  auto* adapter = browser_view()->GetMyarcWorkspaceAdapter();
+  const auto original = adapter->Sidebar().current_space.id;
+  const auto empty = adapter->CreateSpace("URL pill empty fixture");
+  ASSERT_TRUE(empty.ok);
+  ASSERT_TRUE(adapter->SelectSpace(empty.id).ok);
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  Idle();
+  Hover(true);
+  ASSERT_TRUE(browser_view()->IsMyarcWorkspaceBlank());
+  EXPECT_EQ(url, active_web_contents()->GetVisibleURL());
+  EXPECT_FALSE(bar()->GetWebContents());
+  EXPECT_FALSE(CopyButton()->GetVisible());
+  EXPECT_FALSE(CopyButton()->GetEnabled());
+  EXPECT_FALSE(bar()->location_icon_view()->GetVisible());
+  EXPECT_FALSE(bar()->ShowPageInfoDialog());
+  {
+    ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+    writer.WriteText(u"unchanged clipboard");
+  }
+  // Exercise a stale queued callback as well as the hidden/disabled control.
+  PressCopy();
+  EXPECT_EQ(u"unchanged clipboard", ClipboardText());
+  ASSERT_TRUE(adapter->SelectSpace(original).ok);
+  browser_view()->RefreshMyarcWorkspaceSidebar();
+  Idle();
+  Hover(true);
+  EXPECT_TRUE(CopyButton()->GetVisible());
+  EXPECT_TRUE(bar()->location_icon_view()->GetVisible());
+  PressCopy();
+  EXPECT_EQ(base::UTF8ToUTF16(url.spec()), ClipboardText());
+}
+
+IN_PROC_BROWSER_TEST_F(BrowserViewUrlPillTest,
+                       HorizontalKeepsUpstreamLocationIcon) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), https_server_.GetURL("/title1.html")));
+  tabs::VerticalTabStripStateController::From(browser())
+      ->SetVerticalTabsEnabled(false);
+  Idle();
+  Hover(true);
+  EXPECT_FALSE(CopyButton()->GetVisible());
+  EXPECT_TRUE(bar()->location_icon_view()->GetVisible());
+  EXPECT_FALSE(bar()->GetNotifyEnterExitOnChild());
+  EXPECT_LT(bar()->location_icon_view()->x(), bar()->omnibox_view()->x());
+  tabs::VerticalTabStripStateController::From(browser())
+      ->SetVerticalTabsEnabled(true);
+  Idle();
+  EXPECT_FALSE(bar()->location_icon_view()->GetVisible());
+  Hover(true);
+  EXPECT_TRUE(CopyButton()->GetVisible());
+}
