+}
+
+IN_PROC_BROWSER_TEST_F(BrowserViewUrlPillTest,
+                       DangerousStatusStaysVisibleAtIdle) {
+  net::EmbeddedTestServer expired(net::EmbeddedTestServer::TYPE_HTTPS);
+  expired.SetSSLConfig(net::EmbeddedTestServer::CERT_EXPIRED);
+  expired.ServeFilesFromSourceDirectory("chrome/test/data");
