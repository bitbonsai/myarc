+  EXPECT_TRUE(bar->location_icon_view()->GetVisible());
+  EXPECT_LT(bar->location_icon_view()->x(), bar->omnibox_view()->x());
+  EXPECT_FALSE(bar->GetNotifyEnterExitOnChild());
+  for (views::View* child : bar->children()) {
+    EXPECT_NE(l10n_util::GetStringUTF16(IDS_APP_MENU_COPY_LINK),
+              child->GetTooltipText());
+  }
+}
