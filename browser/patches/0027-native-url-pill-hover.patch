+class BrowserViewUrlPillTest : public BrowserViewStorageRetryTest {
+ protected:
+  void SetUpOnMainThread() override {
+    BrowserViewStorageRetryTest::SetUpOnMainThread();
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return browser_view()->GetMyarcWorkspaceAdapter()->ready(); }));
+    https_server_.ServeFilesFromSourceDirectory("chrome/test/data");
+    ASSERT_TRUE(https_server_.Start());
+  }
+
+  LocationBarView* bar() { return browser_view()->GetLocationBarView(); }
+
+  views::Button* CopyButton() {
+    for (views::View* child : bar()->children()) {
+      if (auto* button = views::AsViewClass<views::Button>(child);
+          button && button->GetTooltipText() ==
+                        l10n_util::GetStringUTF16(IDS_APP_MENU_COPY_LINK)) {
+        return button;
+      }
+    }
+    return nullptr;
+  }
+
+  void Hover(bool hovered) {
+    ui::MouseEvent event(
+        hovered ? ui::EventType::kMouseEntered : ui::EventType::kMouseExited,
+        gfx::PointF(), gfx::PointF(), ui::EventTimeForNow(), 0, 0);
+    auto* view = static_cast<views::View*>(bar());
+    if (hovered) {
+      view->OnMouseEntered(event);
+    } else {
+      view->OnMouseExited(event);
+    }
+    RunScheduledLayouts();
+  }
+
+  void Idle() {
+    bar()->GetFocusManager()->ClearFocus();
+    bar()->Revert();
+    Hover(false);
+  }
+
+  void PressCopy() {
+    views::test::ButtonTestApi(CopyButton())
+        .NotifyClick(ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_SPACE,
+                                  ui::EF_NONE));
+  }
+
+  std::u16string ClipboardText() {
+    base::test::TestFuture<std::u16string> text;
+    ui::Clipboard::GetForCurrentThread()->ReadText(
+        ui::ClipboardBuffer::kCopyPaste, std::nullopt, text.GetCallback());
+    return text.Get();
+  }
+
+  net::EmbeddedTestServer https_server_{net::EmbeddedTestServer::TYPE_HTTPS};
+};
+
+IN_PROC_BROWSER_TEST_F(BrowserViewUrlPillTest,
+                       HttpsIdleHoverFocusAndRealSiteInfo) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), https_server_.GetURL("/title1.html")));
+  Idle();
+  ASSERT_EQ(security_state::SECURE,
+            bar()->GetLocationBarModel()->GetSecurityLevel());
+  auto* copy = CopyButton();
+  auto* site = bar()->location_icon_view();
+  ASSERT_TRUE(copy);
+  EXPECT_FALSE(copy->GetVisible());
+  EXPECT_FALSE(site->GetVisible());
+  EXPECT_TRUE(bar()->GetNotifyEnterExitOnChild());
+  Hover(true);
+  EXPECT_TRUE(copy->GetVisible());
+  EXPECT_TRUE(site->GetVisible());
+  EXPECT_LE(bar()->omnibox_view()->bounds().right(), copy->x());
+  EXPECT_LE(copy->bounds().right(), site->x());
+  EXPECT_EQ(views::View::FocusBehavior::ALWAYS, copy->GetFocusBehavior());
+  Idle();
+  auto* focus = bar()->GetFocusManager();
+  focus->SetKeyboardAccessible(true);
+  bar()->omnibox_view()->RequestFocus();
+  RunScheduledLayouts();
+  ASSERT_TRUE(copy->GetVisible());
+  focus->AdvanceFocus(false);
+  RunScheduledLayouts();
+  EXPECT_TRUE(copy->HasFocus());
+  EXPECT_TRUE(site->GetVisible());
+  focus->AdvanceFocus(false);
+  EXPECT_TRUE(site->HasFocus());
+  views::test::ButtonTestApi(site).NotifyClick(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_SPACE, ui::EF_NONE));
+  ASSERT_TRUE(PageInfoBubbleViewBase::IsShowing(active_web_contents()));
+  PageInfoBubbleViewBase::GetPageInfoBubbleForTesting(active_web_contents())
+      ->GetWidget()
+      ->CloseNow();
+  Idle();
+  EXPECT_FALSE(copy->GetVisible());
+  EXPECT_FALSE(site->GetVisible());
+}
+
+IN_PROC_BROWSER_TEST_F(BrowserViewUrlPillTest,
+                       CopyUsesFullCurrentPageAtInvocation) {
+  const GURL first =
+      https_server_.GetURL("/title1.html?full=one%20two#fragment");
+  const GURL second =
+      https_server_.GetURL("/title2.html?actual=second#current");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), first));
+  Idle();
+  Hover(true);
+  ASSERT_TRUE(CopyButton()->GetVisible());
+  PressCopy();
+  EXPECT_EQ(base::UTF8ToUTF16(first.spec()), ClipboardText());
+  chrome::AddTabAt(browser(), second, -1, true);
+  ASSERT_TRUE(content::WaitForLoadStop(active_web_contents()));
+  Idle();
+  Hover(true);
+  PressCopy();
+  EXPECT_EQ(base::UTF8ToUTF16(second.spec()), ClipboardText());
+  browser()->GetTabStripModel()->ActivateTabAt(0);
+  Idle();
+  Hover(true);
+  PressCopy();
+  EXPECT_EQ(base::UTF8ToUTF16(first.spec()), ClipboardText());
+}
+
+IN_PROC_BROWSER_TEST_F(BrowserViewUrlPillTest,
