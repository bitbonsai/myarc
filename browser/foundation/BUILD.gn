executable("bridge_check") {
  testonly = true
  sources = [ "bridge_check.cc" ]
  deps = [
    ":boosts_service",
    ":library_logic",
    ":media_library",
    ":spaces_index",
    ":workspace_service",
  ]
}

assert(!myarc_release || !myarc_test_hooks,
       "Release builds ship without test hooks; drop myarc_test_hooks")

buildflag_header("test_buildflags") {
  header = "test_buildflags.h"
  flags = [ "MYARC_TEST_HOOKS=$myarc_test_hooks" ]
}

buildflag_header("release_buildflags") {
  header = "release_buildflags.h"
  flags = [ "MYARC_RELEASE=$myarc_release" ]
}

# Sparkle 2 in-app updates for release builds. tools/package_release.sh embeds
# Sparkle.framework, which this loads at runtime.
source_set("updater") {
  sources = [
    "updater_mac.h",
    "updater_mac.mm",
  ]
  deps = [
    ":glass",
    ":release_buildflags",
    ":test_buildflags",
    ":welcome_mark",
    "//base",
  ]
  frameworks = [
    "Cocoa.framework",
    "QuartzCore.framework",
  ]
}

source_set("release_switches") {
  sources = [
    "release_switches.cc",
    "release_switches.h",
  ]
  deps = [
    ":release_buildflags",
    "//base",
  ]
}

# --myarc-startup-timing: logs time to the first window and first paint.
source_set("startup_timing") {
  sources = [
    "startup_timing.cc",
    "startup_timing.h",
  ]
  deps = [
    "//base",
    "//content/public/browser",
  ]
}

# uBlock Origin Lite, myArc's default ad and tracker blocker. See
# blocker/README.md.
source_set("blocker") {
  sources = [
    "blocker.cc",
    "blocker.h",
  ]
  deps = [
    ":startup_timing",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/common:constants",
    "//components/prefs",
    "//content/public/browser",
    "//extensions/browser",
    "//extensions/browser:crx_installer",
    "//extensions/browser/install",
    "//extensions/common",
    "//extensions/common:mojom",
    "//third_party/zlib/google:zip",
  ]
}

# Window > Ad Blocking for This Site…, the site info popover's "Block ads on
# this site" row and the blocker's own popup.
source_set("blocker_popup") {
  sources = [
    "blocker_popup.cc",
    "blocker_popup.h",
    "blocker_switch.cc",
    "blocker_switch.h",
  ]
  deps = [
    ":blocker",
    ":bridge",
    ":settings_window",
    ":test_buildflags",
    "//base",
    "//chrome/browser/extensions",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:chrome_pages",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/views/controls",
    "//chrome/browser/ui/views/extensions:extension_popup",
    "//chrome/browser/ui/views/interaction",
    "//chrome/browser/ui/views/location_bar",
    "//chrome/browser/ui/views/page_info",
    "//components/sessions",
    "//components/tabs:public",
    "//components/vector_icons",
    "//content/public/browser",
    "//extensions/browser",
    "//extensions/common",
    "//ui/views",
    "//url",
  ]
}

bundle_data("blocker_bundle_data") {
  sources = [ "blocker/uBOLite_2026.1116.1650.chromium.zip" ]
  outputs = [ "{{bundle_resources_dir}}/ublock_origin_lite.zip" ]
}

if (is_mac) {
  source_set("main_menu") {
    sources = [
      "main_menu_mac.h",
      "main_menu_mac.mm",
    ]
    deps = [
      ":browser_workspace_adapter",
      ":command_ids",
      "//base",
      "//chrome/app:command_ids",
      "//chrome/browser/ui/browser_window",
    ]
    frameworks = [ "Cocoa.framework" ]
  }
}
