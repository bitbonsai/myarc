import("//build/buildflag_header.gni")
import("//build/config/chrome_build.gni")
import("//build/rust/rust_static_library.gni")
import("//myarc/nightly.gni")

assert(!myarc_nightly || branding_file_path == "//myarc/nightly/BRANDING",
       "myarc_nightly needs branding_file_path = \"//myarc/nightly/BRANDING\"")

rust_static_library("workspace") {
  crate_root = "workspace/src/lib.rs"
  sources = [
    "workspace/src/archive.rs",
    "workspace/src/lib.rs",
    "workspace/src/peek.rs",
    "workspace/src/tab_ops.rs",
  ]
  build_native_rust_unit_tests = true
}

rust_static_library("control") {
  crate_root = "control/src/lib.rs"
  sources = [
    "control/src/ipc.rs",
    "control/src/lib.rs",
  ]
  aliased_deps = {
    myarc_workspace = ":workspace"
  }

  # Cargo sets this; the client names its version in the hello.
  rustenv = [ "CARGO_PKG_VERSION=0.1.0" ]
  deps = [
    ":workspace",
    "//third_party/rust/serde/v1:lib",
    "//third_party/rust/serde_json/v1:lib",
  ]
}

rust_static_library("bridge") {
  crate_root = "bridge.rs"
  sources = [ crate_root ]
  cxx_bindings = [ crate_root ]
  allow_unsafe = true  # Cxx-generated interoperation only; core forbids unsafe.
  deps = [
    ":control",
    ":workspace",
  ]
}

source_set("native_button") {
  sources = [
    "native_button.cc",
    "native_button.h",
  ]
  deps = [
    ":bridge",
    "//base",
    "//ui/base",
    "//ui/views",
  ]
}

source_set("workspace_service") {
  sources = [
    "workspace_service.cc",
    "workspace_service.h",
