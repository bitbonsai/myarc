import("//build/buildflag_header.gni")
import("//build/config/chrome_build.gni")
import("//build/rust/rust_static_library.gni")
import("//myarc/nightly.gni")

assert(!myarc_nightly || branding_file_path == "//myarc/nightly/BRANDING",
       "myarc_nightly needs branding_file_path = \"//myarc/nightly/BRANDING\"")

rust_static_library("workspace") {
  crate_root = "workspace/src/lib.rs"
  sources = [
    "workspace/src/archive.rs",
    "workspace/src/lib.rs",
    "workspace/src/peek.rs",
    "workspace/src/tab_ops.rs",
  ]
  build_native_rust_unit_tests = true
}

rust_static_library("bridge") {
  crate_root = "bridge.rs"
  sources = [ crate_root ]
  cxx_bindings = [ crate_root ]
  allow_unsafe = true  # Cxx-generated interoperation only; core forbids unsafe.
  deps = [ ":workspace" ]
}

source_set("native_button") {
  sources = [
    "native_button.cc",
    "native_button.h",
  ]
  deps = [
    ":bridge",
    "//base",
    "//ui/base",
    "//ui/views",
  ]
}

source_set("workspace_service") {
  sources = [
    "workspace_service.cc",
    "workspace_service.h",
  ]
  public_deps = [
    ":bridge",
    "//base",
  ]
  deps = [
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
    "//url",
  ]
}

source_set("command_ids") {
  sources = [ "command_ids.h" ]
}

source_set("workspace_lifecycle") {
  sources = [
    "workspace_lifecycle.cc",
    "workspace_lifecycle.h",
  ]
  deps = [ "//base" ]
}

executable("workspace_lifecycle_check") {
  testonly = true
  sources = [ "workspace_lifecycle_check.cc" ]
  deps = [ ":workspace_lifecycle" ]
}

source_set("browser_workspace_adapter") {
  sources = [
    "browser_workspace_adapter.cc",
    "browser_workspace_adapter.h",
  ]
  public_deps = [
    ":workspace_service",
    "//chrome/browser/ui/tabs:tab_strip_model_observer",
    "//ui/gfx",
    "//url",
  ]
  deps = [
    ":workspace_lifecycle",
    "//chrome/browser/favicon",
    "//chrome/browser/lifetime",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/sessions",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/keyed_service/core",
    "//components/sessions",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base",
  ]
}

source_set("sidebar_view") {
  sources = [
    "sidebar_view.cc",
    "sidebar_view.h",
  ]
  public_deps = [
    "//base",
    "//ui/base",
    "//ui/menus",
    "//ui/views",
  ]
  deps = [
    ":bridge",
    "//components/vector_icons",
    "//ui/color",
    "//ui/gfx",
    "//ui/gfx/geometry",
  ]
}

source_set("copied_url_toast") {
  sources = [
    "copied_url_toast.cc",
    "copied_url_toast.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    "//cc/paint",
    "//skia",
    "//ui/accessibility",
    "//ui/base",
    "//ui/compositor",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/views",
  ]
}

source_set("settings_window") {
  sources = [
    "settings_window.cc",
    "settings_window.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    "//cc/paint",
    "//chrome/browser:shell_integration",
    "//skia",
    "//ui/accessibility",
    "//ui/base",
    "//ui/events",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/views",
  ]
  if (is_mac) {
    sources += [ "settings_window_mac.mm" ]
    deps += [ "//components/remote_cocoa/common:mojo" ]
    frameworks = [ "Cocoa.framework" ]
  }
}

executable("bridge_check") {
  testonly = true
  sources = [ "bridge_check.cc" ]
  deps = [ ":workspace_service" ]
}

buildflag_header("nightly_buildflags") {
  header = "nightly_buildflags.h"
  flags = [ "MYARC_NIGHTLY=$myarc_nightly" ]
}

source_set("nightly_switches") {
  sources = [
    "nightly_switches.cc",
    "nightly_switches.h",
  ]
  deps = [
    ":nightly_buildflags",
    "//base",
  ]
}
