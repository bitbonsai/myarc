executable("bridge_check") {
  testonly = true
  sources = [ "bridge_check.cc" ]
  deps = [
    ":library_logic",
    ":spaces_index",
    ":workspace_service",
  ]
}

assert(!myarc_nightly || !myarc_test_hooks,
       "The nightly ships without test hooks; drop myarc_test_hooks")

buildflag_header("test_buildflags") {
  header = "test_buildflags.h"
  flags = [ "MYARC_TEST_HOOKS=$myarc_test_hooks" ]
}

buildflag_header("nightly_buildflags") {
  header = "nightly_buildflags.h"
  flags = [ "MYARC_NIGHTLY=$myarc_nightly" ]
}

source_set("nightly_switches") {
  sources = [
    "nightly_switches.cc",
    "nightly_switches.h",
  ]
  deps = [
    ":nightly_buildflags",
    "//base",
  ]
}
