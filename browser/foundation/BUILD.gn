# The ribbon logo the welcome window animates, a 512 px copy of
# design/brand/assets/myarc-matte.png, as bytes in a generated header.
action("welcome_mark") {
  script = "embed_bytes.py"
  inputs = [ "resources/welcome_mark.png" ]
  outputs = [ "$target_gen_dir/welcome_mark.h" ]
  args = [
    rebase_path(inputs[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
    "WelcomeMarkPng",
  ]
}

# The welcome's sound, a copy of design/brand/sounds/welcome.m4a, and its 3D
# ribbon video, from tools/render_welcome_ribbon.mjs, in the framework's
# resources. The bundle copy keeps symlinks, so the sound is a real copy.
bundle_data("welcome_sound") {
  sources = [
    "resources/myarc_welcome.m4a",
    "resources/myarc_welcome_ribbon.mov",
  ]
  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
}

